<Window x:Class="Nudge.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Nudge.App.Views"
        xmlns:vm="clr-namespace:Nudge.App.ViewModels"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="Nudge"
        Icon="pack://application:,,,/Assets/nudge.ico"
        Width="{DynamicResource Size.Window.Width}"
        Height="{DynamicResource Size.Window.Height}"
        MinWidth="{DynamicResource Size.Window.MinWidth}"
        MinHeight="{DynamicResource Size.Window.MinHeight}"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        ResizeMode="CanResize"
        Background="{DynamicResource Brush.Window.Background}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

  <!--
    Custom window chrome, themed to match the rest of the app instead of the plain system title
    bar. Built on WindowChrome (not raw WndProc hit-testing) so resizing, dragging, and Aero snap
    keep working "for free" - only the caption area's own content (icon/title/min/max/close) is
    hand-drawn; everything else about being a window is still the OS's job.

    Known limitation: Windows 11's snap-layout flyout (hovering the maximize button) needs the
    system-drawn caption buttons (UseAeroCaptionButtons="True") to appear - it does not fire for a
    hand-drawn button. Traded away here for a themed button; drag-to-edge snapping itself still
    works, since that comes from WindowChrome's own hit-testing, not the flyout.
  -->
  <WindowChrome.WindowChrome>
    <WindowChrome CaptionHeight="{DynamicResource Size.TitleBar.Height}"
                  ResizeBorderThickness="6"
                  GlassFrameThickness="0"
                  CornerRadius="0"
                  UseAeroCaptionButtons="False" />
  </WindowChrome.WindowChrome>

  <Window.Resources>
    <DataTemplate DataType="{x:Type vm:SetupViewModel}">
      <views:SetupView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:LibraryViewModel}">
      <views:LibraryView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
      <views:SettingsView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:TableCustomizationViewModel}">
      <views:TableCustomizationView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:TableDetailsViewModel}">
      <views:TableDetailsView />
    </DataTemplate>

    <!-- Begun from code (MainWindow.DismissSplash) once startup work actually completes, rather than
         from a fixed BeginTime in the splash's own entry storyboard - see the note on SplashOverlay.
         Collapsed only after the fade finishes: Visibility flips instantly, so doing it any earlier
         would cut the fade short. That Visibility keyframe is also what drops the overlay out of
         hit-testing (a Collapsed element never participates) - an earlier version tried animating
         IsHitTestVisible for that instead, which WPF does not support at all and which threw on the
         render thread, leaving the splash stuck on screen forever with no visible error. -->
    <Storyboard x:Key="SplashFadeOut">
      <DoubleAnimation Storyboard.TargetName="SplashOverlay" Storyboard.TargetProperty="Opacity"
                        To="0" Duration="0:0:0.4">
        <DoubleAnimation.EasingFunction>
          <QuadraticEase EasingMode="EaseInOut" />
        </DoubleAnimation.EasingFunction>
      </DoubleAnimation>
      <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SplashOverlay" Storyboard.TargetProperty="Visibility" BeginTime="0:0:0.4">
        <DiscreteObjectKeyFrame KeyTime="0:0:0" Value="{x:Static Visibility.Collapsed}" />
      </ObjectAnimationUsingKeyFrames>
    </Storyboard>
  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition x:Name="TitleBarRow" Height="{DynamicResource RowHeight.TitleBar}" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Caption: everything here except the buttons column is drag-to-move / double-click-to-maximize,
         by virtue of sitting within WindowChrome's CaptionHeight. -->
    <Grid Grid.Row="0" Background="{DynamicResource Brush.TitleBar.Background}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
        <Image Source="pack://application:,,,/Assets/nudge.ico" Width="16" Height="16" />
        <TextBlock Text="Nudge"
                   Margin="8,0,0,0"
                   VerticalAlignment="Center"
                   FontFamily="{DynamicResource Font.Family.Primary}"
                   FontSize="{DynamicResource Font.Size.Caption}"
                   Foreground="{DynamicResource Brush.Text.Secondary}" />
      </StackPanel>

      <!-- Marked hit-test-visible so clicks land on the buttons instead of being treated as a
           caption drag - WindowChrome otherwise reports the whole CaptionHeight strip as HTCAPTION. -->
      <StackPanel Grid.Column="1" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
        <Button x:Name="FullscreenButton"
                Style="{StaticResource TitleBarButton}"
                Content="&#xE740;"
                ToolTip="Full screen (F11)"
                Click="OnFullscreenClick" />
        <!-- No maximize/restore button: Nudge has one "make it big" concept, and it is fullscreen.
             Offering maximize alongside it meant two nearly identical states with different window
             chrome, and no way to tell from the buttons which one you were in. -->
        <Button x:Name="MinimizeButton"
                Style="{StaticResource TitleBarButton}"
                Content="&#xE921;"
                ToolTip="Minimize"
                Click="OnMinimizeClick" />
        <Button x:Name="CloseButton"
                Style="{StaticResource TitleBarButton.Close}"
                Content="&#xE8BB;"
                ToolTip="Close"
                Click="OnCloseClick" />
      </StackPanel>
    </Grid>

    <!-- ShellViewModel.CurrentViewModel decides which screen shows; the DataTemplates above map
         each view model to its view. -->
    <ContentControl Grid.Row="1" Content="{Binding CurrentViewModel}" Focusable="False" />

    <!-- Fullscreen-only corner controls: the real title bar row above is hidden entirely while
         fullscreen (Height 0), so this is the only way to minimize, exit fullscreen, or close the
         app without reaching for F11/Alt+F4 - always on top of whichever screen is showing, via
         Grid.RowSpan. Sized well down from the normal title bar buttons (46x38): those sit in their
         own reserved row when the real title bar is showing, but these float directly over whatever
         page is underneath, and at anything close to full size they reached far enough down to
         overlap the library header's own right-aligned controls (Rescan, the settings cog). This
         corner now ends by y=24 (2px margin + 22px buttons); Padding.Header (Layout.xaml) starts
         header content no earlier than y=26 specifically so the two can never touch - if either
         number changes, keep that 2px+ gap between them. -->
    <StackPanel x:Name="FullscreenCornerControls"
                Grid.Row="0" Grid.RowSpan="2"
                Orientation="Horizontal"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                Margin="0,2,4,0"
                Visibility="Collapsed"
                Panel.ZIndex="1000">
      <Button x:Name="MinimizeCornerButton"
              Style="{StaticResource TitleBarButton}"
              Width="30" Height="22"
              FontSize="8"
              Content="&#xE921;"
              ToolTip="Minimize"
              Click="OnMinimizeClick" />
      <Button x:Name="ExitFullscreenCornerButton"
              Style="{StaticResource TitleBarButton}"
              Width="30" Height="22"
              FontSize="8"
              Content="&#xE73F;"
              ToolTip="Exit full screen (F11)"
              Click="OnFullscreenClick" />
      <Button x:Name="CloseCornerButton"
              Style="{StaticResource TitleBarButton.Close}"
              Width="30" Height="22"
              FontSize="8"
              Content="&#xE8BB;"
              ToolTip="Close"
              Click="OnCloseClick" />
    </StackPanel>

    <!-- Startup splash: the first thing on screen, up before any of the real startup work runs (see
         App.xaml.cs - the window is deliberately shown before database migration and installation
         discovery, with the slow parts pushed off the UI thread, so this is genuinely visible and
         animating from the moment the app opens rather than appearing after a frozen pause).

         The entry animation runs on Loaded, but the exit does NOT - dismissal is driven from code
         (DismissSplash) once startup has actually finished, so the bar keeps sweeping for exactly as
         long as there's real work left instead of running a fixed timeline that either cuts off
         early or lingers after everything is ready. -->
    <Border x:Name="SplashOverlay"
            Grid.Row="0" Grid.RowSpan="2"
            Background="{DynamicResource Brush.Window.Background}"
            Panel.ZIndex="1500">
      <Border.Triggers>
        <EventTrigger RoutedEvent="Border.Loaded">
          <BeginStoryboard>
            <Storyboard>
              <!-- Pop in: a slight overshoot reads as "arriving", not just fading up. -->
              <DoubleAnimation Storyboard.TargetName="SplashLogoScale" Storyboard.TargetProperty="ScaleX"
                                From="0.86" To="1" Duration="0:0:0.5">
                <DoubleAnimation.EasingFunction>
                  <BackEase EasingMode="EaseOut" Amplitude="0.3" />
                </DoubleAnimation.EasingFunction>
              </DoubleAnimation>
              <DoubleAnimation Storyboard.TargetName="SplashLogoScale" Storyboard.TargetProperty="ScaleY"
                                From="0.86" To="1" Duration="0:0:0.5">
                <DoubleAnimation.EasingFunction>
                  <BackEase EasingMode="EaseOut" Amplitude="0.3" />
                </DoubleAnimation.EasingFunction>
              </DoubleAnimation>
              <DoubleAnimation Storyboard.TargetName="SplashContent" Storyboard.TargetProperty="Opacity"
                                From="0" To="1" Duration="0:0:0.35" />

              <!-- Sweeps continuously for as long as the splash is up - Forever, not a fixed repeat
                   count, since how long startup actually takes isn't known in advance. -->
              <DoubleAnimation Storyboard.TargetName="LoadingBarFillTransform" Storyboard.TargetProperty="X"
                                From="-70" To="220" BeginTime="0:0:0.25" Duration="0:0:0.9"
                                RepeatBehavior="Forever">
                <DoubleAnimation.EasingFunction>
                  <SineEase EasingMode="EaseInOut" />
                </DoubleAnimation.EasingFunction>
              </DoubleAnimation>
            </Storyboard>
          </BeginStoryboard>
        </EventTrigger>
      </Border.Triggers>

      <StackPanel x:Name="SplashContent" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0">
        <!-- Same recolour-by-mask trick as the library wordmark: the artwork's alpha channel becomes
             a silhouette, filled with the active theme's accent instead of its own baked-in white
             gloss, so the splash always matches whatever theme is saved - including on the next
             launch, since the theme is applied (App.xaml.cs) before this window is even constructed.
             Reverted to this - the supplied "Nudge Logo Words.png" wordmark - after briefly trying a
             plain icon+text pairing instead; the wordmark was the preferred look. -->
        <Rectangle Width="330" Height="110"
                   HorizontalAlignment="Center"
                   Fill="{DynamicResource Brush.Accent}"
                   RenderTransformOrigin="0.5,0.5">
          <Rectangle.RenderTransform>
            <ScaleTransform x:Name="SplashLogoScale" ScaleX="0.8" ScaleY="0.8" />
          </Rectangle.RenderTransform>
          <Rectangle.OpacityMask>
            <ImageBrush ImageSource="pack://application:,,,/Assets/Nudge Logo Words.png"
                        Stretch="Uniform"
                        RenderOptions.BitmapScalingMode="HighQuality" />
          </Rectangle.OpacityMask>
          <Rectangle.Effect>
            <DropShadowEffect Color="{DynamicResource Color.Shadow}"
                               Direction="270"
                               ShadowDepth="6"
                               BlurRadius="20"
                               Opacity="0.35"
                               RenderingBias="Performance" />
          </Rectangle.Effect>
        </Rectangle>

        <!-- Loading bar: a recessed track (the same material every recessed slot in the app uses)
             with a short accent-coloured fill that sweeps back and forth - indeterminate rather than
             a real percentage, since there's nothing measurable to report yet at this point in
             startup (AGENTS.md's scan progress only exists once the library screen is already up). -->
        <Border Width="220" Height="4"
                Margin="0,24,0,0"
                HorizontalAlignment="Center"
                Background="{DynamicResource Brush.Surface.Recessed}"
                CornerRadius="2">
          <Border HorizontalAlignment="Left"
                  Width="70" Height="4"
                  Background="{DynamicResource Brush.Accent}"
                  CornerRadius="2"
                  RenderTransformOrigin="0,0.5">
            <Border.RenderTransform>
              <TranslateTransform x:Name="LoadingBarFillTransform" X="-70" />
            </Border.RenderTransform>
          </Border>
        </Border>
      </StackPanel>
    </Border>
  </Grid>

</Window>
