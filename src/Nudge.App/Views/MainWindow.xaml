<Window x:Class="Nudge.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Nudge.App.Views"
        xmlns:vm="clr-namespace:Nudge.App.ViewModels"
        Title="Nudge"
        Icon="pack://application:,,,/Assets/nudge.ico"
        Width="{DynamicResource Size.Window.Width}"
        Height="{DynamicResource Size.Window.Height}"
        MinWidth="{DynamicResource Size.Window.MinWidth}"
        MinHeight="{DynamicResource Size.Window.MinHeight}"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource Brush.Window.Background}"
        TextOptions.TextFormattingMode="Display"
        UseLayoutRounding="True">

  <!--
    Standard Windows title bar, by decision - custom chrome is a separate, larger piece of work
    (hit-testing, snap layouts, DPI) not part of this pass. ShellViewModel.CurrentViewModel decides
    which screen shows; the DataTemplates below map each view model to its view.
  -->

  <Window.Resources>
    <DataTemplate DataType="{x:Type vm:SetupViewModel}">
      <views:SetupView />
    </DataTemplate>
    <DataTemplate DataType="{x:Type vm:LibraryViewModel}">
      <views:LibraryView />
    </DataTemplate>
  </Window.Resources>

  <ContentControl Content="{Binding CurrentViewModel}" Focusable="False" />

</Window>
