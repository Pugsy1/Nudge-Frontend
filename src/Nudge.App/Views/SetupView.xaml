<UserControl x:Class="Nudge.App.Views.SetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:models="clr-namespace:Nudge.Core.Models;assembly=Nudge.Core"
             xmlns:vm="clr-namespace:Nudge.App.ViewModels"
             xmlns:converters="clr-namespace:Nudge.App.Converters"
             d:DataContext="{d:DesignInstance Type=vm:SetupViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

  <UserControl.Resources>

    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />
    <converters:EnumEqualsConverter x:Key="EnumEquals" />

    <!--
      Confidence badges: not currently used anywhere in this view. Detection confidence is shown to
      the user later, behind a settings toggle, rather than always-on. Kept defined here rather than
      deleted since that toggle is near-term, planned work, not a hypothetical.
    -->
    <Style x:Key="ConfidenceBadge" TargetType="Border" BasedOn="{StaticResource Badge}">
      <Setter Property="Background" Value="{DynamicResource Brush.Confidence.Unknown.Background}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding Confidence}" Value="{x:Static models:Confidence.High}">
          <Setter Property="Background" Value="{DynamicResource Brush.Confidence.High.Background}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Confidence}" Value="{x:Static models:Confidence.Medium}">
          <Setter Property="Background" Value="{DynamicResource Brush.Confidence.Medium.Background}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Confidence}" Value="{x:Static models:Confidence.Low}">
          <Setter Property="Background" Value="{DynamicResource Brush.Confidence.Low.Background}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="ConfidenceText" TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
      <Setter Property="FontWeight" Value="{DynamicResource Font.Weight.SemiBold}" />
      <Setter Property="Foreground" Value="{DynamicResource Brush.Confidence.Unknown}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding Confidence}" Value="{x:Static models:Confidence.High}">
          <Setter Property="Foreground" Value="{DynamicResource Brush.Confidence.High}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Confidence}" Value="{x:Static models:Confidence.Medium}">
          <Setter Property="Foreground" Value="{DynamicResource Brush.Confidence.Medium}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Confidence}" Value="{x:Static models:Confidence.Low}">
          <Setter Property="Foreground" Value="{DynamicResource Brush.Confidence.Low}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <Style x:Key="TableCell" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
      <Setter Property="Padding" Value="{DynamicResource Padding.TableCell}" />
      <Setter Property="VerticalAlignment" Value="Center" />
      <Setter Property="TextWrapping" Value="NoWrap" />
      <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>

    <Style x:Key="TableHeaderCell" TargetType="TextBlock" BasedOn="{StaticResource Text.SectionHeading}">
      <Setter Property="Padding" Value="{DynamicResource Padding.TableCell}" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- One row in the "Show details" executables table. -->
    <DataTemplate x:Key="ExecutableRowTemplate" DataType="{x:Type vm:ExecutableViewModel}">
      <Border Background="{DynamicResource Brush.Surface.Background}"
              BorderBrush="{DynamicResource Brush.Surface.Border}"
              BorderThickness="{DynamicResource BorderThickness.Bottom}">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="2*" SharedSizeGroup="ColFile" />
            <ColumnDefinition Width="1.4*" SharedSizeGroup="ColFlavor" />
            <ColumnDefinition Width="0.8*" SharedSizeGroup="ColArch" />
            <ColumnDefinition Width="1.2*" SharedSizeGroup="ColVersion" />
          </Grid.ColumnDefinitions>

          <TextBlock Grid.Column="0"
                     Style="{StaticResource TableCell}"
                     Text="{Binding FileName}"
                     ToolTip="{Binding FullPath}" />
          <TextBlock Grid.Column="1" Style="{StaticResource TableCell}" Text="{Binding Flavor}" />
          <TextBlock Grid.Column="2" Style="{StaticResource TableCell}" Text="{Binding Architecture}" />
          <TextBlock Grid.Column="3"
                     Style="{StaticResource TableCell}"
                     FontFamily="{DynamicResource Font.Family.Mono}"
                     Text="{Binding Version}" />
        </Grid>
      </Border>
    </DataTemplate>

    <!-- The collapsible "Show details" panel: confidence, VR, tables folder, executables, evidence. -->
    <DataTemplate x:Key="DetailsTemplate" DataType="{x:Type vm:InstallationViewModel}">
      <StackPanel Grid.IsSharedSizeScope="True">

        <StackPanel Margin="{DynamicResource Gap.Below.M}">
          <TextBlock Style="{StaticResource Text.BodySecondary}" Text="{Binding DiscoverySourceLabel}" />
          <TextBlock Style="{StaticResource Text.BodySecondary}" Text="{Binding ExecutableSummary}" />
          <TextBlock Style="{StaticResource Text.BodySecondary}" Text="{Binding TablesPathDisplay}" />
        </StackPanel>

        <TextBlock Style="{StaticResource Text.SectionHeading}"
                   Margin="{DynamicResource Gap.Below.S}"
                   Text="PROGRAMS IN THIS FOLDER" />

        <Border Background="{DynamicResource Brush.Surface.BackgroundAlt}"
                CornerRadius="{DynamicResource CornerRadius.M}"
                Margin="{DynamicResource Gap.Below.M}">
          <StackPanel>
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2*" SharedSizeGroup="ColFile" />
                <ColumnDefinition Width="1.4*" SharedSizeGroup="ColFlavor" />
                <ColumnDefinition Width="0.8*" SharedSizeGroup="ColArch" />
                <ColumnDefinition Width="1.2*" SharedSizeGroup="ColVersion" />
              </Grid.ColumnDefinitions>

              <TextBlock Grid.Column="0" Style="{StaticResource TableHeaderCell}" Text="FILE" />
              <TextBlock Grid.Column="1" Style="{StaticResource TableHeaderCell}" Text="BUILD" />
              <TextBlock Grid.Column="2" Style="{StaticResource TableHeaderCell}" Text="ARCH" />
              <TextBlock Grid.Column="3" Style="{StaticResource TableHeaderCell}" Text="VERSION" />
            </Grid>

            <ItemsControl ItemsSource="{Binding Executables}" ItemTemplate="{StaticResource ExecutableRowTemplate}" />
          </StackPanel>
        </Border>

        <TextBlock Style="{StaticResource Text.SectionHeading}"
                   Margin="{DynamicResource Gap.Below.XS}"
                   Text="HOW NUDGE WORKED THIS OUT" />
        <TextBlock Style="{StaticResource Text.MonoCaption}" Text="{Binding EvidenceText}" />
      </StackPanel>
    </DataTemplate>

  </UserControl.Resources>

  <Grid Background="{DynamicResource Brush.Window.Background}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Header: always visible, whichever stage is showing. -->
    <Grid Grid.Row="0" Margin="{DynamicResource Padding.Page}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <!--
        The logo is recoloured with the theme's own primary text colour via an OpacityMask, rather
        than shown as its original white/chrome artwork. The source art is white-on-transparent,
        which reads fine on the dark palette but is nearly invisible against the light one; masking
        it against Brush.Text.Primary guarantees contrast in both themes from a single asset,
        instead of needing a second logo file supplied for light mode.
      -->
      <Rectangle Grid.Column="0"
                 Width="90" Height="30"
                 HorizontalAlignment="Left"
                 VerticalAlignment="Center"
                 Fill="{DynamicResource Brush.Text.Primary}"
                 UseLayoutRounding="True"
                 SnapsToDevicePixels="True"
                 RenderOptions.BitmapScalingMode="HighQuality"
                 RenderOptions.EdgeMode="Unspecified">
        <Rectangle.OpacityMask>
          <ImageBrush ImageSource="pack://application:,,,/Assets/nudge-logo.png" Stretch="Uniform" />
        </Rectangle.OpacityMask>
      </Rectangle>

      <Button Grid.Column="1"
              Style="{StaticResource Button.Secondary}"
              Content="{Binding ThemeToggleLabel}"
              Command="{Binding ToggleThemeCommand}" />
    </Grid>

    <!-- ======================= Loading ======================= -->
    <StackPanel Grid.Row="1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Visibility="{Binding Stage, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static vm:SetupStage.Loading}}">
      <ProgressBar Style="{StaticResource Progress.Indeterminate}" Width="220" />
      <TextBlock Style="{StaticResource Text.BodySecondary}"
                 Margin="{DynamicResource Gap.Above.M}"
                 HorizontalAlignment="Center"
                 Text="Checking your setup..." />
    </StackPanel>

    <!-- ======================= Prompt: "Where is Visual Pinball?" ======================= -->
    <Grid Grid.Row="1"
          Visibility="{Binding Stage, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static vm:SetupStage.Prompt}}">
      <StackPanel MaxWidth="560" HorizontalAlignment="Center" VerticalAlignment="Center">

        <TextBlock Style="{StaticResource Text.Display}" HorizontalAlignment="Center"
                   Text="Where is Visual Pinball installed?" TextAlignment="Center" />

        <TextBlock Style="{StaticResource Text.BodySecondary}"
                   HorizontalAlignment="Center"
                   TextAlignment="Center"
                   Margin="{DynamicResource Gap.Above.M}"
                   Text="{Binding StatusMessage}" />

        <ProgressBar Style="{StaticResource Progress.Indeterminate}"
                     Margin="{DynamicResource Gap.Above.M}"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

        <!-- Error from the last folder the user tried. -->
        <Border Style="{StaticResource Surface.Error}"
                Margin="{DynamicResource Gap.Above.L}"
                Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
          <TextBlock Style="{StaticResource Text.Body}"
                     Foreground="{DynamicResource Brush.Status.Error}"
                     TextWrapping="Wrap"
                     Text="{Binding ErrorMessage}" />
        </Border>

        <Button Style="{StaticResource Button.Primary}"
                HorizontalAlignment="Stretch"
                Margin="{DynamicResource Gap.Above.XL}"
                Padding="{DynamicResource Padding.Button}"
                Content="Browse..."
                Command="{Binding BrowseCommand}" />

        <TextBlock Style="{StaticResource Text.Caption}"
                   Margin="{DynamicResource Gap.Above.M}"
                   HorizontalAlignment="Center"
                   TextAlignment="Center"
                   TextWrapping="Wrap"
                   Text="Choose your Visual Pinball folder, or the folder Baller Installer put it in. Nudge only reads what's there - it never changes, moves, or deletes anything inside it." />
      </StackPanel>
    </Grid>

    <!-- ======================= Ready: set up and done ======================= -->
    <ScrollViewer Grid.Row="1"
                  Padding="{DynamicResource Padding.Page}"
                  Visibility="{Binding Stage, Converter={StaticResource EnumEquals}, ConverterParameter={x:Static vm:SetupStage.Ready}}">
      <StackPanel MaxWidth="720" HorizontalAlignment="Center">

        <TextBlock Style="{StaticResource Text.Display}" Text="You're all set" />
        <TextBlock Style="{StaticResource Text.BodySecondary}"
                   Margin="{DynamicResource Gap.Above.S}"
                   Text="{Binding Active.DisplayName}" />
        <TextBlock Style="{StaticResource Text.Mono}"
                   Margin="{DynamicResource Gap.Above.XS}"
                   Text="{Binding Active.RootPath}" />

        <!-- Confidence indicators are hidden for now, pending a settings toggle to turn them back on. -->
        <StackPanel Orientation="Horizontal" Margin="{DynamicResource Gap.Above.L}">
          <Button Style="{StaticResource Button.Secondary}"
                  Margin="{DynamicResource Gap.Right.S}"
                  Content="Change folder"
                  Command="{Binding ChangeFolderCommand}" />
          <Button Style="{StaticResource Button.Subtle}"
                  Content="{Binding Active.EvidenceToggleLabel}"
                  Click="OnToggleActiveDetails" />
        </StackPanel>

        <Border Style="{StaticResource Surface.Inset}"
                Margin="{DynamicResource Gap.Above.L}"
                DataContext="{Binding Active}"
                Visibility="{Binding IsEvidenceVisible, Converter={StaticResource BoolToVisibility}}">
          <ContentControl Content="{Binding}" ContentTemplate="{StaticResource DetailsTemplate}" Focusable="False" />
        </Border>

        <Border Style="{StaticResource Surface.Inset}"
                Margin="{DynamicResource Gap.Above.XL}">
          <TextBlock Style="{StaticResource Text.Caption}"
                     TextWrapping="Wrap"
                     Text="This is as far as Phase 1 goes. Nudge now knows where Visual Pinball is, but does not yet browse your tables or launch anything - that comes in a later update." />
        </Border>

      </StackPanel>
    </ScrollViewer>

  </Grid>
</UserControl>
