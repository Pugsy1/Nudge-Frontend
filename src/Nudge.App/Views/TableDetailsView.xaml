<UserControl x:Class="Nudge.App.Views.TableDetailsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Nudge.App.ViewModels"
             xmlns:converters="clr-namespace:Nudge.App.Converters"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DataContext="{d:DesignInstance Type=vm:TableDetailsViewModel}"
             mc:Ignorable="d">

  <Grid Background="{DynamicResource Brush.Window.Background}">
    <Grid.Resources>
      <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Grid.Resources>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Header: back, title, and the two actions worth having at the top rather than buried. -->
    <Grid Grid.Row="0" Margin="{DynamicResource Padding.Header}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <Button Grid.Column="0"
              Style="{StaticResource Button.Icon}"
              Content="&#xE72B;"
              Margin="{DynamicResource Gap.Right.L}"
              ToolTip="Back to your library"
              Command="{Binding BackCommand}"
              Focusable="False" />

      <StackPanel Grid.Column="1" VerticalAlignment="Center">
        <TextBlock Style="{StaticResource Text.Title}" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
        <TextBlock Style="{StaticResource Text.BodySecondary}" Text="{Binding Subtitle}" />
      </StackPanel>

      <!-- Play and Customize live under the cover rather than up here: they act on the table, so
           they belong beside the thing they act on, not in the window chrome. That leaves this
           column free for the controller legend, which is where it sits on every other screen. -->
      <ItemsControl Grid.Column="2"
                    Style="{StaticResource ControllerHintBar}"
                    Margin="16,0,0,0"
                    VerticalAlignment="Center"
                    ItemsSource="{Binding ControllerHints}"
                    Visibility="{Binding Library.IsControllerMode, Converter={StaticResource BoolToVisibility}}" />
    </Grid>

    <ScrollViewer Grid.Row="1">
      <Grid Margin="40,0,40,40">
        <Grid.ColumnDefinitions>
          <!-- Artwork column sized to the tile proportions the rest of the app uses, so the cover
               reads as the same object it was on the grid rather than a differently-shaped copy. -->
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Width="260" Margin="0,0,32,0">
          <!-- An invisible heading, styled and spaced exactly like the real ones in the right-hand
               column. Without it the cover starts at the top of the content area while the VIDEO
               panel beside it starts one heading lower, so the two columns visibly disagree about
               where the page begins. Matching the heading rather than hard-coding a margin keeps
               them aligned across themes and both UI styles, which change type size and spacing. -->
          <TextBlock Style="{StaticResource Text.SectionHeading}"
                     Margin="{DynamicResource Gap.Below.M}"
                     Text="TABLE"
                     Opacity="0" />

          <Border CornerRadius="{DynamicResource CornerRadius.M}"
                  Background="{DynamicResource Brush.Surface.Recessed}"
                  Effect="{DynamicResource Effect.Card.Shadow}"
                  ClipToBounds="True"
                  Height="470">
            <Grid>
              <TextBlock Text="{Binding Tile.Initial}"
                         HorizontalAlignment="Center"
                         VerticalAlignment="Center"
                         FontSize="{DynamicResource Font.Size.Display}"
                         Foreground="{DynamicResource Brush.Text.Muted}"
                         Opacity="0.5" />
              <Image Source="{Binding Tile.Artwork}" Stretch="UniformToFill" />
            </Grid>
          </Border>

          <Button Style="{StaticResource Button.Primary}"
                  Content="Play"
                  HorizontalAlignment="Stretch"
                  Margin="{DynamicResource Gap.Above.M}"
                  Command="{Binding PlayCommand}" />
          <Button Style="{StaticResource Button.Secondary}"
                  Content="Customize"
                  HorizontalAlignment="Stretch"
                  Margin="{DynamicResource Gap.Above.S}"
                  Command="{Binding CustomizeCommand}" />
        </StackPanel>

        <StackPanel Grid.Column="1">

          <!-- ======================= Video ======================= -->
          <TextBlock Style="{StaticResource Text.SectionHeading}" Margin="{DynamicResource Gap.Below.M}" Text="VIDEO" />

          <!-- Left-aligned so the card shrinks to fit the player instead of stretching across the
               whole column - stretched, the 16:9 video sat in the corner of a wide panel with a
               large empty area beside it, which read as the border being stretched rather than the
               video being correctly shaped. -->
          <ContentControl Style="{StaticResource Card.Neumorphic}"
                          HorizontalAlignment="Left"
                          Margin="{DynamicResource Gap.Below.XL}">
            <StackPanel>
              <!-- A true 16:9 rectangle, left-aligned, rather than stretching to the panel's full
                   width. Stretched, the slot became extremely wide and short, and the video - which
                   keeps its own 16:9 shape - sat letterboxed in the middle of a band of empty black.
                   Sizing the slot to the video's own aspect means the picture fills it exactly.
                   Fixed rather than computed: the player is a native window positioned over this
                   area, so it needs a rectangle that does not change size underneath it. -->
              <Border x:Name="PlayerSlot"
                      Width="720" Height="405"
                      HorizontalAlignment="Left"
                      Background="{DynamicResource Brush.Surface.Recessed}"
                      CornerRadius="{DynamicResource CornerRadius.S}"
                      Visibility="{Binding HasTrailer, Converter={StaticResource BoolToVisibility}}" />

              <TextBlock Style="{StaticResource Text.BodySecondary}"
                         Text="Looking for a video…"
                         Visibility="{Binding IsLoadingTrailer, Converter={StaticResource BoolToVisibility}}" />

              <TextBlock Style="{StaticResource Text.BodySecondary}"
                         TextWrapping="Wrap"
                         Text="No video found for this table. You can search for one, or point Nudge at your own file, from the Customize page."
                         Visibility="{Binding HasNoTrailer, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
          </ContentControl>

          <!-- ======================= About ======================= -->
          <TextBlock Style="{StaticResource Text.SectionHeading}" Margin="{DynamicResource Gap.Below.M}" Text="ABOUT" />

          <ContentControl Style="{StaticResource Card.Neumorphic}" Margin="{DynamicResource Gap.Below.XL}">
            <StackPanel>
              <!-- Text.Subtitle, not a "BodyLarge" - no such style exists. The blurb is a standfirst
                   above the description, and Subtitle is the app's existing step above body copy. -->
              <TextBlock Style="{StaticResource Text.Subtitle}"
                         TextWrapping="Wrap"
                         Text="{Binding Blurb}"
                         Visibility="{Binding HasBlurb, Converter={StaticResource BoolToVisibility}}" />

              <TextBlock Style="{StaticResource Text.Body}"
                         TextWrapping="Wrap"
                         Margin="{DynamicResource Gap.Above.M}"
                         Text="{Binding Description}"
                         Visibility="{Binding HasDescription, Converter={StaticResource BoolToVisibility}}" />

              <TextBlock Style="{StaticResource Text.BodySecondary}"
                         TextWrapping="Wrap"
                         Text="This table doesn't carry any written description of its own, and you haven't added one. You can write your own on the Customize page."
                         Visibility="{Binding HasNoWrittenDetail, Converter={StaticResource BoolToVisibility}}" />
            </StackPanel>
          </ContentControl>

          <!-- ======================= Rules ======================= -->
          <StackPanel Visibility="{Binding HasRules, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Style="{StaticResource Text.SectionHeading}" Margin="{DynamicResource Gap.Below.M}" Text="HOW TO PLAY" />
            <ContentControl Style="{StaticResource Card.Neumorphic}" Margin="{DynamicResource Gap.Below.XL}">
              <TextBlock Style="{StaticResource Text.Body}" TextWrapping="Wrap" Text="{Binding Rules}" />
            </ContentControl>
          </StackPanel>

          <!-- ======================= Play history ======================= -->
          <!-- Three numbers side by side rather than three more rows in the specifications list
               below: everything there describes the table, and this describes the person reading it.
               Hidden entirely until the table has actually been played - a row of dashes on a table
               you have never opened is noise, and "Never / - / -" says nothing the absence of the
               section does not. -->
          <StackPanel Visibility="{Binding HasBeenPlayed, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Style="{StaticResource Text.SectionHeading}" Margin="{DynamicResource Gap.Below.M}" Text="PLAY HISTORY" />

            <ContentControl Style="{StaticResource Card.Neumorphic}" Margin="{DynamicResource Gap.Below.XL}">
              <UniformGrid Columns="3">
                <StackPanel>
                  <TextBlock Style="{StaticResource Text.Title}" Text="{Binding TimesPlayedLabel}" />
                  <TextBlock Style="{StaticResource Text.Caption}"
                             Margin="{DynamicResource Gap.Above.S}"
                             Foreground="{DynamicResource Brush.Text.Muted}"
                             Text="PLAYED" />
                </StackPanel>
                <StackPanel>
                  <TextBlock Style="{StaticResource Text.Title}" Text="{Binding TotalPlayTimeLabel}" />
                  <TextBlock Style="{StaticResource Text.Caption}"
                             Margin="{DynamicResource Gap.Above.S}"
                             Foreground="{DynamicResource Brush.Text.Muted}"
                             Text="TOTAL TIME" />
                </StackPanel>
                <StackPanel>
                  <TextBlock Style="{StaticResource Text.Title}"
                             TextWrapping="Wrap"
                             Text="{Binding LastPlayedLabel}" />
                  <TextBlock Style="{StaticResource Text.Caption}"
                             Margin="{DynamicResource Gap.Above.S}"
                             Foreground="{DynamicResource Brush.Text.Muted}"
                             Text="LAST PLAYED" />
                </StackPanel>
              </UniformGrid>
            </ContentControl>
          </StackPanel>

          <!-- ======================= Specifications ======================= -->
          <TextBlock Style="{StaticResource Text.SectionHeading}" Margin="{DynamicResource Gap.Below.M}" Text="DETAILS" />

          <ContentControl Style="{StaticResource Card.Neumorphic}">
            <ItemsControl ItemsSource="{Binding Facts}">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="150" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0"
                               Style="{StaticResource Text.BodySecondary}"
                               Text="{Binding Label}" />
                    <TextBlock Grid.Column="1"
                               Style="{StaticResource Text.Body}"
                               TextWrapping="Wrap"
                               Text="{Binding Value}" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </ContentControl>
        </StackPanel>
      </Grid>
    </ScrollViewer>

    <!-- The embedded player is added here at runtime and positioned over PlayerSlot - a native
         child window cannot be a child of a Border, so it is layered over the page instead. -->
    <Grid x:Name="PlayerHost" Grid.Row="0" Grid.RowSpan="2" IsHitTestVisible="True" />
  </Grid>
</UserControl>
