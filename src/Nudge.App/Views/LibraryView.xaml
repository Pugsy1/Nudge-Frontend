<UserControl x:Class="Nudge.App.Views.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Nudge.App.ViewModels"
             xmlns:controls="clr-namespace:Nudge.App.Controls"
             xmlns:converters="clr-namespace:Nudge.App.Converters"
             d:DataContext="{d:DesignInstance Type=vm:LibraryViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

  <UserControl.Resources>

    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />

    <!-- One tile in the grid. Fixed size to match VirtualizingWrapPanel's ItemWidth/ItemHeight,
         which arranges every child at exactly that size regardless of its content.

         Root is a Button, not a plain Border, so clicking a tile launches that table - the whole
         card's visual is moved into the Button's own ControlTemplate rather than wrapping a Border
         around a separate Button, so nothing about the tile's appearance changes, it's just clickable
         now. Command binds up to LibraryViewModel via the hosting ItemsControl, since a
         TableTileViewModel itself has no launch capability of its own - that's a UI-only concern. -->
    <DataTemplate x:Key="TableTileTemplate" DataType="{x:Type vm:TableTileViewModel}">
      <Button Command="{Binding DataContext.LaunchTableCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
              CommandParameter="{Binding}"
              Cursor="Hand"
              Focusable="False"
              ToolTip="{Binding DisplayTitle}">
        <Button.Template>
          <ControlTemplate TargetType="Button">
            <!-- No explicit Width/Height here - the panel arranges every child at exactly
                 (Size.Tile.Width, Size.Tile.Height); with Margin also set, adding an explicit
                 Width/Height on top of that made this element request more space than its arranged
                 slot actually had, which showed up as inconsistent corner rounding and clipped text.
                 Stretch (the default) plus Margin alone fills the slot minus the gutter, with no
                 conflict. -->
            <Border x:Name="Root"
                    Margin="{DynamicResource Margin.Tile}"
                    Background="{DynamicResource Brush.Surface.Background}"
                    BorderBrush="{DynamicResource Brush.Surface.EdgeHighlight}"
                    BorderThickness="{DynamicResource BorderThickness.Thin}"
                    CornerRadius="{DynamicResource CornerRadius.M}"
                    Effect="{DynamicResource Effect.Tile.Shadow}"
                    SnapsToDevicePixels="True">
              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="*" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Placeholder art: Nudge has no artwork pipeline yet (a later phase per AGENTS.md),
                     so a tinted initial-letter swatch stands in for real box art rather than
                     pretending to be one. -->
                <Border Grid.Row="0"
                        Background="{DynamicResource Brush.Accent.Subtle}"
                        CornerRadius="{DynamicResource CornerRadius.Card.Top}">
                  <Grid>
                    <TextBlock Text="{Binding Initial}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontFamily="{DynamicResource Font.Family.Primary}"
                               FontSize="{DynamicResource Font.Size.Display}"
                               FontWeight="{DynamicResource Font.Weight.SemiBold}"
                               Foreground="{DynamicResource Brush.Accent}" />

                    <!-- "Play in VR" - only shown when the confirmed installation has a recognised
                         VR-capable build (see LibraryViewModel.HasVr). A nested Button works fine
                         here: WPF marks its Click as handled before it can bubble to the tile's own
                         Button underneath, so this doesn't also trigger a desktop launch. -->
                    <Button Content="VR"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Margin="6"
                            Padding="8,3,8,3"
                            FontFamily="{DynamicResource Font.Family.Primary}"
                            FontSize="{DynamicResource Font.Size.Caption}"
                            FontWeight="{DynamicResource Font.Weight.SemiBold}"
                            Cursor="Hand"
                            Focusable="False"
                            ToolTip="Play in VR"
                            Visibility="{Binding DataContext.HasVr, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource BoolToVisibility}}"
                            Command="{Binding DataContext.LaunchTableVrCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                            CommandParameter="{Binding}">
                      <Button.Template>
                        <ControlTemplate TargetType="Button">
                          <Border x:Name="VrRoot"
                                  Background="{DynamicResource Brush.Accent}"
                                  CornerRadius="{DynamicResource CornerRadius.S}">
                            <ContentPresenter Margin="{TemplateBinding Padding}"
                                               TextElement.Foreground="{DynamicResource Brush.Accent.Foreground}" />
                          </Border>
                          <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                              <Setter TargetName="VrRoot" Property="Background" Value="{DynamicResource Brush.Accent.Hover}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                              <Setter TargetName="VrRoot" Property="Opacity" Value="0.5" />
                            </Trigger>
                          </ControlTemplate.Triggers>
                        </ControlTemplate>
                      </Button.Template>
                    </Button>
                  </Grid>
                </Border>

                <StackPanel Grid.Row="1" Margin="{DynamicResource Padding.TableCell}">
                  <TextBlock Style="{StaticResource Text.Body}"
                             Text="{Binding DisplayTitle}"
                             Height="{DynamicResource Size.Tile.TitleHeight}"
                             TextWrapping="Wrap"
                             TextTrimming="CharacterEllipsis" />
                  <!-- Always present, even when Subtitle is empty - an empty TextBlock still
                       reserves a line's height, so the image/text boundary lands at the same place
                       on every tile whether or not it has a manufacturer/year, instead of tiles
                       without one having a shorter text area and an uneven bottom edge across the
                       row. -->
                  <TextBlock Style="{StaticResource Text.Caption}"
                             Text="{Binding Subtitle}"
                             TextWrapping="NoWrap"
                             TextTrimming="CharacterEllipsis" />
                </StackPanel>
              </Grid>
            </Border>
            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Control.BackgroundHover}" />
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <Setter TargetName="Root" Property="Effect" Value="{DynamicResource Effect.Button.Shadow.Pressed}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Root" Property="Opacity" Value="0.5" />
                <Setter Property="Cursor" Value="Arrow" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Button.Template>
      </Button>
    </DataTemplate>

  </UserControl.Resources>

  <Grid Background="{DynamicResource Brush.Window.Background}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Header -->
    <Grid Grid.Row="0" Margin="{DynamicResource Padding.Page}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0">
        <TextBlock Style="{StaticResource Text.Title}" Text="Your library" />
        <TextBlock Style="{StaticResource Text.BodySecondary}" Text="{Binding InstallationDisplayName}" />
      </StackPanel>

      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">

        <!-- The search box has no separate placeholder property in WPF, so an overlay TextBlock
             fills that role, hidden once the user has typed anything. A small magnifying-glass
             glyph (Segoe MDL2 Assets, the same icon font the title bar buttons use) sits to its
             left, tinted with the accent colour - the one hint of colour in an otherwise
             monochrome header, marking this out as the one control worth reaching for first. -->
        <Grid Margin="{DynamicResource Gap.Right.M}" VerticalAlignment="Center">
          <TextBox Style="{StaticResource TextBox.Search}"
                    Width="{DynamicResource Size.SearchBox.Width}"
                    Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
          <TextBlock Text="&#xE721;"
                      FontFamily="Segoe MDL2 Assets"
                      FontSize="12"
                      Margin="14,0,0,0"
                      HorizontalAlignment="Left"
                      VerticalAlignment="Center"
                      IsHitTestVisible="False"
                      Foreground="{DynamicResource Brush.Accent}" />
          <TextBlock Style="{StaticResource Text.Caption}"
                      Margin="{DynamicResource Padding.SearchBox}"
                      IsHitTestVisible="False"
                      VerticalAlignment="Center"
                      Text="Search tables..."
                      Visibility="{Binding HasSearchText, Converter={StaticResource InverseBoolToVisibility}}" />
        </Grid>

        <Button Style="{StaticResource Button.Secondary}"
                Margin="{DynamicResource Gap.Right.S}"
                Content="Rescan"
                Command="{Binding RescanCommand}" />
        <Button Style="{StaticResource Button.Secondary}"
                Margin="{DynamicResource Gap.Right.S}"
                Content="Change folder"
                Command="{Binding ChangeFolderCommand}" />
        <Button Style="{StaticResource Button.Secondary}"
                Margin="{DynamicResource Gap.Right.S}"
                Content="{Binding ThemeToggleLabel}"
                Command="{Binding ToggleThemeCommand}" />

        <!-- Placeholder for later features (collections, artwork, health checking, etc. - see
             AGENTS.md's phase table). Disabled rather than wired to nothing, so it reads honestly
             as "not built yet" instead of a button that silently does nothing when clicked. -->
        <Button Style="{StaticResource Button.Icon}"
                Content="&#xE713;"
                IsEnabled="False"
                ToolTip="Settings (coming soon)" />
      </StackPanel>
    </Grid>

    <!-- Status line: scan progress, or a summary of anything that failed to read. -->
    <TextBlock Grid.Row="1"
               Style="{StaticResource Text.Caption}"
               Margin="{DynamicResource Padding.Page}"
               Text="{Binding StatusMessage}"
               Visibility="{Binding HasStatusMessage, Converter={StaticResource BoolToVisibility}}" />

    <!-- ======================= First scan in progress, nothing to show yet ======================= -->
    <StackPanel Grid.Row="2"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Visibility="{Binding IsInitialScanning, Converter={StaticResource BoolToVisibility}}">
      <ProgressBar Style="{StaticResource Progress.Indeterminate}" Width="220" />
      <TextBlock Style="{StaticResource Text.BodySecondary}"
                 Margin="{DynamicResource Gap.Above.M}"
                 HorizontalAlignment="Center"
                 Text="Scanning your tables..." />
    </StackPanel>

    <!-- ======================= Scan finished, nothing found ======================= -->
    <StackPanel Grid.Row="2"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                MaxWidth="420"
                Visibility="{Binding HasNoTables, Converter={StaticResource BoolToVisibility}}">
      <TextBlock Style="{StaticResource Text.Subtitle}"
                 HorizontalAlignment="Center"
                 TextAlignment="Center"
                 Text="No tables found" />
      <TextBlock Style="{StaticResource Text.BodySecondary}"
                 Margin="{DynamicResource Gap.Above.S}"
                 HorizontalAlignment="Center"
                 TextAlignment="Center"
                 TextWrapping="Wrap"
                 Text="Nudge didn't find any .vpx files in this installation's Tables folder." />
    </StackPanel>

    <!-- ======================= The grid ======================= -->
    <ScrollViewer Grid.Row="2"
                  CanContentScroll="True"
                  Padding="{DynamicResource Padding.Page}"
                  Visibility="{Binding HasTables, Converter={StaticResource BoolToVisibility}}">
      <ItemsControl ItemsSource="{Binding TablesView}"
                    ItemTemplate="{StaticResource TableTileTemplate}"
                    Focusable="False"
                    VirtualizingPanel.IsVirtualizing="True"
                    VirtualizingPanel.ScrollUnit="Pixel">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <controls:VirtualizingWrapPanel ItemWidth="{DynamicResource Size.Tile.Width}"
                                             ItemHeight="{DynamicResource Size.Tile.Height}" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
      </ItemsControl>
    </ScrollViewer>

    <!-- ======================= Launching a table ======================= -->
    <!-- Visual Pinball itself gives Nudge no "the table finished loading" signal - only "started"
         and "exited" - so this stays up for the whole play session, not just an initial load. Last
         in the row, so it paints over the grid. -->
    <Border Grid.Row="2"
            Background="{DynamicResource Brush.Overlay.Scrim}"
            Visibility="{Binding IsLaunching, Converter={StaticResource BoolToVisibility}}">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
        <ProgressBar Style="{StaticResource Progress.Indeterminate}" Width="220" />
        <TextBlock Style="{StaticResource Text.BodySecondary}"
                   Margin="{DynamicResource Gap.Above.M}"
                   HorizontalAlignment="Center"
                   Text="{Binding StatusMessage}" />
      </StackPanel>
    </Border>

  </Grid>
</UserControl>
