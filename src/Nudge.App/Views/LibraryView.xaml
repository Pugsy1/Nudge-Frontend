<UserControl x:Class="Nudge.App.Views.LibraryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Nudge.App.ViewModels"
             xmlns:models="clr-namespace:Nudge.Core.Models;assembly=Nudge.Core"
             xmlns:controls="clr-namespace:Nudge.App.Controls"
             xmlns:converters="clr-namespace:Nudge.App.Converters"
             d:DataContext="{d:DesignInstance Type=vm:LibraryViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

  <UserControl.Resources>

    <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisibility" />

    <!-- The identification-confidence lamp: a small LED behind a diffuser, tinted by how sure
         Nudge is that it identified the table correctly. Hidden unless turned on in settings. -->
    <Style x:Key="ConfidenceLamp" TargetType="Ellipse">
      <Setter Property="Width" Value="8" />
      <Setter Property="Height" Value="8" />
      <Setter Property="Fill" Value="{DynamicResource Brush.Confidence.Unknown}" />
      <Style.Triggers>
        <DataTrigger Binding="{Binding Confidence}" Value="{x:Static models:Confidence.High}">
          <Setter Property="Fill" Value="{DynamicResource Brush.Confidence.High}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Confidence}" Value="{x:Static models:Confidence.Medium}">
          <Setter Property="Fill" Value="{DynamicResource Brush.Confidence.Medium}" />
        </DataTrigger>
        <DataTrigger Binding="{Binding Confidence}" Value="{x:Static models:Confidence.Low}">
          <Setter Property="Fill" Value="{DynamicResource Brush.Confidence.Low}" />
        </DataTrigger>
      </Style.Triggers>
    </Style>

    <!--
      One tile in the grid. The root is a Button (its whole visual lives in the ControlTemplate) so
      clicking anywhere on the card launches that table.

      Hover lifts the card toward the light: a small scale-up plus a deeper, longer shadow, both
      animated over Duration.Hover. The scale is a render transform, so it never disturbs layout -
      and Margin.Tile leaves more slack around each card than the scale consumes, so a lifted tile
      never clips against its neighbours.
    -->
    <DataTemplate x:Key="TableTileTemplate" DataType="{x:Type vm:TableTileViewModel}">
      <Button Command="{Binding DataContext.LaunchTableCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
              CommandParameter="{Binding}"
              Cursor="Hand"
              Focusable="False"
              RenderTransformOrigin="0.5,0.5">
        <Button.Template>
          <ControlTemplate TargetType="Button">
            <!--
              True neumorphic emboss: two DropShadowEffects can't live on one element, so the dark
              (bottom-right) and light (top-left) shadows are each their own same-shape Border,
              stacked behind the real content. Both are fully opaque, so with all three Borders the
              exact same size/position, each shadow layer's own flat body is entirely covered by the
              one on top of it - only the blur that extends past the shared edges survives, as a
              soft dark glow peeking out one corner and a soft light glow peeking out the other.
              Kept subtle at rest (low opacity, tight blur) specifically because dozens of these sit
              on screen together - the point is individual depth per tile, not a haze across the
              whole grid.
            -->
            <Grid Margin="{DynamicResource Margin.Tile}"
                  RenderTransformOrigin="0.5,0.5">
              <Grid.RenderTransform>
                <ScaleTransform x:Name="Lift" ScaleX="1" ScaleY="1" />
              </Grid.RenderTransform>

              <!-- BitmapCache on both shadow layers: each DropShadowEffect is otherwise recomputed
                   every frame it's on screen, and with virtualization keeping 30-40 tiles realized
                   at once during a scroll, two effects per tile is real compositing cost. Caching
                   rasterizes each layer once and reuses that bitmap - safe here because neither
                   layer's content ever changes (a static Background fill), only its Effect gets
                   swapped between the Rest/Hover/Pressed resources, which still invalidates and
                   re-caches correctly. -->
              <Border x:Name="ShadowLayer"
                      Background="{DynamicResource Brush.Surface.Background}"
                      CornerRadius="{DynamicResource CornerRadius.M}"
                      Effect="{DynamicResource Effect.Tile.Shadow.Rest}"
                      CacheMode="BitmapCache" />

              <Border x:Name="HighlightLayer"
                      Background="{DynamicResource Brush.Surface.Background}"
                      CornerRadius="{DynamicResource CornerRadius.M}"
                      Effect="{DynamicResource Effect.Tile.Highlight.Rest}"
                      CacheMode="BitmapCache" />

              <Border x:Name="Root"
                      Background="{DynamicResource Brush.Surface.Background}"
                      BorderBrush="{DynamicResource Brush.Surface.EdgeHighlight}"
                      BorderThickness="{DynamicResource BorderThickness.Tile}"
                      CornerRadius="{DynamicResource CornerRadius.M}"
                      SnapsToDevicePixels="True">

              <Grid>
                <Grid.RowDefinitions>
                  <RowDefinition Height="*" />
                  <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Placeholder art. Nudge has no artwork pipeline yet (a later phase per
                     AGENTS.md), so a recessed slot holding the title's initial stands in for real
                     box art rather than pretending to be one. -->
                <Border Grid.Row="0"
                        Background="{DynamicResource Brush.Surface.Recessed}"
                        CornerRadius="{DynamicResource CornerRadius.Card.Top}">
                  <Grid>
                    <TextBlock Text="{Binding Initial}"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               FontFamily="{DynamicResource Font.Family.Primary}"
                               FontSize="{DynamicResource Font.Size.Display}"
                               FontWeight="{DynamicResource Font.Weight.SemiBold}"
                               Foreground="{DynamicResource Brush.Text.Muted}"
                               Opacity="0.55" />

                    <!-- Confidence lamp, opt-in via settings. -->
                    <Border HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Margin="{DynamicResource Inset.M}"
                            ToolTip="{Binding ConfidenceLabel}"
                            Visibility="{Binding DataContext.ShowConfidence, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource BoolToVisibility}}">
                      <Ellipse Style="{StaticResource ConfidenceLamp}" />
                    </Border>
                  </Grid>
                </Border>

                <StackPanel Grid.Row="1" Margin="{DynamicResource Padding.TableCell}">
                  <TextBlock Style="{StaticResource Text.Body}"
                             Text="{Binding DisplayTitle}"
                             Height="{DynamicResource Size.Tile.TitleHeight}"
                             TextWrapping="Wrap"
                             TextTrimming="CharacterEllipsis" />
                  <!-- Always present, even when Subtitle is empty - an empty TextBlock still
                       reserves a line's height, so the artwork/text boundary lands at the same
                       place on every tile whether or not it has a manufacturer and year. -->
                  <TextBlock Style="{StaticResource Text.Caption}"
                             Text="{Binding Subtitle}"
                             TextWrapping="NoWrap"
                             TextTrimming="CharacterEllipsis" />
                </StackPanel>

                <!-- Favourite: a die-cut star outline at rest, filling solid when starred. A
                     nested Button works fine here, same as the VR badge used to - WPF marks its
                     Click handled before it can bubble to the tile's own Button underneath. -->
                <Button Grid.Row="0" Grid.RowSpan="2"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Margin="8"
                        Width="30" Height="30"
                        Cursor="Hand"
                        Focusable="False"
                        ToolTip="Favourite"
                        Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                        CommandParameter="{Binding}">
                  <Button.Template>
                    <ControlTemplate TargetType="Button">
                      <Border x:Name="StarRoot"
                              Background="{DynamicResource Brush.Surface.Glass}"
                              CornerRadius="{DynamicResource CornerRadius.Pill}">
                        <Grid>
                          <TextBlock Text="&#xE734;"
                                     FontFamily="Segoe MDL2 Assets"
                                     FontSize="14"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     Foreground="{DynamicResource Brush.Text.Secondary}"
                                     Visibility="{Binding IsFavorite, Converter={StaticResource InverseBoolToVisibility}}" />
                          <TextBlock Text="&#xE735;"
                                     FontFamily="Segoe MDL2 Assets"
                                     FontSize="14"
                                     HorizontalAlignment="Center"
                                     VerticalAlignment="Center"
                                     Foreground="{DynamicResource Brush.Accent}"
                                     Visibility="{Binding IsFavorite, Converter={StaticResource BoolToVisibility}}" />
                        </Grid>
                      </Border>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Setter TargetName="StarRoot" Property="Background" Value="{DynamicResource Brush.Control.BackgroundHover}" />
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Button.Template>
                </Button>
              </Grid>
              </Border>
            </Grid>

            <ControlTemplate.Triggers>
              <Trigger Property="IsMouseOver" Value="True">
                <!-- Lifted: both shadow layers deepen and spread together. -->
                <Setter TargetName="ShadowLayer" Property="Effect" Value="{DynamicResource Effect.Tile.Shadow.Hover}" />
                <Setter TargetName="HighlightLayer" Property="Effect" Value="{DynamicResource Effect.Tile.Highlight.Hover}" />
                <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.Surface.RimLight}" />
                <Trigger.EnterActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Lift"
                                       Storyboard.TargetProperty="ScaleX"
                                       To="{StaticResource Scale.Tile.Hover}"
                                       Duration="{StaticResource Duration.Hover}" />
                      <DoubleAnimation Storyboard.TargetName="Lift"
                                       Storyboard.TargetProperty="ScaleY"
                                       To="{StaticResource Scale.Tile.Hover}"
                                       Duration="{StaticResource Duration.Hover}" />
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                  <BeginStoryboard>
                    <Storyboard>
                      <DoubleAnimation Storyboard.TargetName="Lift"
                                       Storyboard.TargetProperty="ScaleX"
                                       To="1"
                                       Duration="{StaticResource Duration.Hover}" />
                      <DoubleAnimation Storyboard.TargetName="Lift"
                                       Storyboard.TargetProperty="ScaleY"
                                       To="1"
                                       Duration="{StaticResource Duration.Hover}" />
                    </Storyboard>
                  </BeginStoryboard>
                </Trigger.ExitActions>
              </Trigger>
              <Trigger Property="IsPressed" Value="True">
                <!-- Pressed: both shadows tighten toward nothing, as though the tile sank flush
                     with the page instead of standing proud of it. -->
                <Setter TargetName="ShadowLayer" Property="Effect" Value="{DynamicResource Effect.Tile.Shadow.Pressed}" />
                <Setter TargetName="HighlightLayer" Property="Effect" Value="{DynamicResource Effect.Tile.Highlight.Pressed}" />
              </Trigger>
              <Trigger Property="IsEnabled" Value="False">
                <Setter TargetName="Root" Property="Opacity" Value="0.45" />
                <Setter Property="Cursor" Value="Arrow" />
              </Trigger>
            </ControlTemplate.Triggers>
          </ControlTemplate>
        </Button.Template>
      </Button>
    </DataTemplate>

  </UserControl.Resources>

  <Grid Background="{DynamicResource Brush.Window.Background}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- ======================= Header ======================= -->
    <Grid Grid.Row="0" Margin="{DynamicResource Padding.Page}">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" />
        <ColumnDefinition Width="Auto" />
      </Grid.ColumnDefinitions>

      <!-- Recoloured to the active theme's accent rather than shown as the source PNG's own white
           gloss: an OpacityMask reads the artwork purely as a silhouette (alpha channel), then Fill
           paints that shape with whatever DynamicResource Brush.Accent currently resolves to, so the
           wordmark re-tints itself on every theme switch along with everything else. -->
      <Rectangle Grid.Column="0"
                 Width="127" Height="72"
                 HorizontalAlignment="Left"
                 VerticalAlignment="Center"
                 UseLayoutRounding="True"
                 ToolTip="{Binding InstallationDisplayName}"
                 Fill="{DynamicResource Brush.Accent}">
        <Rectangle.OpacityMask>
          <ImageBrush ImageSource="pack://application:,,,/Assets/Library.png"
                      Stretch="Uniform"
                      RenderOptions.BitmapScalingMode="HighQuality" />
        </Rectangle.OpacityMask>
      </Rectangle>

      <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">

        <!-- 2D / VR launch mode: one fluid pill, not two separate buttons. The whole track is
             clickable - either half sets that mode - and a sliding cap animates to whichever side
             is active, rather than the state being conveyed only by two static toggle buttons. -->
        <Border Style="{StaticResource Segment.Track}"
                Width="112" Height="34"
                Margin="{DynamicResource Gap.Right.L}"
                IsEnabled="{Binding HasVr}"
                ToolTip="Which Visual Pinball build a table launches on">
          <Grid>
            <!-- The sliding cap: a raised pill that glides under whichever label is selected. -->
            <Border x:Name="SwitchCap"
                    Width="52" Height="26"
                    HorizontalAlignment="Left"
                    Background="{DynamicResource Brush.Control.Background}"
                    BorderBrush="{DynamicResource Brush.Surface.EdgeHighlight}"
                    BorderThickness="{DynamicResource BorderThickness.Thin}"
                    CornerRadius="{DynamicResource CornerRadius.Pill}"
                    Effect="{DynamicResource Effect.Button.Shadow}"
                    RenderTransformOrigin="0.5,0.5">
              <Border.RenderTransform>
                <TranslateTransform x:Name="CapOffset" X="0" />
              </Border.RenderTransform>
              <Border.Style>
                <Style TargetType="Border">
                  <Style.Triggers>
                    <DataTrigger Binding="{Binding IsVrMode}" Value="True">
                      <DataTrigger.EnterActions>
                        <BeginStoryboard>
                          <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.X"
                                             To="52" Duration="{StaticResource Duration.Hover}">
                              <DoubleAnimation.EasingFunction>
                                <QuadraticEase EasingMode="EaseOut" />
                              </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                          </Storyboard>
                        </BeginStoryboard>
                      </DataTrigger.EnterActions>
                      <DataTrigger.ExitActions>
                        <BeginStoryboard>
                          <Storyboard>
                            <DoubleAnimation Storyboard.TargetProperty="RenderTransform.X"
                                             To="0" Duration="{StaticResource Duration.Hover}">
                              <DoubleAnimation.EasingFunction>
                                <QuadraticEase EasingMode="EaseOut" />
                              </DoubleAnimation.EasingFunction>
                            </DoubleAnimation>
                          </Storyboard>
                        </BeginStoryboard>
                      </DataTrigger.ExitActions>
                    </DataTrigger>
                  </Style.Triggers>
                </Style>
              </Border.Style>
            </Border>

            <!-- Two invisible, full-half click targets layered above the cap - clicking anywhere in
                 either half sets that mode, not just a small label in the middle of it. -->
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
              </Grid.ColumnDefinitions>
              <Button Grid.Column="0"
                      Style="{StaticResource Button.Base}"
                      Background="Transparent" BorderThickness="0" MinWidth="0" Padding="0"
                      Content="2D" FontSize="{DynamicResource Font.Size.Caption}"
                      FontWeight="{DynamicResource Font.Weight.SemiBold}"
                      Foreground="{DynamicResource Brush.Text.Secondary}"
                      Command="{Binding SetLaunchModeCommand}" CommandParameter="Desktop" />
              <Button Grid.Column="1"
                      Style="{StaticResource Button.Base}"
                      Background="Transparent" BorderThickness="0" MinWidth="0" Padding="0"
                      Content="VR" FontSize="{DynamicResource Font.Size.Caption}"
                      FontWeight="{DynamicResource Font.Weight.SemiBold}"
                      Foreground="{DynamicResource Brush.Text.Secondary}"
                      Command="{Binding SetLaunchModeCommand}" CommandParameter="Vr" />
            </Grid>
          </Grid>
        </Border>

        <!-- Search. The magnifier sits inside the milled slot; the placeholder clears on typing. -->
        <Grid Margin="{DynamicResource Gap.Right.M}" VerticalAlignment="Center">
          <TextBox Style="{StaticResource TextBox.Search}"
                   Width="{DynamicResource Size.SearchBox.Width}"
                   Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" />
          <TextBlock Text="&#xE721;"
                     FontFamily="Segoe MDL2 Assets"
                     FontSize="12"
                     Margin="14,0,0,0"
                     HorizontalAlignment="Left"
                     VerticalAlignment="Center"
                     IsHitTestVisible="False"
                     Foreground="{DynamicResource Brush.Accent}" />
          <TextBlock Style="{StaticResource Text.Caption}"
                     Margin="{DynamicResource Padding.SearchBox}"
                     IsHitTestVisible="False"
                     VerticalAlignment="Center"
                     Text="Search tables…"
                     Visibility="{Binding HasSearchText, Converter={StaticResource InverseBoolToVisibility}}" />
        </Grid>

        <ComboBox Style="{StaticResource ComboBox.Standard}"
                  Width="188"
                  Margin="{DynamicResource Gap.Right.M}"
                  ItemsSource="{Binding SortOptions}"
                  SelectedItem="{Binding SelectedSort, Mode=TwoWay}"
                  DisplayMemberPath="Label"
                  ToolTip="Sort the library" />

        <!-- Grid density: how many tiles fit per row, 3 (fewest, largest tiles) to 8 (most, smallest
             tiles). Bound straight through to VirtualizingWrapPanel.Columns via TablesPerRow. -->
        <StackPanel Orientation="Horizontal" Margin="{DynamicResource Gap.Right.M}" VerticalAlignment="Center" ToolTip="Tiles per row">
          <TextBlock Text="&#xE80A;"
                     FontFamily="Segoe MDL2 Assets"
                     FontSize="14"
                     Margin="0,0,8,0"
                     VerticalAlignment="Center"
                     Foreground="{DynamicResource Brush.Text.Muted}" />
          <Slider Style="{StaticResource Slider.Standard}"
                  Width="100"
                  Minimum="3"
                  Maximum="8"
                  Value="{Binding TablesPerRow, Mode=TwoWay}" />
          <TextBlock Text="{Binding TablesPerRow}"
                     Style="{StaticResource Text.Caption}"
                     Margin="8,0,0,0"
                     Width="14"
                     VerticalAlignment="Center" />
        </StackPanel>

        <Button Style="{StaticResource Button.Secondary}"
                Margin="{DynamicResource Gap.Right.M}"
                Content="Rescan"
                Command="{Binding RescanCommand}" />

        <!-- Settings. Just navigates to the full SettingsView (via ShellViewModel watching
             IsSettingsOpen) - this used to also open a compact Popup flyout anchored right here
             with a duplicate theme/confidence UI, left over from before the full page existed. Both
             were driven by the same IsSettingsOpen flag, so clicking the cog opened the popup for a
             single frame and then yanked it away as the page navigation tore this view down under
             it - a flash that looked like a random, unexplained popup. -->
        <Button x:Name="SettingsButton"
                Style="{StaticResource Button.Icon}"
                Content="&#xE713;"
                ToolTip="Settings"
                Command="{Binding ToggleSettingsCommand}" />
      </StackPanel>
    </Grid>

    <!-- Status line: scan progress, or a summary of anything that failed to read. -->
    <TextBlock Grid.Row="1"
               Style="{StaticResource Text.Caption}"
               Margin="40,0,40,16"
               Text="{Binding StatusMessage}"
               Visibility="{Binding ShowStatusLine, Converter={StaticResource BoolToVisibility}}" />

    <!-- ======================= First scan in progress ======================= -->
    <StackPanel Grid.Row="2"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Visibility="{Binding IsInitialScanning, Converter={StaticResource BoolToVisibility}}">
      <ProgressBar Style="{StaticResource Progress.Indeterminate}" Width="240" />
      <TextBlock Style="{StaticResource Text.BodySecondary}"
                 Margin="{DynamicResource Gap.Above.XL}"
                 HorizontalAlignment="Center"
                 Text="Reading your tables…" />
    </StackPanel>

    <!-- ======================= Empty: the installation holds no tables ======================= -->
    <StackPanel Grid.Row="2"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                MaxWidth="440"
                Visibility="{Binding HasNoTables, Converter={StaticResource BoolToVisibility}}">

      <!-- An empty tile slot with a chrome ball resting in it: the same recessed-slot and polished
           disc language as the rest of the app and its icon, rather than clip art. -->
      <Canvas Width="150" Height="120" HorizontalAlignment="Center" Margin="{DynamicResource Gap.Below.XL}">
        <Border Canvas.Left="15" Canvas.Top="8"
                Width="120" Height="86"
                Background="{DynamicResource Brush.Surface.Recessed}"
                BorderBrush="{DynamicResource Brush.Surface.Border}"
                BorderThickness="{DynamicResource BorderThickness.Thin}"
                CornerRadius="{DynamicResource CornerRadius.M}" />
        <Ellipse Canvas.Left="60" Canvas.Top="42" Width="30" Height="30">
          <Ellipse.Fill>
            <RadialGradientBrush GradientOrigin="0.34,0.28" Center="0.5,0.5" RadiusX="0.72" RadiusY="0.72">
              <GradientStop Color="#F2F4F8" Offset="0" />
              <GradientStop Color="#98A0B0" Offset="0.55" />
              <GradientStop Color="#4A5265" Offset="1" />
            </RadialGradientBrush>
          </Ellipse.Fill>
        </Ellipse>
        <!-- The ball's contact shadow, grounding it in the slot. -->
        <Ellipse Canvas.Left="58" Canvas.Top="74" Width="34" Height="7" Opacity="0.4">
          <Ellipse.Fill>
            <RadialGradientBrush>
              <GradientStop Color="{DynamicResource Color.Shadow}" Offset="0" />
              <GradientStop Color="#00000000" Offset="1" />
            </RadialGradientBrush>
          </Ellipse.Fill>
        </Ellipse>
      </Canvas>

      <TextBlock Style="{StaticResource Text.Subtitle}"
                 HorizontalAlignment="Center"
                 TextAlignment="Center"
                 Text="Nothing here yet" />
      <TextBlock Style="{StaticResource Text.BodySecondary}"
                 Margin="{DynamicResource Gap.Above.M}"
                 HorizontalAlignment="Center"
                 TextAlignment="Center"
                 TextWrapping="Wrap"
                 Text="Nudge didn't find any .vpx files in this installation's Tables folder." />
      <Button Style="{StaticResource Button.Secondary}"
              Margin="{DynamicResource Gap.Above.XL}"
              HorizontalAlignment="Center"
              Content="Change folder"
              Command="{Binding ChangeFolderCommand}" />
    </StackPanel>

    <!-- ======================= Empty: search matched nothing ======================= -->
    <StackPanel Grid.Row="2"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                MaxWidth="440"
                Visibility="{Binding HasNoSearchResults, Converter={StaticResource BoolToVisibility}}">

      <!-- A chrome magnifier over an empty slot - same material vocabulary as the icon above. -->
      <Canvas Width="150" Height="120" HorizontalAlignment="Center" Margin="{DynamicResource Gap.Below.XL}">
        <Border Canvas.Left="15" Canvas.Top="26"
                Width="120" Height="68"
                Background="{DynamicResource Brush.Surface.Recessed}"
                BorderBrush="{DynamicResource Brush.Surface.Border}"
                BorderThickness="{DynamicResource BorderThickness.Thin}"
                CornerRadius="{DynamicResource CornerRadius.M}" />
        <!-- The handle, drawn under the ring so the ring's rim overlaps it cleanly. -->
        <Rectangle Canvas.Left="92" Canvas.Top="66" Width="30" Height="7"
                   RadiusX="3.5" RadiusY="3.5"
                   Fill="{DynamicResource Brush.Text.Muted}"
                   Opacity="0.75">
          <Rectangle.RenderTransform>
            <RotateTransform Angle="42" CenterX="0" CenterY="3.5" />
          </Rectangle.RenderTransform>
        </Rectangle>
        <Ellipse Canvas.Left="42" Canvas.Top="20" Width="54" Height="54"
                 StrokeThickness="7"
                 Fill="{DynamicResource Brush.Surface.Glass}">
          <Ellipse.Stroke>
            <LinearGradientBrush StartPoint="0.15,0" EndPoint="0.85,1">
              <GradientStop Color="#E8ECF2" Offset="0" />
              <GradientStop Color="#8E97A8" Offset="0.5" />
              <GradientStop Color="#454C5C" Offset="1" />
            </LinearGradientBrush>
          </Ellipse.Stroke>
        </Ellipse>
      </Canvas>

      <TextBlock Style="{StaticResource Text.Subtitle}"
                 HorizontalAlignment="Center"
                 TextAlignment="Center"
                 Text="No tables match that" />
      <TextBlock Style="{StaticResource Text.BodySecondary}"
                 Margin="{DynamicResource Gap.Above.M}"
                 HorizontalAlignment="Center"
                 TextAlignment="Center"
                 TextWrapping="Wrap"
                 Text="Try a shorter search, or check the spelling." />
      <Button Style="{StaticResource Button.Secondary}"
              Margin="{DynamicResource Gap.Above.XL}"
              HorizontalAlignment="Center"
              Content="Clear search"
              Command="{Binding ClearSearchCommand}" />
    </StackPanel>

    <!-- ======================= Empty: "Favourites only" selected, nothing starred yet ======================= -->
    <StackPanel Grid.Row="2"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                MaxWidth="440"
                Visibility="{Binding HasNoFavorites, Converter={StaticResource BoolToVisibility}}">

      <!-- The same recessed slot as the other empty states, holding a large outline star instead
           of a hand-drawn illustration - it's already the exact icon the star button itself uses. -->
      <Border Width="120" Height="94"
              HorizontalAlignment="Center"
              Margin="{DynamicResource Gap.Below.XL}"
              Background="{DynamicResource Brush.Surface.Recessed}"
              BorderBrush="{DynamicResource Brush.Surface.Border}"
              BorderThickness="{DynamicResource BorderThickness.Thin}"
              CornerRadius="{DynamicResource CornerRadius.M}">
        <TextBlock Text="&#xE734;"
                   FontFamily="Segoe MDL2 Assets"
                   FontSize="36"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Foreground="{DynamicResource Brush.Text.Muted}" />
      </Border>

      <TextBlock Style="{StaticResource Text.Subtitle}"
                 HorizontalAlignment="Center"
                 TextAlignment="Center"
                 Text="No favourites yet" />
      <TextBlock Style="{StaticResource Text.BodySecondary}"
                 Margin="{DynamicResource Gap.Above.M}"
                 HorizontalAlignment="Center"
                 TextAlignment="Center"
                 TextWrapping="Wrap"
                 Text="Click the star on a table to add it here." />
      <ComboBox Style="{StaticResource ComboBox.Standard}"
                Margin="{DynamicResource Gap.Above.XL}"
                HorizontalAlignment="Center"
                Width="188"
                ItemsSource="{Binding SortOptions}"
                SelectedItem="{Binding SelectedSort, Mode=TwoWay}"
                DisplayMemberPath="Label" />
    </StackPanel>

    <!-- ======================= The grid ======================= -->
    <ScrollViewer Grid.Row="2"
                  CanContentScroll="True"
                  Padding="{DynamicResource Padding.Grid}"
                  Visibility="{Binding HasVisibleTables, Converter={StaticResource BoolToVisibility}}">
      <ItemsControl ItemsSource="{Binding TablesView}"
                    ItemTemplate="{StaticResource TableTileTemplate}"
                    Focusable="False"
                    VirtualizingPanel.IsVirtualizing="True"
                    VirtualizingPanel.ScrollUnit="Pixel">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <controls:VirtualizingWrapPanel ItemWidth="{DynamicResource Size.Tile.Width}"
                                            ItemHeight="{DynamicResource Size.Tile.Height}"
                                            Columns="{Binding DataContext.TablesPerRow, RelativeSource={RelativeSource AncestorType=ItemsControl}}" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
      </ItemsControl>
    </ScrollViewer>

    <!-- ======================= Launching a table ======================= -->
    <!-- Visual Pinball gives Nudge no "the table finished loading" signal - only "started" and
         "exited" - so this stays up for the whole play session. Last in the row, so it paints
         over the grid. -->
    <Border Grid.Row="2"
            Background="{DynamicResource Brush.Overlay.Scrim}"
            Visibility="{Binding IsLaunching, Converter={StaticResource BoolToVisibility}}">
      <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
        <ProgressBar Style="{StaticResource Progress.Indeterminate}" Width="240" />
        <TextBlock Style="{StaticResource Text.BodySecondary}"
                   Margin="{DynamicResource Gap.Above.XL}"
                   HorizontalAlignment="Center"
                   Text="{Binding StatusMessage}" />
      </StackPanel>
    </Border>

  </Grid>
</UserControl>
