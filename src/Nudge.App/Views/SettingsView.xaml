<UserControl x:Class="Nudge.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:Nudge.App.ViewModels"
             d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

  <Grid Background="{DynamicResource Brush.Window.Background}">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
    </Grid.RowDefinitions>

    <!-- Header -->
    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="{DynamicResource Padding.Page}" VerticalAlignment="Center">
      <Button Style="{StaticResource Button.Icon}"
              Content="&#xE72B;"
              Margin="{DynamicResource Gap.Right.L}"
              ToolTip="Back to your library"
              Command="{Binding BackCommand}" />
      <TextBlock Style="{StaticResource Text.Title}" Text="Settings" VerticalAlignment="Center" />
    </StackPanel>

    <ScrollViewer Grid.Row="1" Padding="40,0,40,40">
      <StackPanel MaxWidth="640" HorizontalAlignment="Left">

        <!-- ======================= Identification ======================= -->
        <TextBlock Style="{StaticResource Text.SectionHeading}" Margin="{DynamicResource Gap.Below.M}" Text="IDENTIFICATION" />

        <Border Style="{StaticResource Surface.Inset}" Margin="{DynamicResource Gap.Below.XL}">
          <StackPanel>
            <CheckBox Style="{StaticResource Switch}"
                      IsChecked="{Binding Library.ShowConfidence, Mode=TwoWay}">
              <TextBlock Style="{StaticResource Text.Body}" Text="Show identification confidence" />
            </CheckBox>
            <TextBlock Style="{StaticResource Text.Caption}"
                       Margin="{DynamicResource Gap.Above.S}"
                       TextWrapping="Wrap"
                       Text="Adds a small status lamp to each table's artwork showing how sure Nudge is that it identified the table correctly, and why - useful for spotting a table Nudge might have got wrong." />
          </StackPanel>
        </Border>

        <!-- ======================= Appearance ======================= -->
        <TextBlock Style="{StaticResource Text.SectionHeading}" Margin="{DynamicResource Gap.Below.M}" Text="APPEARANCE" />

        <Border Style="{StaticResource Surface.Inset}" Margin="{DynamicResource Gap.Below.XL}">
          <Grid>
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Style="{StaticResource Text.Body}" Text="Theme" VerticalAlignment="Center" />
            <ComboBox Grid.Column="1"
                      Style="{StaticResource ComboBox.Standard}"
                      Width="220"
                      ItemsSource="{Binding Library.ThemeOptions}"
                      SelectedItem="{Binding Library.SelectedTheme, Mode=TwoWay}"
                      DisplayMemberPath="Label" />
          </Grid>
        </Border>

        <!-- ======================= Coming later ======================= -->
        <TextBlock Style="{StaticResource Text.SectionHeading}" Margin="{DynamicResource Gap.Below.M}" Text="COMING LATER" />

        <Border Style="{StaticResource Surface.Inset}">
          <StackPanel>
            <TextBlock Style="{StaticResource Text.Body}" Text="Favourites, playtime tracking, and last-played sorting" />
            <TextBlock Style="{StaticResource Text.Caption}"
                       Margin="{DynamicResource Gap.Above.S}"
                       TextWrapping="Wrap"
                       Text="Nudge doesn't yet record when a table was added or last played, so there's nothing here to turn on. That needs a small database change before it can work - this page is the reserved spot for it once it does." />
          </StackPanel>
        </Border>

      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
