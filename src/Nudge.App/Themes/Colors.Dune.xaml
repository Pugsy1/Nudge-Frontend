<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    Dune palette - the warm counterpart to Colors.Sage.xaml, and the second of the deliberately calm,
    low-energy themes. Sand and warm stone rather than the neutral graphite every other dark palette
    builds on: the whole room is faintly warm, and the accent is a soft tan that sits close to the
    surfaces around it instead of standing out from them. Like Sage, this is meant to recede behind
    the artwork.

    See Colors.Dark.xaml for the underlying material language.
  -->

  <!-- ============================ Ground ============================ -->

  <RadialGradientBrush x:Key="Brush.Window.Background" GradientOrigin="0.5,0.28" Center="0.5,0.28" RadiusX="0.9" RadiusY="0.85">
    <GradientStop Color="#2A2621" Offset="0" />
    <GradientStop Color="#221F1A" Offset="0.75" />
    <GradientStop Color="#1B1815" Offset="1" />
  </RadialGradientBrush>

  <SolidColorBrush x:Key="Brush.Window.BackgroundFlat" Color="#221F1A" />

  <!-- ============================ Surfaces ============================ -->

  <LinearGradientBrush x:Key="Brush.Surface.Background" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#2C2823" Offset="0" />
    <GradientStop Color="#25211D" Offset="1" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="Brush.Surface.BackgroundAlt" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#322D27" Offset="0" />
    <GradientStop Color="#2A2621" Offset="1" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="Brush.Surface.Recessed" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#1D1A16" Offset="0" />
    <GradientStop Color="#23201B" Offset="1" />
  </LinearGradientBrush>

  <SolidColorBrush x:Key="Brush.Surface.Border" Color="#3E3830" />

  <SolidColorBrush x:Key="Brush.Surface.Glass" Color="#B32C2823" />

  <LinearGradientBrush x:Key="Brush.Surface.EdgeHighlight" StartPoint="0.15,0" EndPoint="0.85,1">
    <GradientStop Color="#8A7A64" Offset="0" />
    <GradientStop Color="#453E34" Offset="0.5" />
    <GradientStop Color="#161311" Offset="1" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="Brush.Surface.RimLight" StartPoint="0.15,0" EndPoint="0.85,1">
    <GradientStop Color="#A8977C" Offset="0" />
    <GradientStop Color="#5A5144" Offset="0.5" />
    <GradientStop Color="#1B1815" Offset="1" />
  </LinearGradientBrush>

  <Color x:Key="Color.Shadow">#000000</Color>

  <!-- Tinted to this palette's own warm sand rim light. -->
  <Color x:Key="Color.Highlight">#8A7A64</Color>

  <!-- ============================ Text ============================ -->

  <SolidColorBrush x:Key="Brush.Text.Primary" Color="#EFEBE4" />
  <SolidColorBrush x:Key="Brush.Text.Secondary" Color="#ADA595" />
  <SolidColorBrush x:Key="Brush.Text.Muted" Color="#7B7364" />

  <!-- ============================ Accent ============================ -->

  <!-- Soft tan - warm and quiet, deliberately close in value to the surfaces around it. -->
  <SolidColorBrush x:Key="Brush.Accent" Color="#C9AC84" />
  <SolidColorBrush x:Key="Brush.Accent.Hover" Color="#DABE97" />
  <SolidColorBrush x:Key="Brush.Accent.Pressed" Color="#AB9070" />
  <SolidColorBrush x:Key="Brush.Accent.Foreground" Color="#221B12" />
  <SolidColorBrush x:Key="Brush.Accent.Subtle" Color="#2C2519" />

  <LinearGradientBrush x:Key="Brush.Accent.Surface" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#D4B88F" Offset="0" />
    <GradientStop Color="#B79B75" Offset="1" />
  </LinearGradientBrush>

  <!-- ============================ Controls ============================ -->

  <LinearGradientBrush x:Key="Brush.Control.Background" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#39332C" Offset="0" />
    <GradientStop Color="#302B25" Offset="1" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="Brush.Control.BackgroundHover" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#443D34" Offset="0" />
    <GradientStop Color="#39332C" Offset="1" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="Brush.Control.BackgroundPressed" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#211E19" Offset="0" />
    <GradientStop Color="#2B2721" Offset="1" />
  </LinearGradientBrush>

  <SolidColorBrush x:Key="Brush.Control.Border" Color="#423B32" />
  <SolidColorBrush x:Key="Brush.Control.BorderHover" Color="#6E6455" />
  <SolidColorBrush x:Key="Brush.Control.Foreground" Color="#EFEBE4" />
  <SolidColorBrush x:Key="Brush.Control.ForegroundDisabled" Color="#6B6355" />

  <SolidColorBrush x:Key="Brush.Focus" Color="#C9AC84" />

  <!-- ============================ Indicator LEDs ============================ -->

  <SolidColorBrush x:Key="Brush.Confidence.High" Color="#8BAE85" />
  <SolidColorBrush x:Key="Brush.Confidence.Medium" Color="#C9AC84" />
  <SolidColorBrush x:Key="Brush.Confidence.Low" Color="#C4855E" />
  <SolidColorBrush x:Key="Brush.Confidence.Unknown" Color="#7B7364" />

  <SolidColorBrush x:Key="Brush.Confidence.High.Background" Color="#232A20" />
  <SolidColorBrush x:Key="Brush.Confidence.Medium.Background" Color="#2C2519" />
  <SolidColorBrush x:Key="Brush.Confidence.Low.Background" Color="#2C2118" />
  <SolidColorBrush x:Key="Brush.Confidence.Unknown.Background" Color="#2E2A24" />

  <!-- ============================ Status ============================ -->

  <SolidColorBrush x:Key="Brush.Status.Error" Color="#D4816C" />
  <SolidColorBrush x:Key="Brush.Status.Error.Background" Color="#2E1F1A" />
  <SolidColorBrush x:Key="Brush.Status.Error.Border" Color="#57392F" />
  <SolidColorBrush x:Key="Brush.Status.Info" Color="#8AA2B0" />
  <SolidColorBrush x:Key="Brush.Status.Info.Background" Color="#212729" />

  <!-- ============================ Scrollbars ============================ -->

  <SolidColorBrush x:Key="Brush.Scrollbar.Track" Color="#00000000" />
  <SolidColorBrush x:Key="Brush.Scrollbar.Thumb" Color="#484036" />
  <SolidColorBrush x:Key="Brush.Scrollbar.ThumbHover" Color="#6E6455" />

  <!-- ============================ Window chrome ============================ -->

  <LinearGradientBrush x:Key="Brush.TitleBar.Background" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#2B2721" Offset="0" />
    <GradientStop Color="#201D19" Offset="1" />
  </LinearGradientBrush>

  <SolidColorBrush x:Key="Brush.Overlay.Scrim" Color="#D91B1815" />

</ResourceDictionary>
