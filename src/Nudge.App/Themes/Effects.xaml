<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    Soft shadows for the neumorphic surfaces. Each effect's Color is bound with DynamicResource to
    Color.Shadow, defined per palette in Colors.Dark.xaml / Colors.Light.xaml, so a theme swap
    re-tints every shadow along with everything else.

    A true two-shadow neumorphic look (a dark shadow on one corner, a light highlight on the
    opposite one) needs two stacked elements per surface. That is done only for Surface.Card, the
    one container prominent enough to be worth it (see Controls.xaml); everything else uses a
    single soft shadow, which still reads as "raised" against the low-contrast surfaces without the
    extra element per control.
  -->

  <DropShadowEffect x:Key="Effect.Card.Shadow"
                     Color="{DynamicResource Color.Shadow}"
                     Direction="315"
                     ShadowDepth="12"
                     BlurRadius="34"
                     Opacity="0.45"
                     RenderingBias="Performance" />

  <DropShadowEffect x:Key="Effect.Button.Shadow"
                     Color="{DynamicResource Color.Shadow}"
                     Direction="315"
                     ShadowDepth="5"
                     BlurRadius="16"
                     Opacity="0.38"
                     RenderingBias="Performance" />

  <!-- A smaller, tighter shadow for the pressed state - less depth, so the button reads as pushed in. -->
  <DropShadowEffect x:Key="Effect.Button.Shadow.Pressed"
                     Color="{DynamicResource Color.Shadow}"
                     Direction="315"
                     ShadowDepth="1"
                     BlurRadius="5"
                     Opacity="0.30"
                     RenderingBias="Performance" />

  <!-- The library grid's tile cards: a touch lighter than Effect.Card.Shadow since many tiles are
       ever on screen at once, but still clearly "raised" rather than flat. -->
  <DropShadowEffect x:Key="Effect.Tile.Shadow"
                     Color="{DynamicResource Color.Shadow}"
                     Direction="315"
                     ShadowDepth="7"
                     BlurRadius="20"
                     Opacity="0.38"
                     RenderingBias="Performance" />

  <!-- Used on recessed controls (the search box) to read as pressed into the surface rather than
       sitting flush with it - the same tight, close shadow a button gets on press, applied at rest
       instead of only on interaction. -->
  <DropShadowEffect x:Key="Effect.Inset.Shadow"
                     Color="{DynamicResource Color.Shadow}"
                     Direction="315"
                     ShadowDepth="1"
                     BlurRadius="6"
                     Opacity="0.32"
                     RenderingBias="Performance" />

</ResourceDictionary>
