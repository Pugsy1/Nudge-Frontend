<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    Light palette. Neutral grey, deliberately - every surface/text/control colour below has equal
    (or near-equal) R/G/B, so nothing reads as blue-tinted. Only Accent and the semantic colours
    (Confidence, Status) carry hue; everything else is monochrome. Defines exactly the same keys as
    Colors.Dark.xaml.

    If you add a key to one of these files you must add it to the other, or the missing theme will
    fail to resolve it at runtime.
  -->

  <!--
    Surfaces. Kept close in tone to the window background on purpose - a neumorphic surface reads
    as "raised" mainly through its soft shadow (see Effects.xaml), not through strong contrast.
  -->
  <SolidColorBrush x:Key="Brush.Window.Background" Color="#EBEBEB" />
  <SolidColorBrush x:Key="Brush.Surface.Background" Color="#EBEBEB" />
  <SolidColorBrush x:Key="Brush.Surface.BackgroundAlt" Color="#E2E2E2" />
  <SolidColorBrush x:Key="Brush.Surface.Border" Color="#D6D6D6" />

  <!-- The soft shadow colour used by every raised surface. Neutral mid-grey reads better than pure black on a light background. -->
  <Color x:Key="Color.Shadow">#A8A8A8</Color>

  <!-- A faint top-left rim light, glazed across a raised surface's border to suggest a light source. -->
  <LinearGradientBrush x:Key="Brush.Surface.EdgeHighlight" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#FFFFFF" Offset="0" />
    <GradientStop Color="#D8D8D8" Offset="1" />
  </LinearGradientBrush>

  <!-- Text -->
  <SolidColorBrush x:Key="Brush.Text.Primary" Color="#1C1C1C" />
  <SolidColorBrush x:Key="Brush.Text.Secondary" Color="#545454" />
  <SolidColorBrush x:Key="Brush.Text.Muted" Color="#7A7A7A" />

  <!-- Accent -->
  <SolidColorBrush x:Key="Brush.Accent" Color="#C4462F" />
  <SolidColorBrush x:Key="Brush.Accent.Hover" Color="#D8543C" />
  <SolidColorBrush x:Key="Brush.Accent.Pressed" Color="#A63924" />
  <SolidColorBrush x:Key="Brush.Accent.Foreground" Color="#FFFFFF" />
  <SolidColorBrush x:Key="Brush.Accent.Subtle" Color="#FBEDEA" />

  <!-- Controls. Close in tone to the surfaces around them - a raised look comes from the shadow, not contrast. -->
  <SolidColorBrush x:Key="Brush.Control.Background" Color="#EBEBEB" />
  <SolidColorBrush x:Key="Brush.Control.BackgroundHover" Color="#F2F2F2" />
  <SolidColorBrush x:Key="Brush.Control.BackgroundPressed" Color="#DCDCDC" />
  <SolidColorBrush x:Key="Brush.Control.Border" Color="#D4D4D4" />
  <SolidColorBrush x:Key="Brush.Control.BorderHover" Color="#A3A3A3" />
  <SolidColorBrush x:Key="Brush.Control.Foreground" Color="#1C1C1C" />
  <SolidColorBrush x:Key="Brush.Control.ForegroundDisabled" Color="#ABABAB" />

  <!-- Focus: the accent colour, rather than a separate blue - one signal colour for "the thing that
       matters right now" (primary actions and keyboard focus alike) instead of two competing hues. -->
  <SolidColorBrush x:Key="Brush.Focus" Color="#C4462F" />

  <!-- Confidence -->
  <SolidColorBrush x:Key="Brush.Confidence.High" Color="#237A48" />
  <SolidColorBrush x:Key="Brush.Confidence.Medium" Color="#9A6B10" />
  <SolidColorBrush x:Key="Brush.Confidence.Low" Color="#A85218" />
  <SolidColorBrush x:Key="Brush.Confidence.Unknown" Color="#6C6C6C" />

  <SolidColorBrush x:Key="Brush.Confidence.High.Background" Color="#E6F4EB" />
  <SolidColorBrush x:Key="Brush.Confidence.Medium.Background" Color="#FAF0DC" />
  <SolidColorBrush x:Key="Brush.Confidence.Low.Background" Color="#FBEBDF" />
  <SolidColorBrush x:Key="Brush.Confidence.Unknown.Background" Color="#EDEDED" />

  <!-- Status -->
  <SolidColorBrush x:Key="Brush.Status.Error" Color="#B3261E" />
  <SolidColorBrush x:Key="Brush.Status.Error.Background" Color="#FBEAE8" />
  <SolidColorBrush x:Key="Brush.Status.Error.Border" Color="#E8B4AF" />
  <SolidColorBrush x:Key="Brush.Status.Info" Color="#1F5FA8" />
  <SolidColorBrush x:Key="Brush.Status.Info.Background" Color="#E8F0FA" />

  <!-- Scrollbars -->
  <SolidColorBrush x:Key="Brush.Scrollbar.Track" Color="#EDEDED" />
  <SolidColorBrush x:Key="Brush.Scrollbar.Thumb" Color="#C9C9C9" />
  <SolidColorBrush x:Key="Brush.Scrollbar.ThumbHover" Color="#A3A3A3" />

  <!-- Custom window chrome -->
  <SolidColorBrush x:Key="Brush.TitleBar.Background" Color="#DDDDDD" />

  <!-- A dimming scrim over the grid while a table is launching, so the loading spinner reads as
       "something is happening" without hiding the grid entirely. -->
  <SolidColorBrush x:Key="Brush.Overlay.Scrim" Color="#CCF2F2F2" />

</ResourceDictionary>
