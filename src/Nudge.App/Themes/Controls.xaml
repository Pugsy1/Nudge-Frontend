<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    Control templates. WPF's stock controls look dated, so every control Nudge uses is templated
    here against the named colour, type and spacing resources.

    The shared material language: a raised control has a satin gradient fill, a diagonal bevel
    border (bright top-left, dark bottom-right) and a downward shadow. Pressing it inverts the
    gradient and tightens the shadow, so it reads as sinking toward its base. Recessed controls
    (text slots) use the inverted gradient at rest.
  -->

  <!-- ============================ Buttons ============================ -->

  <Style x:Key="Button.Base" TargetType="Button">
    <Setter Property="FontFamily" Value="{DynamicResource Font.Family.Primary}" />
    <Setter Property="FontSize" Value="{DynamicResource Font.Size.Body}" />
    <Setter Property="FontWeight" Value="{DynamicResource Font.Weight.Medium}" />
    <Setter Property="Padding" Value="{DynamicResource Padding.Button}" />
    <Setter Property="MinWidth" Value="{DynamicResource Size.MinButtonWidth}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Root"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{DynamicResource CornerRadius.M}">
            <ContentPresenter x:Name="Content"
                              Margin="{TemplateBinding Padding}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              RecognizesAccessKey="True" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.Focus}" />
              <Setter TargetName="Root" Property="BorderThickness" Value="{DynamicResource BorderThickness.Thin}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Root" Property="Opacity" Value="0.45" />
              <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- The single most important action on a screen: a lit brass cap. -->
  <Style x:Key="Button.Primary" TargetType="Button" BasedOn="{StaticResource Button.Base}">
    <Setter Property="Background" Value="{DynamicResource Brush.Accent.Surface}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Accent.Foreground}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Effect" Value="{DynamicResource Effect.Button.Shadow}" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{DynamicResource Brush.Accent.Hover}" />
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter Property="Background" Value="{DynamicResource Brush.Accent.Pressed}" />
        <Setter Property="Effect" Value="{DynamicResource Effect.Button.Shadow.Pressed}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- A satin panel cap: bevel border, soft shadow, sinks on press. -->
  <Style x:Key="Button.Secondary" TargetType="Button" BasedOn="{StaticResource Button.Base}">
    <Setter Property="Background" Value="{DynamicResource Brush.Control.Background}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Control.Foreground}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Surface.EdgeHighlight}" />
    <Setter Property="BorderThickness" Value="{DynamicResource BorderThickness.Thin}" />
    <Setter Property="Effect" Value="{DynamicResource Effect.Button.Shadow}" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{DynamicResource Brush.Control.BackgroundHover}" />
        <Setter Property="BorderBrush" Value="{DynamicResource Brush.Surface.RimLight}" />
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter Property="Background" Value="{DynamicResource Brush.Control.BackgroundPressed}" />
        <Setter Property="Effect" Value="{DynamicResource Effect.Button.Shadow.Pressed}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- Low-emphasis inline action. Flush with the page until hovered. -->
  <Style x:Key="Button.Subtle" TargetType="Button" BasedOn="{StaticResource Button.Base}">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="FontSize" Value="{DynamicResource Font.Size.Caption}" />
    <Setter Property="Padding" Value="{DynamicResource Padding.Badge}" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{DynamicResource Brush.Control.BackgroundHover}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- Icon-only, square-ish auxiliary action, e.g. the settings cog. -->
  <Style x:Key="Button.Icon" TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
    <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="Width" Value="{DynamicResource Size.IconButton}" />
    <Setter Property="Height" Value="{DynamicResource Size.IconButton}" />
    <Setter Property="Padding" Value="0" />
  </Style>

  <!-- ============================ Segmented switch (2D / VR) ============================ -->

  <!--
    A physical two-position selector: the whole control is a recessed slot, and the selected
    segment is a raised cap sitting inside it. Built from RadioButtons so exactly one is always
    active, with the group enforced by the usual GroupName.
  -->
  <Style x:Key="Segment" TargetType="RadioButton">
    <Setter Property="FontFamily" Value="{DynamicResource Font.Family.Primary}" />
    <Setter Property="FontSize" Value="{DynamicResource Font.Size.Caption}" />
    <Setter Property="FontWeight" Value="{DynamicResource Font.Weight.SemiBold}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Muted}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Padding" Value="18,6,18,6" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Border x:Name="Root"
                  Background="Transparent"
                  BorderBrush="Transparent"
                  BorderThickness="{DynamicResource BorderThickness.Thin}"
                  CornerRadius="{DynamicResource CornerRadius.Pill}">
            <ContentPresenter Margin="{TemplateBinding Padding}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
            </Trigger>
            <!-- Selected: the cap rises out of the slot, lit and bevelled. -->
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Control.Background}" />
              <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.Surface.EdgeHighlight}" />
              <Setter TargetName="Root" Property="Effect" Value="{DynamicResource Effect.Button.Shadow}" />
              <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Root" Property="Opacity" Value="0.45" />
              <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- The recessed housing the segments sit in. -->
  <Style x:Key="Segment.Track" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface.Recessed}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Surface.Border}" />
    <Setter Property="BorderThickness" Value="{DynamicResource BorderThickness.Thin}" />
    <Setter Property="CornerRadius" Value="{DynamicResource CornerRadius.Pill}" />
    <Setter Property="Padding" Value="{DynamicResource Inset.XS}" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
  </Style>

  <!-- ============================ Toggle switch (settings) ============================ -->

  <!-- A physical rocker: a recessed track with a raised knob that slides between two positions. -->
  <Style x:Key="Switch" TargetType="CheckBox">
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <Grid Background="Transparent">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ContentPresenter Grid.Column="0"
                              VerticalAlignment="Center"
                              HorizontalAlignment="Left" />

            <Border x:Name="Track"
                    Grid.Column="1"
                    Width="40" Height="22"
                    Margin="{DynamicResource Gap.Right.S}"
                    Background="{DynamicResource Brush.Surface.Recessed}"
                    BorderBrush="{DynamicResource Brush.Surface.Border}"
                    BorderThickness="{DynamicResource BorderThickness.Thin}"
                    CornerRadius="{DynamicResource CornerRadius.Pill}">
              <Border x:Name="Knob"
                      Width="16" Height="16"
                      HorizontalAlignment="Left"
                      Margin="2,0,0,0"
                      Background="{DynamicResource Brush.Control.Background}"
                      BorderBrush="{DynamicResource Brush.Surface.EdgeHighlight}"
                      BorderThickness="{DynamicResource BorderThickness.Thin}"
                      CornerRadius="{DynamicResource CornerRadius.Pill}"
                      Effect="{DynamicResource Effect.Button.Shadow.Pressed}" />
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
              <Setter TargetName="Knob" Property="Margin" Value="0,0,2,0" />
              <Setter TargetName="Knob" Property="Background" Value="{DynamicResource Brush.Accent.Surface}" />
              <Setter TargetName="Knob" Property="BorderBrush" Value="Transparent" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource Brush.Control.BorderHover}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45" />
              <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============================ Text input ============================ -->

  <!-- A slot milled into the panel: inverted sheen, tight inner shadow, no border until focused. -->
  <Style x:Key="TextBox.Search" TargetType="TextBox">
    <Setter Property="FontFamily" Value="{DynamicResource Font.Family.Primary}" />
    <Setter Property="FontSize" Value="{DynamicResource Font.Size.Body}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Control.Foreground}" />
    <Setter Property="CaretBrush" Value="{DynamicResource Brush.Accent}" />
    <Setter Property="Background" Value="{DynamicResource Brush.Surface.Recessed}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Surface.Border}" />
    <Setter Property="BorderThickness" Value="{DynamicResource BorderThickness.Thin}" />
    <Setter Property="Padding" Value="{DynamicResource Padding.SearchBox}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Effect" Value="{DynamicResource Effect.Inset.Shadow}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="Root"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{DynamicResource CornerRadius.Pill}">
            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.Focus}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============================ Dropdown ============================ -->

  <Style x:Key="ComboBox.Item" TargetType="ComboBoxItem">
    <Setter Property="FontFamily" Value="{DynamicResource Font.Family.Primary}" />
    <Setter Property="FontSize" Value="{DynamicResource Font.Size.Body}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
    <Setter Property="Padding" Value="14,9,14,9" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBoxItem">
          <Border x:Name="Root"
                  Background="Transparent"
                  CornerRadius="{DynamicResource CornerRadius.S}"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Control.BackgroundHover}" />
              <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Accent.Subtle}" />
              <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="ComboBox.Standard" TargetType="ComboBox">
    <Setter Property="FontFamily" Value="{DynamicResource Font.Family.Primary}" />
    <Setter Property="FontSize" Value="{DynamicResource Font.Size.Body}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Control.Foreground}" />
    <Setter Property="Background" Value="{DynamicResource Brush.Control.Background}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Surface.EdgeHighlight}" />
    <Setter Property="BorderThickness" Value="{DynamicResource BorderThickness.Thin}" />
    <Setter Property="Padding" Value="{DynamicResource Padding.Button}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="ItemContainerStyle" Value="{StaticResource ComboBox.Item}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid>
            <!-- The closed control: a satin cap, same material as Button.Secondary. -->
            <ToggleButton x:Name="PART_Toggle"
                          Focusable="False"
                          ClickMode="Press"
                          Cursor="Hand"
                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
              <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                  <Border x:Name="Cap"
                          Background="{DynamicResource Brush.Control.Background}"
                          BorderBrush="{DynamicResource Brush.Surface.EdgeHighlight}"
                          BorderThickness="{DynamicResource BorderThickness.Thin}"
                          CornerRadius="{DynamicResource CornerRadius.M}"
                          Effect="{DynamicResource Effect.Button.Shadow}">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <ContentPresenter Grid.Column="0"
                                        Margin="{DynamicResource Padding.Button}"
                                        VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1"
                                 Text="&#xE70D;"
                                 FontFamily="Segoe MDL2 Assets"
                                 FontSize="9"
                                 Margin="0,0,14,0"
                                 VerticalAlignment="Center"
                                 Foreground="{DynamicResource Brush.Text.Muted}" />
                    </Grid>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="Cap" Property="Background" Value="{DynamicResource Brush.Control.BackgroundHover}" />
                      <Setter TargetName="Cap" Property="BorderBrush" Value="{DynamicResource Brush.Surface.RimLight}" />
                    </Trigger>
                    <Trigger Property="IsChecked" Value="True">
                      <Setter TargetName="Cap" Property="Background" Value="{DynamicResource Brush.Control.BackgroundPressed}" />
                      <Setter TargetName="Cap" Property="Effect" Value="{DynamicResource Effect.Button.Shadow.Pressed}" />
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </ToggleButton.Template>

              <!-- Bound directly to SelectedItem.Label rather than SelectionBoxItem/Template:
                   ComboBox only auto-generates a SelectionBoxItemTemplate from DisplayMemberPath
                   when using its own default template, not a fully custom one like this, so
                   SelectionBoxItem was rendering the OptionItem record's ToString() instead. -->
              <TextBlock Text="{Binding SelectedItem.Label, RelativeSource={RelativeSource TemplatedParent}}"
                         Foreground="{DynamicResource Brush.Control.Foreground}"
                         VerticalAlignment="Center" />
            </ToggleButton>

            <!-- The open list: a floating panel, well above the page. -->
            <Popup x:Name="PART_Popup"
                   IsOpen="{TemplateBinding IsDropDownOpen}"
                   Placement="Bottom"
                   VerticalOffset="6"
                   AllowsTransparency="True"
                   PopupAnimation="Fade"
                   Focusable="False">
              <Border MinWidth="{Binding ActualWidth, ElementName=PART_Toggle}"
                      Margin="10"
                      Background="{DynamicResource Brush.Surface.BackgroundAlt}"
                      BorderBrush="{DynamicResource Brush.Surface.EdgeHighlight}"
                      BorderThickness="{DynamicResource BorderThickness.Thin}"
                      CornerRadius="{DynamicResource CornerRadius.M}"
                      Padding="{DynamicResource Inset.XS}"
                      Effect="{DynamicResource Effect.Flyout.Shadow}">
                <ScrollViewer MaxHeight="280">
                  <ItemsPresenter />
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45" />
              <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============================ Title bar (custom window chrome) ============================ -->

  <Style x:Key="TitleBarButton" TargetType="Button">
    <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
    <Setter Property="FontSize" Value="10" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Muted}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Width" Value="{DynamicResource Size.TitleBarButton.Width}" />
    <Setter Property="Height" Value="{DynamicResource Size.TitleBar.Height}" />
    <Setter Property="Cursor" Value="Arrow" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Root" Background="{TemplateBinding Background}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Control.BackgroundHover}" />
              <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Close gets a distinct warning hover; every other caption button uses the neutral one. -->
  <Style x:Key="TitleBarButton.Close" TargetType="Button" BasedOn="{StaticResource TitleBarButton}">
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{DynamicResource Brush.Status.Error}" />
        <Setter Property="Foreground" Value="#FFFFFF" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- ============================ Scrollbars ============================ -->

  <Style x:Key="ScrollBar.Thumb" TargetType="Thumb">
    <Setter Property="OverridesDefaultStyle" Value="True" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Border x:Name="Root"
                  Background="{DynamicResource Brush.Scrollbar.Thumb}"
                  CornerRadius="{DynamicResource CornerRadius.Scrollbar}" />
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Root" Property="Background"
                      Value="{DynamicResource Brush.Scrollbar.ThumbHover}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ScrollBar">
    <Setter Property="Background" Value="{DynamicResource Brush.Scrollbar.Track}" />
    <Setter Property="Width" Value="{DynamicResource Size.Scrollbar}" />
    <Setter Property="Margin" Value="{DynamicResource Margin.Scrollbar}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Border Background="{TemplateBinding Background}">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.Thumb>
                <Thumb Style="{StaticResource ScrollBar.Thumb}" />
              </Track.Thumb>
              <!-- Stock repeat buttons are hidden: a plain thumb reads better and behaves the same. -->
              <Track.IncreaseRepeatButton>
                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" />
              </Track.IncreaseRepeatButton>
              <Track.DecreaseRepeatButton>
                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" />
              </Track.DecreaseRepeatButton>
            </Track>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
              <Setter Property="Width" Value="Auto" />
              <Setter Property="Height" Value="{DynamicResource Size.Scrollbar}" />
              <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ScrollViewer">
    <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
    <Setter Property="Focusable" Value="False" />
  </Style>

  <!-- ============================ Surfaces ============================ -->

  <Style x:Key="Surface.Card" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface.Background}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Surface.EdgeHighlight}" />
    <Setter Property="BorderThickness" Value="{DynamicResource BorderThickness.Thin}" />
    <Setter Property="CornerRadius" Value="{DynamicResource CornerRadius.L}" />
    <Setter Property="Padding" Value="{DynamicResource Padding.Card}" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Effect" Value="{DynamicResource Effect.Card.Shadow}" />
  </Style>

  <!-- A frosted panel that lets the ambient ground glow read through it. -->
  <Style x:Key="Surface.Glass" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface.Glass}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Surface.EdgeHighlight}" />
    <Setter Property="BorderThickness" Value="{DynamicResource BorderThickness.Thin}" />
    <Setter Property="CornerRadius" Value="{DynamicResource CornerRadius.L}" />
    <Setter Property="Padding" Value="{DynamicResource Padding.Card}" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Effect" Value="{DynamicResource Effect.Card.Shadow}" />
  </Style>

  <Style x:Key="Surface.Inset" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface.Recessed}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Surface.Border}" />
    <Setter Property="BorderThickness" Value="{DynamicResource BorderThickness.Thin}" />
    <Setter Property="CornerRadius" Value="{DynamicResource CornerRadius.M}" />
    <Setter Property="Padding" Value="{DynamicResource Padding.Card}" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
  </Style>

  <Style x:Key="Surface.Error" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource Brush.Status.Error.Background}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Status.Error.Border}" />
    <Setter Property="BorderThickness" Value="{DynamicResource BorderThickness.Thin}" />
    <Setter Property="CornerRadius" Value="{DynamicResource CornerRadius.M}" />
    <Setter Property="Padding" Value="{DynamicResource Padding.Card}" />
  </Style>

  <Style x:Key="Badge" TargetType="Border">
    <Setter Property="CornerRadius" Value="{DynamicResource CornerRadius.S}" />
    <Setter Property="Padding" Value="{DynamicResource Padding.Badge}" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Background" Value="{DynamicResource Brush.Surface.BackgroundAlt}" />
  </Style>

  <!-- ============================ Progress ============================ -->

  <Style x:Key="Progress.Indeterminate" TargetType="ProgressBar">
    <Setter Property="Height" Value="{DynamicResource Space.XS}" />
    <Setter Property="IsIndeterminate" Value="True" />
    <Setter Property="Background" Value="{DynamicResource Brush.Surface.Recessed}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>

</ResourceDictionary>
