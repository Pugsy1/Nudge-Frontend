<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:converters="clr-namespace:Nudge.App.Converters"
                    xmlns:controls="clr-namespace:Nudge.App.Controls">

  <converters:SliderFillWidthConverter x:Key="SliderFillWidthConverter" />

  <!--
    Control templates. WPF's stock controls look dated, so every control Nudge uses is templated
    here against the named colour, type and spacing resources.

    The shared material language: a raised control has a satin gradient fill, a diagonal bevel
    border (bright top-left, dark bottom-right) and a downward shadow. Pressing it inverts the
    gradient and tightens the shadow, so it reads as sinking toward its base. Recessed controls
    (text slots) use the inverted gradient at rest.
  -->

  <!-- ============================ Buttons ============================ -->

  <Style x:Key="Button.Base" TargetType="Button">
    <Setter Property="FontFamily" Value="{DynamicResource Font.Family.Primary}" />
    <Setter Property="FontSize" Value="{DynamicResource Font.Size.Body}" />
    <Setter Property="FontWeight" Value="{DynamicResource Font.Weight.Medium}" />
    <Setter Property="Padding" Value="{DynamicResource Padding.Button}" />
    <Setter Property="MinWidth" Value="{DynamicResource Size.MinButtonWidth}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <!-- CornerRadius.Button, not .Pill: these are wide text buttons, and a fully-round
               radius stretches into a lozenge rather than reading as round. Square icon buttons
               (Button.Icon, TileOverlayButton) keep .Pill and stay true circles. -->
          <Border x:Name="Root"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{DynamicResource CornerRadius.Button}">
            <ContentPresenter x:Name="Content"
                              Margin="{TemplateBinding Padding}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              RecognizesAccessKey="True" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.Focus}" />
              <Setter TargetName="Root" Property="BorderThickness" Value="{DynamicResource BorderThickness.Thin}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Root" Property="Opacity" Value="0.45" />
              <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- The single most important action on a screen: a lit brass cap. -->
  <Style x:Key="Button.Primary" TargetType="Button" BasedOn="{StaticResource Button.Base}">
    <Setter Property="Background" Value="{DynamicResource Brush.Accent.Surface}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Accent.Foreground}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Effect" Value="{DynamicResource Effect.Button.Shadow}" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{DynamicResource Brush.Accent.Hover}" />
        <Setter Property="Effect" Value="{DynamicResource Effect.Button.Shadow.Hover}" />
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter Property="Background" Value="{DynamicResource Brush.Accent.Pressed}" />
        <Setter Property="Effect" Value="{DynamicResource Effect.Button.Shadow.Pressed}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- A flat, borderless pill: the shape is carried entirely by the soft shadow now, not by a
       bevel or a uniform-weight outline - matching the clean-neumorphic reference boards, where no
       resting control shows a visible edge at all. Shadow is present at rest (not just on hover),
       since that's what makes it read as a raised physical cap sitting on the page rather than a
       flat rectangle waiting to be touched. -->
  <Style x:Key="Button.Secondary" TargetType="Button" BasedOn="{StaticResource Button.Base}">
    <Setter Property="Background" Value="{DynamicResource Brush.Control.Background}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Control.Foreground}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Effect" Value="{DynamicResource Effect.Button.Shadow}" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{DynamicResource Brush.Control.BackgroundHover}" />
        <Setter Property="Effect" Value="{DynamicResource Effect.Button.Shadow.Hover}" />
      </Trigger>
      <Trigger Property="IsPressed" Value="True">
        <Setter Property="Background" Value="{DynamicResource Brush.Control.BackgroundPressed}" />
        <Setter Property="Effect" Value="{DynamicResource Effect.Button.Shadow.Pressed}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- Low-emphasis inline action. Flush with the page until hovered. -->
  <Style x:Key="Button.Subtle" TargetType="Button" BasedOn="{StaticResource Button.Base}">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="FontSize" Value="{DynamicResource Font.Size.Caption}" />
    <Setter Property="Padding" Value="{DynamicResource Padding.Badge}" />
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{DynamicResource Brush.Control.BackgroundHover}" />
        <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- Icon-only, square auxiliary action, e.g. the settings cog. -->
  <Style x:Key="Button.Icon" TargetType="Button" BasedOn="{StaticResource Button.Secondary}">
    <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
    <Setter Property="FontSize" Value="15" />
    <Setter Property="MinWidth" Value="0" />
    <Setter Property="Width" Value="{DynamicResource Size.IconButton}" />
    <Setter Property="Height" Value="{DynamicResource Size.IconButton}" />
    <Setter Property="Padding" Value="0" />
    <!-- Restates Button.Base's template purely to swap CornerRadius.Button back to .Pill: this
         one is square, so a fully-round radius makes it a true circle rather than the rounded
         rectangle the shared wide-button template would otherwise give it. Background/Effect still
         come from Button.Secondary's Style.Triggers via these TemplateBindings. -->
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Root"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{DynamicResource CornerRadius.Pill}">
            <ContentPresenter HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              RecognizesAccessKey="True" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.Focus}" />
              <Setter TargetName="Root" Property="BorderThickness" Value="{DynamicResource BorderThickness.Thin}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Root" Property="Opacity" Value="0.45" />
              <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- A small round glass button that floats over artwork - the favourite star and per-table
       customize menu both use this. Shared here so the two always look and behave identically
       rather than each tile template hand-rolling its own copy of the same hover/press states. -->
  <Style x:Key="TileOverlayButton" TargetType="Button">
    <Setter Property="Width" Value="30" />
    <Setter Property="Height" Value="30" />
    <Setter Property="Margin" Value="8" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="OverlayRoot"
                  Background="{DynamicResource Brush.Surface.Glass}"
                  CornerRadius="{DynamicResource CornerRadius.Pill}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="OverlayRoot" Property="Background" Value="{DynamicResource Brush.Control.BackgroundHover}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============================ Segmented switch (2D / VR) ============================ -->

  <!--
    A physical two-position selector: the whole control is a recessed slot, and the selected
    segment is a raised cap sitting inside it. Built from RadioButtons so exactly one is always
    active, with the group enforced by the usual GroupName.
  -->
  <Style x:Key="Segment" TargetType="RadioButton">
    <Setter Property="FontFamily" Value="{DynamicResource Font.Family.Primary}" />
    <Setter Property="FontSize" Value="{DynamicResource Font.Size.Caption}" />
    <Setter Property="FontWeight" Value="{DynamicResource Font.Weight.SemiBold}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Muted}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Padding" Value="18,6,18,6" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Border x:Name="Root"
                  Background="Transparent"
                  BorderBrush="Transparent"
                  BorderThickness="{DynamicResource BorderThickness.Thin}"
                  CornerRadius="7">
            <ContentPresenter Margin="{TemplateBinding Padding}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
            </Trigger>
            <!-- Selected: the cap rises out of the slot, carried purely by a soft shadow - no
                 visible border, matching the borderless clean-neumorphic look everywhere else. -->
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Control.Background}" />
              <Setter TargetName="Root" Property="Effect" Value="{DynamicResource Effect.Button.Shadow}" />
              <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter TargetName="Root" Property="Opacity" Value="0.45" />
              <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- The recessed housing the segments sit in - borderless, the same "shadow does the work,
       not an outline" rule as everything else in the clean-neumorphic pass. Padding stays at
       Inset.XS - it's part of the track/cap proportions tuned in the previous session (see
       LibraryView.xaml's Segment.Track usage and the aspect-ratio note in AGENTS.md's handoff) -
       so the sliding cap's own shadow (Effect.Button.Shadow) was sized down in Effects.xaml to fit
       this space instead of the other way around. -->
  <Style x:Key="Segment.Track" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface.Recessed}" />
    <Setter Property="BorderThickness" Value="0" />
    <!-- A rounded rectangle rather than a full stadium, matching the settings switch and the
         buttons: at 96x32 a fully-pilled track was the most visibly "stretched oval" shape in the
         header. -->
    <Setter Property="CornerRadius" Value="10" />
    <Setter Property="Padding" Value="{DynamicResource Inset.XS}" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
  </Style>

  <!-- ============================ Toggle switch (settings) ============================ -->

  <!-- A physical rocker: a recessed track with a raised knob that slides between two positions. -->
  <Style x:Key="Switch" TargetType="CheckBox">
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="CheckBox">
          <Grid Background="Transparent">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ContentPresenter Grid.Column="0"
                              VerticalAlignment="Center"
                              HorizontalAlignment="Left" />

            <!-- 46x26 with a rounded-rectangle track, not 52x28 fully-pilled: at nearly 2:1 the old
                 proportions plus a full stadium radius read as a stretched oval. Squaring the track
                 off (and squaring the knob to match) keeps the switch obviously a switch while
                 sitting in the same visual family as the rounded-rectangle buttons and inputs. -->
            <Border x:Name="Track"
                    Grid.Column="1"
                    Width="46" Height="26"
                    Margin="{DynamicResource Gap.Right.S}"
                    Background="{DynamicResource Brush.Surface.Recessed}"
                    BorderThickness="0"
                    CornerRadius="9">
              <Border x:Name="Knob"
                      Width="20" Height="20"
                      HorizontalAlignment="Left"
                      Margin="3,0,0,0"
                      Background="{DynamicResource Brush.Control.Background}"
                      BorderThickness="0"
                      CornerRadius="7"
                      Effect="{DynamicResource Effect.Button.Shadow}" />
            </Border>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
              <Setter TargetName="Knob" Property="Margin" Value="0,0,3,0" />
              <Setter TargetName="Knob" Property="Background" Value="{DynamicResource Brush.Accent.Surface}" />
            </Trigger>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Knob" Property="Effect" Value="{DynamicResource Effect.Button.Shadow.Hover}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45" />
              <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============================ Text input ============================ -->

  <!-- A slot milled into the panel: inverted sheen, tight inner shadow, no border until focused. -->
  <Style x:Key="TextBox.Search" TargetType="TextBox">
    <Setter Property="FontFamily" Value="{DynamicResource Font.Family.Primary}" />
    <Setter Property="FontSize" Value="{DynamicResource Font.Size.Body}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Control.Foreground}" />
    <Setter Property="CaretBrush" Value="{DynamicResource Brush.Accent}" />
    <Setter Property="Background" Value="{DynamicResource Brush.Surface.Recessed}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="{DynamicResource Padding.SearchBox}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Effect" Value="{DynamicResource Effect.Inset.Shadow}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="Root"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{DynamicResource CornerRadius.Button}">
            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.Focus}" />
              <Setter TargetName="Root" Property="BorderThickness" Value="{DynamicResource BorderThickness.Thin}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- A recessed slot for freeform, multi-line text (the table customization page's description and
       how-to-play fields) - the same milled-slot material as TextBox.Search, just a rounded
       rectangle rather than a pill (a stadium shape reads oddly once a box is tall enough to hold
       several lines) and top-aligned rather than vertically centred. -->
  <Style x:Key="TextBox.MultiLine" TargetType="TextBox">
    <Setter Property="FontFamily" Value="{DynamicResource Font.Family.Primary}" />
    <Setter Property="FontSize" Value="{DynamicResource Font.Size.Body}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Control.Foreground}" />
    <Setter Property="CaretBrush" Value="{DynamicResource Brush.Accent}" />
    <Setter Property="Background" Value="{DynamicResource Brush.Surface.Recessed}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="{DynamicResource Inset.M}" />
    <Setter Property="TextWrapping" Value="Wrap" />
    <Setter Property="AcceptsReturn" Value="True" />
    <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
    <Setter Property="VerticalContentAlignment" Value="Top" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Effect" Value="{DynamicResource Effect.Inset.Shadow}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="Root"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{DynamicResource CornerRadius.M}">
            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.Focus}" />
              <Setter TargetName="Root" Property="BorderThickness" Value="{DynamicResource BorderThickness.Thin}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- A single-line counterpart to TextBox.MultiLine - same recessed-slot material and corner
       radius, just vertically centred and capped to one line, for short fields like the table
       customization page's name/author/date overrides. -->
  <Style x:Key="TextBox.SingleLine" TargetType="TextBox">
    <Setter Property="FontFamily" Value="{DynamicResource Font.Family.Primary}" />
    <Setter Property="FontSize" Value="{DynamicResource Font.Size.Body}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Control.Foreground}" />
    <Setter Property="CaretBrush" Value="{DynamicResource Brush.Accent}" />
    <Setter Property="Background" Value="{DynamicResource Brush.Surface.Recessed}" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="{DynamicResource Inset.M}" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Effect" Value="{DynamicResource Effect.Inset.Shadow}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="TextBox">
          <Border x:Name="Root"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="{DynamicResource CornerRadius.M}">
            <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsKeyboardFocused" Value="True">
              <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource Brush.Focus}" />
              <Setter TargetName="Root" Property="BorderThickness" Value="{DynamicResource BorderThickness.Thin}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============================ Dropdown ============================ -->

  <Style x:Key="ComboBox.Item" TargetType="ComboBoxItem">
    <Setter Property="FontFamily" Value="{DynamicResource Font.Family.Primary}" />
    <Setter Property="FontSize" Value="{DynamicResource Font.Size.Body}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
    <Setter Property="Padding" Value="14,9,14,9" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBoxItem">
          <Border x:Name="Root"
                  Background="Transparent"
                  CornerRadius="{DynamicResource CornerRadius.S}"
                  Padding="{TemplateBinding Padding}">
            <ContentPresenter VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Control.BackgroundHover}" />
              <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Accent.Subtle}" />
              <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="ComboBox.Standard" TargetType="ComboBox">
    <Setter Property="FontFamily" Value="{DynamicResource Font.Family.Primary}" />
    <Setter Property="FontSize" Value="{DynamicResource Font.Size.Body}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Control.Foreground}" />
    <Setter Property="Background" Value="{DynamicResource Brush.Control.Background}" />
    <!-- Borderless, like every other control in the clean-neumorphic pass - the closed cap's own
         soft shadow (set on the template's Cap Border below) is what reads as its raised edge. -->
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="{DynamicResource Padding.Button}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="ItemContainerStyle" Value="{StaticResource ComboBox.Item}" />
    <!-- Opens already scrolled to whichever item is selected, the way a real ComboBox does by
         default - see ComboBoxBehavior's own remarks for why this fully custom template needs it
         set explicitly. -->
    <Setter Property="controls:ComboBoxBehavior.ScrollSelectedIntoViewOnOpen" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ComboBox">
          <Grid>
            <!-- The closed control: a satin cap, same material as Button.Secondary. -->
            <ToggleButton x:Name="PART_Toggle"
                          Focusable="False"
                          ClickMode="Press"
                          Cursor="Hand"
                          IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
              <ToggleButton.Template>
                <ControlTemplate TargetType="ToggleButton">
                  <!-- Borderless pill, shadow carries the raised edge at rest - same rule as every
                       other control in the clean-neumorphic pass. -->
                  <Border x:Name="Cap"
                          Background="{DynamicResource Brush.Control.Background}"
                          BorderThickness="0"
                          CornerRadius="{DynamicResource CornerRadius.Button}"
                          Effect="{DynamicResource Effect.Button.Shadow}">
                    <Grid>
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                      </Grid.ColumnDefinitions>
                      <ContentPresenter Grid.Column="0"
                                        Margin="{DynamicResource Padding.Button}"
                                        VerticalAlignment="Center" />
                      <TextBlock Grid.Column="1"
                                 Text="&#xE70D;"
                                 FontFamily="Segoe MDL2 Assets"
                                 FontSize="9"
                                 Margin="0,0,14,0"
                                 VerticalAlignment="Center"
                                 Foreground="{DynamicResource Brush.Text.Muted}" />
                    </Grid>
                  </Border>
                  <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                      <Setter TargetName="Cap" Property="Background" Value="{DynamicResource Brush.Control.BackgroundHover}" />
                      <Setter TargetName="Cap" Property="Effect" Value="{DynamicResource Effect.Button.Shadow.Hover}" />
                    </Trigger>
                    <Trigger Property="IsChecked" Value="True">
                      <Setter TargetName="Cap" Property="Background" Value="{DynamicResource Brush.Control.BackgroundPressed}" />
                      <Setter TargetName="Cap" Property="Effect" Value="{DynamicResource Effect.Button.Shadow.Pressed}" />
                    </Trigger>
                  </ControlTemplate.Triggers>
                </ControlTemplate>
              </ToggleButton.Template>

              <!-- Bound directly to SelectedItem.FullLabel rather than SelectionBoxItem/Template:
                   ComboBox only auto-generates a SelectionBoxItemTemplate from DisplayMemberPath
                   when using its own default template, not a fully custom one like this, so
                   SelectionBoxItem was rendering the OptionItem record's ToString() instead.
                   FullLabel (not the plain Label the open list's items show) is what includes an
                   option's category, e.g. "Dark — Jade" - once the dropdown is collapsed there's no
                   group header left to supply that context the way the open, grouped list has. For
                   an option with no category (Sort, Layout) FullLabel is just Label, unchanged. -->
              <TextBlock Text="{Binding SelectedItem.FullLabel, RelativeSource={RelativeSource TemplatedParent}}"
                         Foreground="{DynamicResource Brush.Control.Foreground}"
                         VerticalAlignment="Center" />
            </ToggleButton>

            <!-- The open list: a floating panel, well above the page. -->
            <Popup x:Name="PART_Popup"
                   IsOpen="{TemplateBinding IsDropDownOpen}"
                   Placement="Bottom"
                   VerticalOffset="6"
                   AllowsTransparency="True"
                   PopupAnimation="Fade"
                   Focusable="False">
              <!-- A Popup's transparent host window is sized to exactly fit this Border's own
                   DesiredSize, Margin included - so this Margin has to be at least as big as
                   Effect.Flyout.Shadow's own blur spread, or the shadow hits that window edge and
                   hard-clips instead of fading out (see the note in Effects.xaml). -->
              <Border MinWidth="{Binding ActualWidth, ElementName=PART_Toggle}"
                      Margin="20"
                      Background="{DynamicResource Brush.Surface.BackgroundAlt}"
                      BorderThickness="0"
                      CornerRadius="{DynamicResource CornerRadius.M}"
                      Padding="{DynamicResource Inset.XS}"
                      Effect="{DynamicResource Effect.Flyout.Shadow}">
                <!-- CanContentScroll=False switches the mouse wheel (and drag) from the default
                     logical, per-item scrolling - which snaps a whole ComboBoxItem at a time and is
                     what actually read as "not smooth" - to ordinary pixel-based scrolling, the same
                     kind every other scrollable surface in the app already uses. -->
                <ScrollViewer MaxHeight="280" CanContentScroll="False">
                  <ScrollViewer.Resources>
                    <!-- A visible groove, not the app-wide scrollbar's fully transparent track - a
                         short-lived popup benefits from showing the whole scrollable range at a
                         glance, unlike the grid/list's own scrollbar, which stays in view the whole
                         time you're already looking at it and doesn't need that extra context. The
                         thumb itself is wider than the 4px app default (Size.Scrollbar), fully
                         pill-rounded rather than the barely-rounded 2px corner every other scrollbar
                         uses, and eases its own colour and width in on hover instead of snapping -
                         all in service of a scrollbar that's actually pleasant to grab and drag in
                         the moment you're looking right at it, not just functional. -->
                    <Style x:Key="ComboBoxPopup.ScrollBar.Thumb" TargetType="Thumb">
                      <Setter Property="OverridesDefaultStyle" Value="True" />
                      <Setter Property="IsTabStop" Value="False" />
                      <Setter Property="Template">
                        <Setter.Value>
                          <ControlTemplate TargetType="Thumb">
                            <Grid>
                              <!-- Swaps to a different DynamicResource brush entirely on hover (the
                                   existing app-wide thumb's own approach) rather than animating a
                                   Color in place - the resource here is a shared instance, and
                                   in-place animation would either mutate every other use of that same
                                   brush at once or throw outright if it happens to be frozen. The
                                   width grow is genuinely animated since ScaleTransform below is this
                                   Thumb's own private instance, not shared with anything. -->
                              <Border x:Name="Root"
                                      Width="6"
                                      HorizontalAlignment="Center"
                                      Background="{DynamicResource Brush.Scrollbar.Thumb}"
                                      CornerRadius="{DynamicResource CornerRadius.Pill}"
                                      RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                  <ScaleTransform x:Name="Grow" ScaleX="1" />
                                </Border.RenderTransform>
                              </Border>
                            </Grid>
                            <ControlTemplate.Triggers>
                              <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Scrollbar.ThumbHover}" />
                                <Trigger.EnterActions>
                                  <BeginStoryboard>
                                    <Storyboard>
                                      <DoubleAnimation Storyboard.TargetName="Grow" Storyboard.TargetProperty="ScaleX"
                                                        To="1.4" Duration="{StaticResource Duration.Hover}" />
                                    </Storyboard>
                                  </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                  <BeginStoryboard>
                                    <Storyboard>
                                      <DoubleAnimation Storyboard.TargetName="Grow" Storyboard.TargetProperty="ScaleX"
                                                        To="1" Duration="{StaticResource Duration.Hover}" />
                                    </Storyboard>
                                  </BeginStoryboard>
                                </Trigger.ExitActions>
                              </Trigger>
                            </ControlTemplate.Triggers>
                          </ControlTemplate>
                        </Setter.Value>
                      </Setter>
                    </Style>
                    <!-- Defines its own complete Template rather than BasedOn-ing the app-wide
                         ScrollBar style: a Setter's {StaticResource ...} inside a ControlTemplate
                         resolves against the scope where that ControlTemplate is LEXICALLY
                         declared, not wherever the resulting Style is later applied. The app-wide
                         style's Template (declared far below, at the ResourceDictionary's own root)
                         references "ScrollBar.Thumb" from ITS OWN scope, so basing this Style on
                         that one and only overriding Width/Margin/Background - the previous
                         approach - could never actually swap in the pill-shaped Thumb above no
                         matter what key it was given; the inherited Template's Thumb reference was
                         already resolved before this Style ever entered the picture. -->
                    <Style TargetType="ScrollBar">
                      <Setter Property="Width" Value="10" />
                      <Setter Property="Margin" Value="0,4,2,4" />
                      <Setter Property="Background" Value="{DynamicResource Brush.Surface.Recessed}" />
                      <Setter Property="Template">
                        <Setter.Value>
                          <ControlTemplate TargetType="ScrollBar">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="{DynamicResource CornerRadius.Pill}">
                              <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                  <Thumb Style="{StaticResource ComboBoxPopup.ScrollBar.Thumb}" />
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                  <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" />
                                </Track.IncreaseRepeatButton>
                                <Track.DecreaseRepeatButton>
                                  <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" />
                                </Track.DecreaseRepeatButton>
                              </Track>
                            </Border>
                          </ControlTemplate>
                        </Setter.Value>
                      </Setter>
                    </Style>
                  </ScrollViewer.Resources>
                  <ItemsPresenter />
                </ScrollViewer>
              </Border>
            </Popup>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45" />
              <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============================ Title bar (custom window chrome) ============================ -->

  <Style x:Key="TitleBarButton" TargetType="Button">
    <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
    <Setter Property="FontSize" Value="10" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Muted}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Width" Value="{DynamicResource Size.TitleBarButton.Width}" />
    <Setter Property="Height" Value="{DynamicResource Size.TitleBar.Height}" />
    <Setter Property="Cursor" Value="Arrow" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Root" Background="{TemplateBinding Background}">
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{DynamicResource Brush.Control.BackgroundHover}" />
              <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- Close gets a distinct warning hover; every other caption button uses the neutral one. -->
  <Style x:Key="TitleBarButton.Close" TargetType="Button" BasedOn="{StaticResource TitleBarButton}">
    <Style.Triggers>
      <Trigger Property="IsMouseOver" Value="True">
        <Setter Property="Background" Value="{DynamicResource Brush.Status.Error}" />
        <Setter Property="Foreground" Value="#FFFFFF" />
      </Trigger>
    </Style.Triggers>
  </Style>

  <!-- ============================ Scrollbars ============================ -->

  <Style x:Key="ScrollBar.Thumb" TargetType="Thumb">
    <Setter Property="OverridesDefaultStyle" Value="True" />
    <Setter Property="IsTabStop" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Thumb">
          <Border x:Name="Root"
                  Background="{DynamicResource Brush.Scrollbar.Thumb}"
                  CornerRadius="{DynamicResource CornerRadius.Scrollbar}" />
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Root" Property="Background"
                      Value="{DynamicResource Brush.Scrollbar.ThumbHover}" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ScrollBar">
    <Setter Property="Background" Value="{DynamicResource Brush.Scrollbar.Track}" />
    <Setter Property="Width" Value="{DynamicResource Size.Scrollbar}" />
    <Setter Property="Margin" Value="{DynamicResource Margin.Scrollbar}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ScrollBar">
          <Border Background="{TemplateBinding Background}">
            <Track x:Name="PART_Track" IsDirectionReversed="True">
              <Track.Thumb>
                <Thumb Style="{StaticResource ScrollBar.Thumb}" />
              </Track.Thumb>
              <!-- Stock repeat buttons are hidden: a plain thumb reads better and behaves the same. -->
              <Track.IncreaseRepeatButton>
                <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" Focusable="False" />
              </Track.IncreaseRepeatButton>
              <Track.DecreaseRepeatButton>
                <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" Focusable="False" />
              </Track.DecreaseRepeatButton>
            </Track>
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
              <Setter Property="Width" Value="Auto" />
              <Setter Property="Height" Value="{DynamicResource Size.Scrollbar}" />
              <Setter TargetName="PART_Track" Property="IsDirectionReversed" Value="False" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style TargetType="ScrollViewer">
    <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
    <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
    <Setter Property="Focusable" Value="False" />
  </Style>

  <!-- ============================ Slider ============================ -->

  <!-- The two invisible halves of the track either side of the thumb - clicking one jumps the
       thumb a step that direction, same as clicking anywhere in a scrollbar's track. -->
  <Style x:Key="Slider.TrackButton" TargetType="RepeatButton">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RepeatButton">
          <Rectangle Fill="Transparent" />
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- A recessed groove with a raised accent-coloured knob - the same recessed/raised material
       pairing as everything else, just laid out horizontally. The thumb grows slightly on hover
       and eases back on release, the same "fluid" feedback the tile hover lift uses elsewhere,
       rather than snapping straight between its two sizes. -->
  <Style x:Key="Slider.Standard" TargetType="Slider">
    <Setter Property="Height" Value="30" />
    <Setter Property="IsSnapToTickEnabled" Value="True" />
    <Setter Property="TickFrequency" Value="1" />
    <Setter Property="SmallChange" Value="1" />
    <Setter Property="LargeChange" Value="1" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Slider">
          <Grid VerticalAlignment="Center">
            <Border Height="10"
                    Background="{DynamicResource Brush.Surface.Recessed}"
                    BorderThickness="0"
                    CornerRadius="5" />

            <!-- The filled portion, left edge to the thumb - reads as "how much" at a glance,
                 the way a volume slider does, rather than leaving the groove uniformly empty. Width
                 comes from SliderFillWidthConverter: WPF's Track has no "how far along" property of
                 its own to bind to directly, so this recomputes the pixel width from Value/Minimum
                 /Maximum against the track's own rendered ActualWidth on every one of those inputs
                 changing - drag, click, or keyboard alike. A satin gradient, the same
                 Brush.Accent.Surface every raised accent surface uses, rather than a flat fill. -->
            <Border x:Name="Fill"
                    Height="10"
                    HorizontalAlignment="Left"
                    Background="{DynamicResource Brush.Accent.Surface}"
                    CornerRadius="5">
              <Border.Width>
                <MultiBinding Converter="{StaticResource SliderFillWidthConverter}">
                  <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="Value" />
                  <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="Minimum" />
                  <Binding RelativeSource="{RelativeSource TemplatedParent}" Path="Maximum" />
                  <Binding ElementName="PART_Track" Path="ActualWidth" />
                </MultiBinding>
              </Border.Width>
            </Border>

            <Track x:Name="PART_Track">
              <Track.DecreaseRepeatButton>
                <RepeatButton Style="{StaticResource Slider.TrackButton}" Command="Slider.DecreaseLarge" />
              </Track.DecreaseRepeatButton>
              <Track.IncreaseRepeatButton>
                <RepeatButton Style="{StaticResource Slider.TrackButton}" Command="Slider.IncreaseLarge" />
              </Track.IncreaseRepeatButton>
              <Track.Thumb>
                <!-- The hover-grow scale transform and its triggers live inside the Thumb's own
                     ControlTemplate now, not as direct properties on the Thumb - a plain
                     Thumb.Triggers EventTrigger (as opposed to ControlTemplate.Triggers) can only
                     resolve Storyboard.TargetName within its own template's NameScope, not a name
                     declared via a sibling property setter like Thumb.RenderTransform. That
                     mismatch didn't fail to compile - it threw an InvalidOperationException at
                     runtime on every single MouseEnter/MouseLeave, confirmed via the Nudge log. -->
                <Thumb x:Name="SliderThumb" Width="22" Height="22" Cursor="Hand">
                  <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                      <Ellipse x:Name="Knob"
                               Fill="{DynamicResource Brush.Accent.Surface}"
                               Stroke="{DynamicResource Brush.Surface.Background}"
                               StrokeThickness="3"
                               RenderTransformOrigin="0.5,0.5">
                        <Ellipse.RenderTransform>
                          <ScaleTransform x:Name="ThumbScale" ScaleX="1" ScaleY="1" />
                        </Ellipse.RenderTransform>
                        <Ellipse.Effect>
                          <DropShadowEffect Color="{DynamicResource Color.Shadow}"
                                             Direction="270"
                                             ShadowDepth="2"
                                             BlurRadius="8"
                                             Opacity="0.45"
                                             RenderingBias="Performance" />
                        </Ellipse.Effect>
                      </Ellipse>
                      <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                          <Trigger.EnterActions>
                            <BeginStoryboard>
                              <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="ThumbScale" Storyboard.TargetProperty="ScaleX" To="1.2" Duration="{StaticResource Duration.Hover}" />
                                <DoubleAnimation Storyboard.TargetName="ThumbScale" Storyboard.TargetProperty="ScaleY" To="1.2" Duration="{StaticResource Duration.Hover}" />
                              </Storyboard>
                            </BeginStoryboard>
                          </Trigger.EnterActions>
                          <Trigger.ExitActions>
                            <BeginStoryboard>
                              <Storyboard>
                                <DoubleAnimation Storyboard.TargetName="ThumbScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="{StaticResource Duration.Hover}" />
                                <DoubleAnimation Storyboard.TargetName="ThumbScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="{StaticResource Duration.Hover}" />
                              </Storyboard>
                            </BeginStoryboard>
                          </Trigger.ExitActions>
                        </Trigger>
                      </ControlTemplate.Triggers>
                    </ControlTemplate>
                  </Thumb.Template>
                </Thumb>
              </Track.Thumb>
            </Track>
          </Grid>
          <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.45" />
              <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============================ Surfaces ============================ -->

  <!-- Borderless - the soft Effect.Card.Shadow alone reads as a raised panel, matching the
       clean-neumorphic reference boards where no card shows a visible outline. -->
  <Style x:Key="Surface.Card" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface.Background}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="{DynamicResource CornerRadius.L}" />
    <Setter Property="Padding" Value="{DynamicResource Padding.Card}" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Effect" Value="{DynamicResource Effect.Card.Shadow}" />
  </Style>

  <!-- A frosted panel that lets the ambient ground glow read through it. -->
  <Style x:Key="Surface.Glass" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface.Glass}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="{DynamicResource CornerRadius.L}" />
    <Setter Property="Padding" Value="{DynamicResource Padding.Card}" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
    <Setter Property="Effect" Value="{DynamicResource Effect.Card.Shadow}" />
  </Style>

  <Style x:Key="Surface.Inset" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource Brush.Surface.Recessed}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="{DynamicResource CornerRadius.M}" />
    <Setter Property="Padding" Value="{DynamicResource Padding.Card}" />
    <Setter Property="SnapsToDevicePixels" Value="True" />
  </Style>

  <!--
    The raised embossed card the clean-neumorphic pass calls for on Settings/Setup pages - built
    the way LibraryView.xaml's TableTileTemplate already does it, since WPF only allows one Effect
    per element: a dark shadow and a light highlight each get their own identically-shaped, fully
    opaque Border layered behind the real content, so only the blur that spills past their shared
    edges survives, as a soft dark glow bottom-right and a soft light glow top-left.

    This resolves the design question the previous UI session flagged rather than leaving it open:
    the reference boards show raised, embossed cards throughout (never recessed), so raised is what
    every Settings/Setup card now uses - Surface.Inset above is kept only for a genuinely recessed
    look elsewhere, not for cards.
  -->
  <Style x:Key="Card.Neumorphic" TargetType="ContentControl">
    <Setter Property="Padding" Value="{DynamicResource Padding.Card}" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ContentControl">
          <Grid>
            <Border Background="{DynamicResource Brush.Surface.Background}"
                    CornerRadius="{DynamicResource CornerRadius.L}"
                    Effect="{DynamicResource Effect.Card.Shadow.Rest}" />
            <Border Background="{DynamicResource Brush.Surface.Background}"
                    CornerRadius="{DynamicResource CornerRadius.L}"
                    Effect="{DynamicResource Effect.Card.Highlight.Rest}" />
            <Border Background="{DynamicResource Brush.Surface.Background}"
                    CornerRadius="{DynamicResource CornerRadius.L}"
                    SnapsToDevicePixels="True">
              <ContentPresenter Margin="{TemplateBinding Padding}"
                                HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
            </Border>
          </Grid>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <Style x:Key="Surface.Error" TargetType="Border">
    <Setter Property="Background" Value="{DynamicResource Brush.Status.Error.Background}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Brush.Status.Error.Border}" />
    <Setter Property="BorderThickness" Value="{DynamicResource BorderThickness.Thin}" />
    <Setter Property="CornerRadius" Value="{DynamicResource CornerRadius.M}" />
    <Setter Property="Padding" Value="{DynamicResource Padding.Card}" />
  </Style>

  <Style x:Key="Badge" TargetType="Border">
    <Setter Property="CornerRadius" Value="{DynamicResource CornerRadius.S}" />
    <Setter Property="Padding" Value="{DynamicResource Padding.Badge}" />
    <Setter Property="HorizontalAlignment" Value="Left" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Background" Value="{DynamicResource Brush.Surface.BackgroundAlt}" />
  </Style>

  <!-- ============================ Progress ============================ -->

  <!--
    A fully custom template rather than just restyling the stock one: WPF's default indeterminate
    ProgressBar draws the dated segmented Aero sweep, which was the single least "clean" thing on
    the loading screens and ignored the app's material entirely. This is one soft rounded comet
    easing across a recessed pill track.

    The comet travels a fixed pixel range rather than one bound to the track's width, because a
    Storyboard's From/To cannot be data-bound. The range comfortably exceeds every indeterminate bar
    in the app (all 220-240 wide) and the track clips the overshoot, so the only visible effect is
    the comet fully leaving one end before returning.
  -->
  <Style x:Key="Progress.Indeterminate" TargetType="ProgressBar">
    <Setter Property="Height" Value="6" />
    <Setter Property="IsIndeterminate" Value="True" />
    <Setter Property="Background" Value="{DynamicResource Brush.Surface.Recessed}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ProgressBar">
          <Border Background="{TemplateBinding Background}"
                  CornerRadius="{DynamicResource CornerRadius.Pill}"
                  ClipToBounds="True">
            <Border x:Name="Comet"
                    Width="96"
                    HorizontalAlignment="Left"
                    Background="{TemplateBinding Foreground}"
                    CornerRadius="{DynamicResource CornerRadius.Pill}">
              <Border.RenderTransform>
                <TranslateTransform x:Name="CometOffset" X="-120" />
              </Border.RenderTransform>
            </Border>
          </Border>
          <ControlTemplate.Triggers>
            <EventTrigger RoutedEvent="Loaded">
              <BeginStoryboard>
                <Storyboard RepeatBehavior="Forever">
                  <!-- Eased rather than linear: a constant-speed bar reads mechanical, while easing
                       in and out at the extremes is what makes the motion feel smooth. -->
                  <DoubleAnimation Storyboard.TargetName="CometOffset"
                                   Storyboard.TargetProperty="X"
                                   From="-120" To="560"
                                   Duration="0:0:1.5">
                    <DoubleAnimation.EasingFunction>
                      <SineEase EasingMode="EaseInOut" />
                    </DoubleAnimation.EasingFunction>
                  </DoubleAnimation>
                </Storyboard>
              </BeginStoryboard>
            </EventTrigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- A determinate counterpart - a rescan reports real per-file progress (LibraryViewModel.ScanAsync
       wires the scanner's own IProgress&lt;ScanProgress&gt; into ScanProgressPercent), so this shows
       that real number rather than another indeterminate sweep. PART_Track/PART_Indicator are the
       exact names ProgressBar's own code looks for at the framework level - naming them this way is
       what lets a plain custom template get real percentage-driven sizing for free, with no extra
       code-behind, the same as the default (unstyled) template would. -->
  <Style x:Key="Progress.Standard" TargetType="ProgressBar">
    <Setter Property="Height" Value="6" />
    <Setter Property="Background" Value="{DynamicResource Brush.Surface.Recessed}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Accent}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ProgressBar">
          <!-- Pill-rounded rather than the old 2px CornerRadius.Scrollbar, which read as a blunt
               rectangle at this height and matched nothing else on screen. -->
          <Border Background="{TemplateBinding Background}"
                  CornerRadius="{DynamicResource CornerRadius.Pill}"
                  ClipToBounds="True">
            <Grid x:Name="PART_Track">
              <Border x:Name="PART_Indicator"
                      Background="{TemplateBinding Foreground}"
                      CornerRadius="{DynamicResource CornerRadius.Pill}"
                      HorizontalAlignment="Left" />
            </Grid>
          </Border>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- ============================ Controller hint bar ============================ -->

  <!--
    The button legend shown along the bottom of a screen while a pad is in use. Defined once here
    rather than per page so every screen's legend is identical in shape and weight - the whole point
    is that it becomes furniture you stop reading, which only works if it never moves or changes
    style between pages.

    Each entry is a rounded badge holding the button name, then the action beside it. No "=" between
    them: the badge already reads as a button, so the equals sign is punctuation doing a job the
    shape has already done.
  -->
  <DataTemplate x:Key="ControllerHint.Template">
    <StackPanel Orientation="Horizontal" Margin="0,0,18,0" VerticalAlignment="Center">
      <Border Background="{DynamicResource Brush.Control.Background}"
              CornerRadius="{DynamicResource CornerRadius.Pill}"
              MinWidth="26"
              Padding="8,3,8,3"
              Effect="{DynamicResource Effect.Button.Shadow}">
        <TextBlock Text="{Binding Button}"
                   HorizontalAlignment="Center"
                   FontFamily="{DynamicResource Font.Family.Primary}"
                   FontSize="{DynamicResource Font.Size.Caption}"
                   FontWeight="{DynamicResource Font.Weight.SemiBold}"
                   Foreground="{DynamicResource Brush.Accent}" />
      </Border>
      <TextBlock Text="{Binding Action}"
                 Margin="8,0,0,0"
                 VerticalAlignment="Center"
                 FontFamily="{DynamicResource Font.Family.Primary}"
                 FontSize="{DynamicResource Font.Size.Caption}"
                 Foreground="{DynamicResource Brush.Text.Secondary}" />
    </StackPanel>
  </DataTemplate>

  <!-- The bar itself: a full-width strip along the bottom of whichever page is showing. Bound to a
       page's own hint list, so each screen states its own actions. -->
  <Style x:Key="ControllerHintBar" TargetType="ItemsControl">
    <Setter Property="ItemTemplate" Value="{StaticResource ControllerHint.Template}" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="IsHitTestVisible" Value="False" />
    <Setter Property="Focusable" Value="False" />
    <Setter Property="ItemsPanel">
      <Setter.Value>
        <ItemsPanelTemplate>
          <StackPanel Orientation="Horizontal" />
        </ItemsPanelTemplate>
      </Setter.Value>
    </Setter>
  </Style>

</ResourceDictionary>
