<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    Teal Light palette - the same porcelain material as Colors.Light.xaml, with the accent
    recoloured from amber to a cool blue-green teal, darkened enough to hold contrast on a white
    surface the same way Colors.Light.xaml darkens Colors.Dark.xaml's amber. Surfaces and controls
    are tinted teal too, not left neutral - see Colors.JadeLight.xaml's own note on why a light
    theme needs that to actually read as coloured, not just its wallpaper. See Colors.Teal.xaml for
    the dark counterpart this pairs with.
  -->

  <!-- ============================ Ground ============================ -->

  <RadialGradientBrush x:Key="Brush.Window.Background" GradientOrigin="0.5,0.28" Center="0.5,0.28" RadiusX="0.9" RadiusY="0.85">
    <GradientStop Color="#EBF5F4" Offset="0" />
    <GradientStop Color="#E0EEEC" Offset="0.75" />
    <GradientStop Color="#D4E5E3" Offset="1" />
  </RadialGradientBrush>

  <SolidColorBrush x:Key="Brush.Window.BackgroundFlat" Color="#E0EEEC" />

  <!-- ============================ Surfaces ============================ -->

  <LinearGradientBrush x:Key="Brush.Surface.Background" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#EBF5F4" Offset="0" />
    <GradientStop Color="#E0EEEC" Offset="1" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="Brush.Surface.BackgroundAlt" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#E0EEEC" Offset="0" />
    <GradientStop Color="#D4E5E3" Offset="1" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="Brush.Surface.Recessed" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#E0EEEC" Offset="0" />
    <GradientStop Color="#EBF5F4" Offset="1" />
  </LinearGradientBrush>

  <SolidColorBrush x:Key="Brush.Surface.Border" Color="#D4E5E3" />

  <SolidColorBrush x:Key="Brush.Surface.Glass" Color="#B3FFFFFF" />

  <LinearGradientBrush x:Key="Brush.Surface.EdgeHighlight" StartPoint="0.1,0" EndPoint="0.9,1">
    <GradientStop Color="#FFFFFF" Offset="0" />
    <GradientStop Color="#D9EBE9" Offset="0.45" />
    <GradientStop Color="#B0D3CE" Offset="1" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="Brush.Surface.RimLight" StartPoint="0.1,0" EndPoint="0.9,1">
    <GradientStop Color="#FFFFFF" Offset="0" />
    <GradientStop Color="#C7E4E0" Offset="0.5" />
    <GradientStop Color="#8FC0B9" Offset="1" />
  </LinearGradientBrush>

  <Color x:Key="Color.Shadow">#96A0B4</Color>

  <!-- The soft light-catch a neumorphic surface needs on its raised (top-left) side - see the note
       in Colors.Dark.xaml. -->
  <Color x:Key="Color.Highlight">#FFFFFF</Color>

  <!-- ============================ Text ============================ -->

  <SolidColorBrush x:Key="Brush.Text.Primary" Color="#1B1F27" />
  <SolidColorBrush x:Key="Brush.Text.Secondary" Color="#535B6B" />
  <SolidColorBrush x:Key="Brush.Text.Muted" Color="#7C8494" />

  <!-- ============================ Accent ============================ -->

  <!-- Darker teal than the dark palette's, so it holds contrast against a white surface. -->
  <SolidColorBrush x:Key="Brush.Accent" Color="#1F8A82" />
  <SolidColorBrush x:Key="Brush.Accent.Hover" Color="#2AA098" />
  <SolidColorBrush x:Key="Brush.Accent.Pressed" Color="#176D66" />
  <SolidColorBrush x:Key="Brush.Accent.Foreground" Color="#FFFFFF" />
  <SolidColorBrush x:Key="Brush.Accent.Subtle" Color="#E3F3F1" />

  <LinearGradientBrush x:Key="Brush.Accent.Surface" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#2AA098" Offset="0" />
    <GradientStop Color="#1D7A73" Offset="1" />
  </LinearGradientBrush>

  <!-- ============================ Controls ============================ -->

  <LinearGradientBrush x:Key="Brush.Control.Background" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#FFFFFF" Offset="0" />
    <GradientStop Color="#EBF5F4" Offset="1" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="Brush.Control.BackgroundHover" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#FFFFFF" Offset="0" />
    <GradientStop Color="#F5FAF9" Offset="1" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="Brush.Control.BackgroundPressed" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#E0EEEC" Offset="0" />
    <GradientStop Color="#D4E5E3" Offset="1" />
  </LinearGradientBrush>

  <SolidColorBrush x:Key="Brush.Control.Border" Color="#CBDFDC" />
  <SolidColorBrush x:Key="Brush.Control.BorderHover" Color="#8FACA8" />
  <SolidColorBrush x:Key="Brush.Control.Foreground" Color="#1B1F27" />
  <SolidColorBrush x:Key="Brush.Control.ForegroundDisabled" Color="#A8AEBB" />

  <SolidColorBrush x:Key="Brush.Focus" Color="#1F8A82" />

  <!-- ============================ Indicator LEDs ============================ -->

  <SolidColorBrush x:Key="Brush.Confidence.High" Color="#2A7A52" />
  <SolidColorBrush x:Key="Brush.Confidence.Medium" Color="#1F8A82" />
  <SolidColorBrush x:Key="Brush.Confidence.Low" Color="#A2512A" />
  <SolidColorBrush x:Key="Brush.Confidence.Unknown" Color="#6E7688" />

  <SolidColorBrush x:Key="Brush.Confidence.High.Background" Color="#E6F2EA" />
  <SolidColorBrush x:Key="Brush.Confidence.Medium.Background" Color="#E3F3F1" />
  <SolidColorBrush x:Key="Brush.Confidence.Low.Background" Color="#FAEDE5" />
  <SolidColorBrush x:Key="Brush.Confidence.Unknown.Background" Color="#ECEEF2" />

  <!-- ============================ Status ============================ -->

  <SolidColorBrush x:Key="Brush.Status.Error" Color="#B03A2C" />
  <SolidColorBrush x:Key="Brush.Status.Error.Background" Color="#FBEBE9" />
  <SolidColorBrush x:Key="Brush.Status.Error.Border" Color="#E5B7B1" />
  <SolidColorBrush x:Key="Brush.Status.Info" Color="#25618F" />
  <SolidColorBrush x:Key="Brush.Status.Info.Background" Color="#E8F0F7" />

  <!-- ============================ Scrollbars ============================ -->

  <SolidColorBrush x:Key="Brush.Scrollbar.Track" Color="#00000000" />
  <SolidColorBrush x:Key="Brush.Scrollbar.Thumb" Color="#B7CDC9" />
  <SolidColorBrush x:Key="Brush.Scrollbar.ThumbHover" Color="#8FACA8" />

  <!-- ============================ Window chrome ============================ -->

  <LinearGradientBrush x:Key="Brush.TitleBar.Background" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#EFF7F5" Offset="0" />
    <GradientStop Color="#DEECE9" Offset="1" />
  </LinearGradientBrush>

  <SolidColorBrush x:Key="Brush.Overlay.Scrim" Color="#D9EDEFF3" />

</ResourceDictionary>
