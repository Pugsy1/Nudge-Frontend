<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=System.Runtime">

  <!--
    Type scale. Views reference these names, never a literal font size or family.
    Both families name a fallback after the comma so the app still reads correctly on a machine
    without the preferred font installed.
  -->

  <!-- Segoe UI Variable is Windows 11's rounder, warmer system font - fits the calmer material
       language better than classic Segoe UI's tighter geometry. Not bundled on older Windows 10,
       so the fallback chain still ends on the fonts guaranteed present down to AGENTS.md's minimum
       OS (Windows 10 21H2). -->
  <FontFamily x:Key="Font.Family.Primary">Segoe UI Variable Text, Segoe UI, Tahoma, sans-serif</FontFamily>
  <FontFamily x:Key="Font.Family.Mono">Cascadia Mono, Consolas, Courier New, monospace</FontFamily>

  <system:Double x:Key="Font.Size.Caption">11</system:Double>
  <system:Double x:Key="Font.Size.Body">13</system:Double>
  <system:Double x:Key="Font.Size.BodyLarge">15</system:Double>
  <system:Double x:Key="Font.Size.Subtitle">18</system:Double>
  <system:Double x:Key="Font.Size.Title">24</system:Double>
  <system:Double x:Key="Font.Size.Display">32</system:Double>

  <FontWeight x:Key="Font.Weight.Regular">Normal</FontWeight>
  <FontWeight x:Key="Font.Weight.Medium">Medium</FontWeight>
  <FontWeight x:Key="Font.Weight.SemiBold">SemiBold</FontWeight>
  <FontWeight x:Key="Font.Weight.Bold">Bold</FontWeight>

  <!-- Named text styles, so a view says what a piece of text *is* rather than how it looks. -->

  <Style x:Key="Text.Display" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource Font.Family.Primary}" />
    <Setter Property="FontSize" Value="{DynamicResource Font.Size.Display}" />
    <Setter Property="FontWeight" Value="{DynamicResource Font.Weight.SemiBold}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style x:Key="Text.Title" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource Font.Family.Primary}" />
    <Setter Property="FontSize" Value="{DynamicResource Font.Size.Title}" />
    <Setter Property="FontWeight" Value="{DynamicResource Font.Weight.SemiBold}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style x:Key="Text.Subtitle" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource Font.Family.Primary}" />
    <Setter Property="FontSize" Value="{DynamicResource Font.Size.Subtitle}" />
    <Setter Property="FontWeight" Value="{DynamicResource Font.Weight.Medium}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style x:Key="Text.Body" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource Font.Family.Primary}" />
    <Setter Property="FontSize" Value="{DynamicResource Font.Size.Body}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Primary}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style x:Key="Text.BodySecondary" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
  </Style>

  <Style x:Key="Text.Caption" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource Font.Family.Primary}" />
    <Setter Property="FontSize" Value="{DynamicResource Font.Size.Caption}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Muted}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style x:Key="Text.SectionHeading" TargetType="TextBlock" BasedOn="{StaticResource Text.Caption}">
    <Setter Property="FontWeight" Value="{DynamicResource Font.Weight.SemiBold}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
  </Style>

  <!-- Paths and versions: monospaced so columns line up and characters are unambiguous. -->
  <Style x:Key="Text.Mono" TargetType="TextBlock">
    <Setter Property="FontFamily" Value="{DynamicResource Font.Family.Mono}" />
    <Setter Property="FontSize" Value="{DynamicResource Font.Size.Body}" />
    <Setter Property="Foreground" Value="{DynamicResource Brush.Text.Secondary}" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>

  <Style x:Key="Text.MonoCaption" TargetType="TextBlock" BasedOn="{StaticResource Text.Mono}">
    <Setter Property="FontSize" Value="{DynamicResource Font.Size.Caption}" />
  </Style>

</ResourceDictionary>
