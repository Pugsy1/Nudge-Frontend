<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    Copper Light palette - the same porcelain material as Colors.Light.xaml, with the accent
    recoloured from amber to a warm metallic copper/bronze, darkened enough to hold contrast on a
    white surface the same way Colors.Light.xaml darkens Colors.Dark.xaml's amber. Surfaces and
    controls are tinted copper too, not left neutral - see Colors.JadeLight.xaml's own note on why a
    light theme needs that to actually read as coloured. See Colors.Copper.xaml for the dark
    counterpart.
  -->

  <!-- ============================ Ground ============================ -->

  <RadialGradientBrush x:Key="Brush.Window.Background" GradientOrigin="0.5,0.28" Center="0.5,0.28" RadiusX="0.9" RadiusY="0.85">
    <GradientStop Color="#F7EEE6" Offset="0" />
    <GradientStop Color="#F1E3D6" Offset="0.75" />
    <GradientStop Color="#E9D3BE" Offset="1" />
  </RadialGradientBrush>

  <SolidColorBrush x:Key="Brush.Window.BackgroundFlat" Color="#F1E3D6" />

  <!-- ============================ Surfaces ============================ -->

  <LinearGradientBrush x:Key="Brush.Surface.Background" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#F7EEE6" Offset="0" />
    <GradientStop Color="#F1E3D6" Offset="1" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="Brush.Surface.BackgroundAlt" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#F1E3D6" Offset="0" />
    <GradientStop Color="#E9D3BE" Offset="1" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="Brush.Surface.Recessed" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#F1E3D6" Offset="0" />
    <GradientStop Color="#F7EEE6" Offset="1" />
  </LinearGradientBrush>

  <SolidColorBrush x:Key="Brush.Surface.Border" Color="#E9D3BE" />

  <SolidColorBrush x:Key="Brush.Surface.Glass" Color="#B3FFFFFF" />

  <LinearGradientBrush x:Key="Brush.Surface.EdgeHighlight" StartPoint="0.1,0" EndPoint="0.9,1">
    <GradientStop Color="#FFFFFF" Offset="0" />
    <GradientStop Color="#EFDCC7" Offset="0.45" />
    <GradientStop Color="#DCB794" Offset="1" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="Brush.Surface.RimLight" StartPoint="0.1,0" EndPoint="0.9,1">
    <GradientStop Color="#FFFFFF" Offset="0" />
    <GradientStop Color="#E6CBAC" Offset="0.5" />
    <GradientStop Color="#CC9E71" Offset="1" />
  </LinearGradientBrush>

  <Color x:Key="Color.Shadow">#96A0B4</Color>

  <Color x:Key="Color.Highlight">#FFFFFF</Color>

  <!-- ============================ Text ============================ -->

  <SolidColorBrush x:Key="Brush.Text.Primary" Color="#1B1F27" />
  <SolidColorBrush x:Key="Brush.Text.Secondary" Color="#535B6B" />
  <SolidColorBrush x:Key="Brush.Text.Muted" Color="#7C8494" />

  <!-- ============================ Accent ============================ -->

  <!-- Darker copper than the dark palette's, so it holds contrast against a white surface. -->
  <SolidColorBrush x:Key="Brush.Accent" Color="#A05A2E" />
  <SolidColorBrush x:Key="Brush.Accent.Hover" Color="#B36F41" />
  <SolidColorBrush x:Key="Brush.Accent.Pressed" Color="#824720" />
  <SolidColorBrush x:Key="Brush.Accent.Foreground" Color="#FFFFFF" />
  <SolidColorBrush x:Key="Brush.Accent.Subtle" Color="#F3E5D8" />

  <LinearGradientBrush x:Key="Brush.Accent.Surface" StartPoint="0,0" EndPoint="1,0">
    <GradientStop Color="#B36F41" Offset="0" />
    <GradientStop Color="#8A5228" Offset="1" />
  </LinearGradientBrush>

  <!-- ============================ Controls ============================ -->

  <LinearGradientBrush x:Key="Brush.Control.Background" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#FFFFFF" Offset="0" />
    <GradientStop Color="#F7EEE6" Offset="1" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="Brush.Control.BackgroundHover" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#FFFFFF" Offset="0" />
    <GradientStop Color="#FBF6F0" Offset="1" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="Brush.Control.BackgroundPressed" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#F1E3D6" Offset="0" />
    <GradientStop Color="#E9D3BE" Offset="1" />
  </LinearGradientBrush>

  <SolidColorBrush x:Key="Brush.Control.Border" Color="#E0C7AE" />
  <SolidColorBrush x:Key="Brush.Control.BorderHover" Color="#AE917A" />
  <SolidColorBrush x:Key="Brush.Control.Foreground" Color="#1B1F27" />
  <SolidColorBrush x:Key="Brush.Control.ForegroundDisabled" Color="#A8AEBB" />

  <SolidColorBrush x:Key="Brush.Focus" Color="#A05A2E" />

  <!-- ============================ Indicator LEDs ============================ -->

  <SolidColorBrush x:Key="Brush.Confidence.High" Color="#2A7A52" />
  <SolidColorBrush x:Key="Brush.Confidence.Medium" Color="#A05A2E" />
  <SolidColorBrush x:Key="Brush.Confidence.Low" Color="#A2512A" />
  <SolidColorBrush x:Key="Brush.Confidence.Unknown" Color="#6E7688" />

  <SolidColorBrush x:Key="Brush.Confidence.High.Background" Color="#E6F2EA" />
  <SolidColorBrush x:Key="Brush.Confidence.Medium.Background" Color="#F3E5D8" />
  <SolidColorBrush x:Key="Brush.Confidence.Low.Background" Color="#FAEDE5" />
  <SolidColorBrush x:Key="Brush.Confidence.Unknown.Background" Color="#ECEEF2" />

  <!-- ============================ Status ============================ -->

  <SolidColorBrush x:Key="Brush.Status.Error" Color="#B03A2C" />
  <SolidColorBrush x:Key="Brush.Status.Error.Background" Color="#FBEBE9" />
  <SolidColorBrush x:Key="Brush.Status.Error.Border" Color="#E5B7B1" />
  <SolidColorBrush x:Key="Brush.Status.Info" Color="#25618F" />
  <SolidColorBrush x:Key="Brush.Status.Info.Background" Color="#E8F0F7" />

  <!-- ============================ Scrollbars ============================ -->

  <SolidColorBrush x:Key="Brush.Scrollbar.Track" Color="#00000000" />
  <SolidColorBrush x:Key="Brush.Scrollbar.Thumb" Color="#D9C0A3" />
  <SolidColorBrush x:Key="Brush.Scrollbar.ThumbHover" Color="#AE917A" />

  <!-- ============================ Window chrome ============================ -->

  <LinearGradientBrush x:Key="Brush.TitleBar.Background" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#FBF4EE" Offset="0" />
    <GradientStop Color="#EFDECE" Offset="1" />
  </LinearGradientBrush>

  <SolidColorBrush x:Key="Brush.Overlay.Scrim" Color="#D9EDEFF3" />

</ResourceDictionary>
