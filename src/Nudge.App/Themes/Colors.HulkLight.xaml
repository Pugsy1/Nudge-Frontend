<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    Hulk Light palette - the light-mode counterpart to Colors.Hulk.xaml, keeping the same 60/30/10
    structure rather than Colors.Light.xaml's neutral porcelain (Jade/Sapphire/Crimson/Chrome Light
    stay neutral because their dark versions only tint the ground and bevel; Hulk's dark version
    retints surfaces, controls, scrollbar and title bar too, so its light version has to match):

      60% Primary   - Brush.Window.Background: a soft light sage, the light twin of the dark
                      palette's muted sage ground.
      30% Secondary - Brush.Surface.*, Brush.Control.Background, Brush.TitleBar.Background: a
                      slightly deeper green-white than the primary, still white enough to hold
                      panel contrast on a light ground.
      10% Accent    - Brush.Accent* and Brush.Focus only: the vivid comic-green, darkened enough
                      to hold contrast against white the same way every other light palette here
                      darkens its dark counterpart's accent.
  -->

  <!-- ============================ Ground - 60% Primary ============================ -->

  <RadialGradientBrush x:Key="Brush.Window.Background" GradientOrigin="0.5,0.28" Center="0.5,0.28" RadiusX="0.9" RadiusY="0.85">
    <GradientStop Color="#EEF4EF" Offset="0" />
    <GradientStop Color="#E3ECE4" Offset="0.75" />
    <GradientStop Color="#D7E3D8" Offset="1" />
  </RadialGradientBrush>

  <SolidColorBrush x:Key="Brush.Window.BackgroundFlat" Color="#E3ECE4" />

  <!-- ============================ Surfaces - 30% Secondary ============================ -->

  <LinearGradientBrush x:Key="Brush.Surface.Background" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#FFFFFF" Offset="0" />
    <GradientStop Color="#EEF4EF" Offset="1" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="Brush.Surface.BackgroundAlt" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#F5F9F5" Offset="0" />
    <GradientStop Color="#E7EFE8" Offset="1" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="Brush.Surface.Recessed" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#D8E3D9" Offset="0" />
    <GradientStop Color="#EAF1EB" Offset="1" />
  </LinearGradientBrush>

  <SolidColorBrush x:Key="Brush.Surface.Border" Color="#CFDDD0" />

  <SolidColorBrush x:Key="Brush.Surface.Glass" Color="#B3FFFFFF" />

  <LinearGradientBrush x:Key="Brush.Surface.EdgeHighlight" StartPoint="0.1,0" EndPoint="0.9,1">
    <GradientStop Color="#FFFFFF" Offset="0" />
    <GradientStop Color="#DCEBDD" Offset="0.45" />
    <GradientStop Color="#B4D0B7" Offset="1" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="Brush.Surface.RimLight" StartPoint="0.1,0" EndPoint="0.9,1">
    <GradientStop Color="#FFFFFF" Offset="0" />
    <GradientStop Color="#CDE5CF" Offset="0.5" />
    <GradientStop Color="#96C09B" Offset="1" />
  </LinearGradientBrush>

  <Color x:Key="Color.Shadow">#96A0B4</Color>

  <!-- The soft light-catch a neumorphic surface needs on its raised (top-left) side - see the note
       in Colors.Dark.xaml. -->
  <Color x:Key="Color.Highlight">#FFFFFF</Color>

  <!-- ============================ Text (functional, not part of the 60/30/10 scheme) ============================ -->

  <SolidColorBrush x:Key="Brush.Text.Primary" Color="#1B211D" />
  <SolidColorBrush x:Key="Brush.Text.Secondary" Color="#4F5B51" />
  <SolidColorBrush x:Key="Brush.Text.Muted" Color="#6B7A6D" />

  <!-- ============================ Accent - 10%, buttons and active states only ============================ -->

  <SolidColorBrush x:Key="Brush.Accent" Color="#2F8A28" />
  <SolidColorBrush x:Key="Brush.Accent.Hover" Color="#3C9E33" />
  <SolidColorBrush x:Key="Brush.Accent.Pressed" Color="#226B1D" />
  <SolidColorBrush x:Key="Brush.Accent.Foreground" Color="#FFFFFF" />
  <SolidColorBrush x:Key="Brush.Accent.Subtle" Color="#E6F3E4" />

  <LinearGradientBrush x:Key="Brush.Accent.Surface" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#3C9E33" Offset="0" />
    <GradientStop Color="#1F7A1A" Offset="1" />
  </LinearGradientBrush>

  <!-- ============================ Controls - 30% Secondary ============================ -->

  <LinearGradientBrush x:Key="Brush.Control.Background" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#FFFFFF" Offset="0" />
    <GradientStop Color="#ECF3ED" Offset="1" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="Brush.Control.BackgroundHover" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#FFFFFF" Offset="0" />
    <GradientStop Color="#F6FAF6" Offset="1" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="Brush.Control.BackgroundPressed" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#D9E7DA" Offset="0" />
    <GradientStop Color="#E9F1E9" Offset="1" />
  </LinearGradientBrush>

  <SolidColorBrush x:Key="Brush.Control.Border" Color="#CCDBCD" />
  <SolidColorBrush x:Key="Brush.Control.BorderHover" Color="#93AF97" />
  <SolidColorBrush x:Key="Brush.Control.Foreground" Color="#1B211D" />
  <SolidColorBrush x:Key="Brush.Control.ForegroundDisabled" Color="#A5B4A7" />

  <!-- Focus is an active/interactive state, so it's accent, not secondary - per the 60/30/10 rule. -->
  <SolidColorBrush x:Key="Brush.Focus" Color="#2F8A28" />

  <!-- ============================ Indicator LEDs ============================ -->

  <!-- Medium deliberately does NOT reuse Brush.Accent - see Colors.Hulk.xaml's own note on why an
       accent that's already green can't also stand in for Medium confidence without becoming
       indistinguishable from High. -->
  <SolidColorBrush x:Key="Brush.Confidence.High" Color="#2A7A52" />
  <SolidColorBrush x:Key="Brush.Confidence.Medium" Color="#9C7F1E" />
  <SolidColorBrush x:Key="Brush.Confidence.Low" Color="#A2512A" />
  <SolidColorBrush x:Key="Brush.Confidence.Unknown" Color="#6E7688" />

  <SolidColorBrush x:Key="Brush.Confidence.High.Background" Color="#E6F2EA" />
  <SolidColorBrush x:Key="Brush.Confidence.Medium.Background" Color="#F5EFDC" />
  <SolidColorBrush x:Key="Brush.Confidence.Low.Background" Color="#FAEDE5" />
  <SolidColorBrush x:Key="Brush.Confidence.Unknown.Background" Color="#ECEEF2" />

  <!-- ============================ Status (functional, not part of the 60/30/10 scheme) ============================ -->

  <SolidColorBrush x:Key="Brush.Status.Error" Color="#B03A2C" />
  <SolidColorBrush x:Key="Brush.Status.Error.Background" Color="#FBEBE9" />
  <SolidColorBrush x:Key="Brush.Status.Error.Border" Color="#E5B7B1" />
  <SolidColorBrush x:Key="Brush.Status.Info" Color="#25618F" />
  <SolidColorBrush x:Key="Brush.Status.Info.Background" Color="#E8F0F7" />

  <!-- ============================ Scrollbars - 30% Secondary ============================ -->

  <SolidColorBrush x:Key="Brush.Scrollbar.Track" Color="#00000000" />
  <SolidColorBrush x:Key="Brush.Scrollbar.Thumb" Color="#B7CCB9" />
  <SolidColorBrush x:Key="Brush.Scrollbar.ThumbHover" Color="#93AF97" />

  <!-- ============================ Window chrome - 30% Secondary ============================ -->

  <LinearGradientBrush x:Key="Brush.TitleBar.Background" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#F1F7F1" Offset="0" />
    <GradientStop Color="#E2EBE3" Offset="1" />
  </LinearGradientBrush>

  <SolidColorBrush x:Key="Brush.Overlay.Scrim" Color="#D9E2EBE3" />

</ResourceDictionary>
