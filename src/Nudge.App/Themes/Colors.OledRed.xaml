<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    OLED Red palette - the same true-black material as Colors.Oled.xaml (every surface, border and
    bevel stays a shade of grey between pure black and pure white, for the same OLED-power-saving
    reason that file explains), just with a genuine accent colour instead of "brightest thing on
    screen is plain white" - a red option for OLED users who still want their pick of hue. Only the
    Accent section, Focus, and the window-chrome tint differ from Colors.Oled.xaml; Confidence/Status
    stay exactly as functional-not-monochrome as the original for the same reason given there.
  -->

  <!-- ============================ Ground ============================ -->

  <SolidColorBrush x:Key="Brush.Window.Background" Color="#000000" />
  <SolidColorBrush x:Key="Brush.Window.BackgroundFlat" Color="#000000" />

  <!-- ============================ Surfaces ============================ -->

  <LinearGradientBrush x:Key="Brush.Surface.Background" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#0C0C0C" Offset="0" />
    <GradientStop Color="#060606" Offset="1" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="Brush.Surface.BackgroundAlt" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#101010" Offset="0" />
    <GradientStop Color="#080808" Offset="1" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="Brush.Surface.Recessed" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#000000" Offset="0" />
    <GradientStop Color="#0A0A0A" Offset="1" />
  </LinearGradientBrush>

  <SolidColorBrush x:Key="Brush.Surface.Border" Color="#2A2A2A" />

  <SolidColorBrush x:Key="Brush.Surface.Glass" Color="#B3060606" />

  <LinearGradientBrush x:Key="Brush.Surface.EdgeHighlight" StartPoint="0.15,0" EndPoint="0.85,1">
    <GradientStop Color="#808080" Offset="0" />
    <GradientStop Color="#333333" Offset="0.5" />
    <GradientStop Color="#000000" Offset="1" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="Brush.Surface.RimLight" StartPoint="0.15,0" EndPoint="0.85,1">
    <GradientStop Color="#B3B3B3" Offset="0" />
    <GradientStop Color="#4D4D4D" Offset="0.5" />
    <GradientStop Color="#000000" Offset="1" />
  </LinearGradientBrush>

  <Color x:Key="Color.Shadow">#000000</Color>
  <Color x:Key="Color.Highlight">#666666</Color>

  <!-- ============================ Text ============================ -->

  <SolidColorBrush x:Key="Brush.Text.Primary" Color="#FFFFFF" />
  <SolidColorBrush x:Key="Brush.Text.Secondary" Color="#B3B3B3" />
  <SolidColorBrush x:Key="Brush.Text.Muted" Color="#737373" />

  <!-- ============================ Accent ============================ -->

  <SolidColorBrush x:Key="Brush.Accent" Color="#E0524A" />
  <SolidColorBrush x:Key="Brush.Accent.Hover" Color="#F06D64" />
  <SolidColorBrush x:Key="Brush.Accent.Pressed" Color="#B8362F" />
  <SolidColorBrush x:Key="Brush.Accent.Foreground" Color="#1A0A08" />
  <SolidColorBrush x:Key="Brush.Accent.Subtle" Color="#1A0D0B" />

  <LinearGradientBrush x:Key="Brush.Accent.Surface" StartPoint="0,0" EndPoint="1,0">
    <GradientStop Color="#F06D64" Offset="0" />
    <GradientStop Color="#C8443C" Offset="1" />
  </LinearGradientBrush>

  <!-- ============================ Controls ============================ -->

  <LinearGradientBrush x:Key="Brush.Control.Background" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#0D0D0D" Offset="0" />
    <GradientStop Color="#070707" Offset="1" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="Brush.Control.BackgroundHover" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#1A1A1A" Offset="0" />
    <GradientStop Color="#0D0D0D" Offset="1" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="Brush.Control.BackgroundPressed" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#000000" Offset="0" />
    <GradientStop Color="#080808" Offset="1" />
  </LinearGradientBrush>

  <SolidColorBrush x:Key="Brush.Control.Border" Color="#333333" />
  <SolidColorBrush x:Key="Brush.Control.BorderHover" Color="#666666" />
  <SolidColorBrush x:Key="Brush.Control.Foreground" Color="#FFFFFF" />
  <SolidColorBrush x:Key="Brush.Control.ForegroundDisabled" Color="#4D4D4D" />

  <SolidColorBrush x:Key="Brush.Focus" Color="#E0524A" />

  <!-- ============================ Indicator LEDs ============================ -->

  <SolidColorBrush x:Key="Brush.Confidence.High" Color="#5FB98A" />
  <SolidColorBrush x:Key="Brush.Confidence.Medium" Color="#D9A05B" />
  <SolidColorBrush x:Key="Brush.Confidence.Low" Color="#D4794F" />
  <SolidColorBrush x:Key="Brush.Confidence.Unknown" Color="#737373" />

  <SolidColorBrush x:Key="Brush.Confidence.High.Background" Color="#0F1A15" />
  <SolidColorBrush x:Key="Brush.Confidence.Medium.Background" Color="#1A150D" />
  <SolidColorBrush x:Key="Brush.Confidence.Low.Background" Color="#1A120D" />
  <SolidColorBrush x:Key="Brush.Confidence.Unknown.Background" Color="#101010" />

  <!-- ============================ Status ============================ -->

  <SolidColorBrush x:Key="Brush.Status.Error" Color="#E0705F" />
  <SolidColorBrush x:Key="Brush.Status.Error.Background" Color="#1A0F0D" />
  <SolidColorBrush x:Key="Brush.Status.Error.Border" Color="#402420" />
  <SolidColorBrush x:Key="Brush.Status.Info" Color="#6FA3C8" />
  <SolidColorBrush x:Key="Brush.Status.Info.Background" Color="#0D1318" />

  <!-- ============================ Scrollbars ============================ -->

  <SolidColorBrush x:Key="Brush.Scrollbar.Track" Color="#00000000" />
  <SolidColorBrush x:Key="Brush.Scrollbar.Thumb" Color="#333333" />
  <SolidColorBrush x:Key="Brush.Scrollbar.ThumbHover" Color="#666666" />

  <!-- ============================ Window chrome ============================ -->

  <LinearGradientBrush x:Key="Brush.TitleBar.Background" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#050505" Offset="0" />
    <GradientStop Color="#000000" Offset="1" />
  </LinearGradientBrush>

  <SolidColorBrush x:Key="Brush.Overlay.Scrim" Color="#D9000000" />

</ResourceDictionary>
