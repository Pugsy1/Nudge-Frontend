<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    Magenta Light palette - the same porcelain material as Colors.Light.xaml, with the accent
    recoloured from amber to a vivid pink-purple magenta, darkened enough to hold contrast on a white
    surface the same way Colors.Light.xaml darkens Colors.Dark.xaml's amber. Surfaces and controls are
    tinted magenta too, not left neutral - see Colors.JadeLight.xaml's own note on why a light theme
    needs that to actually read as coloured. See Colors.Magenta.xaml for the dark counterpart.
  -->

  <!-- ============================ Ground ============================ -->

  <RadialGradientBrush x:Key="Brush.Window.Background" GradientOrigin="0.5,0.28" Center="0.5,0.28" RadiusX="0.9" RadiusY="0.85">
    <GradientStop Color="#F7EEF7" Offset="0" />
    <GradientStop Color="#F1E3F1" Offset="0.75" />
    <GradientStop Color="#E9D5E9" Offset="1" />
  </RadialGradientBrush>

  <SolidColorBrush x:Key="Brush.Window.BackgroundFlat" Color="#F1E3F1" />

  <!-- ============================ Surfaces ============================ -->

  <LinearGradientBrush x:Key="Brush.Surface.Background" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#F7EEF7" Offset="0" />
    <GradientStop Color="#F1E3F1" Offset="1" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="Brush.Surface.BackgroundAlt" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#F1E3F1" Offset="0" />
    <GradientStop Color="#E9D5E9" Offset="1" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="Brush.Surface.Recessed" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#F1E3F1" Offset="0" />
    <GradientStop Color="#F7EEF7" Offset="1" />
  </LinearGradientBrush>

  <SolidColorBrush x:Key="Brush.Surface.Border" Color="#E9D5E9" />

  <SolidColorBrush x:Key="Brush.Surface.Glass" Color="#B3FFFFFF" />

  <LinearGradientBrush x:Key="Brush.Surface.EdgeHighlight" StartPoint="0.1,0" EndPoint="0.9,1">
    <GradientStop Color="#FFFFFF" Offset="0" />
    <GradientStop Color="#EFD9EF" Offset="0.45" />
    <GradientStop Color="#DCAEDD" Offset="1" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="Brush.Surface.RimLight" StartPoint="0.1,0" EndPoint="0.9,1">
    <GradientStop Color="#FFFFFF" Offset="0" />
    <GradientStop Color="#E6C3E7" Offset="0.5" />
    <GradientStop Color="#CC93CE" Offset="1" />
  </LinearGradientBrush>

  <Color x:Key="Color.Shadow">#96A0B4</Color>

  <Color x:Key="Color.Highlight">#FFFFFF</Color>

  <!-- ============================ Text ============================ -->

  <SolidColorBrush x:Key="Brush.Text.Primary" Color="#1B1F27" />
  <SolidColorBrush x:Key="Brush.Text.Secondary" Color="#535B6B" />
  <SolidColorBrush x:Key="Brush.Text.Muted" Color="#7C8494" />

  <!-- ============================ Accent ============================ -->

  <!-- Darker magenta than the dark palette's, so it holds contrast against a white surface. -->
  <SolidColorBrush x:Key="Brush.Accent" Color="#A03DA3" />
  <SolidColorBrush x:Key="Brush.Accent.Hover" Color="#B452B8" />
  <SolidColorBrush x:Key="Brush.Accent.Pressed" Color="#822F84" />
  <SolidColorBrush x:Key="Brush.Accent.Foreground" Color="#FFFFFF" />
  <SolidColorBrush x:Key="Brush.Accent.Subtle" Color="#F5E5F5" />

  <LinearGradientBrush x:Key="Brush.Accent.Surface" StartPoint="0,0" EndPoint="1,0">
    <GradientStop Color="#B452B8" Offset="0" />
    <GradientStop Color="#8B3390" Offset="1" />
  </LinearGradientBrush>

  <!-- ============================ Controls ============================ -->

  <LinearGradientBrush x:Key="Brush.Control.Background" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#FFFFFF" Offset="0" />
    <GradientStop Color="#F7EEF7" Offset="1" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="Brush.Control.BackgroundHover" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#FFFFFF" Offset="0" />
    <GradientStop Color="#FBF6FB" Offset="1" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="Brush.Control.BackgroundPressed" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#F1E3F1" Offset="0" />
    <GradientStop Color="#E9D5E9" Offset="1" />
  </LinearGradientBrush>

  <SolidColorBrush x:Key="Brush.Control.Border" Color="#E0C9E0" />
  <SolidColorBrush x:Key="Brush.Control.BorderHover" Color="#AE8CAF" />
  <SolidColorBrush x:Key="Brush.Control.Foreground" Color="#1B1F27" />
  <SolidColorBrush x:Key="Brush.Control.ForegroundDisabled" Color="#A8AEBB" />

  <SolidColorBrush x:Key="Brush.Focus" Color="#A03DA3" />

  <!-- ============================ Indicator LEDs ============================ -->

  <SolidColorBrush x:Key="Brush.Confidence.High" Color="#2A7A52" />
  <SolidColorBrush x:Key="Brush.Confidence.Medium" Color="#A03DA3" />
  <SolidColorBrush x:Key="Brush.Confidence.Low" Color="#A2512A" />
  <SolidColorBrush x:Key="Brush.Confidence.Unknown" Color="#6E7688" />

  <SolidColorBrush x:Key="Brush.Confidence.High.Background" Color="#E6F2EA" />
  <SolidColorBrush x:Key="Brush.Confidence.Medium.Background" Color="#F5E5F5" />
  <SolidColorBrush x:Key="Brush.Confidence.Low.Background" Color="#FAEDE5" />
  <SolidColorBrush x:Key="Brush.Confidence.Unknown.Background" Color="#ECEEF2" />

  <!-- ============================ Status ============================ -->

  <SolidColorBrush x:Key="Brush.Status.Error" Color="#B03A2C" />
  <SolidColorBrush x:Key="Brush.Status.Error.Background" Color="#FBEBE9" />
  <SolidColorBrush x:Key="Brush.Status.Error.Border" Color="#E5B7B1" />
  <SolidColorBrush x:Key="Brush.Status.Info" Color="#25618F" />
  <SolidColorBrush x:Key="Brush.Status.Info.Background" Color="#E8F0F7" />

  <!-- ============================ Scrollbars ============================ -->

  <SolidColorBrush x:Key="Brush.Scrollbar.Track" Color="#00000000" />
  <SolidColorBrush x:Key="Brush.Scrollbar.Thumb" Color="#D9BFDA" />
  <SolidColorBrush x:Key="Brush.Scrollbar.ThumbHover" Color="#AE8CAF" />

  <!-- ============================ Window chrome ============================ -->

  <LinearGradientBrush x:Key="Brush.TitleBar.Background" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#FBF3FB" Offset="0" />
    <GradientStop Color="#EFDFEF" Offset="1" />
  </LinearGradientBrush>

  <SolidColorBrush x:Key="Brush.Overlay.Scrim" Color="#D9EDEFF3" />

</ResourceDictionary>
