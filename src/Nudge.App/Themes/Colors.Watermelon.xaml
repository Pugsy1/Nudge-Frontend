<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    Watermelon palette - a DUAL-TONE theme, and the first of its kind here. Every other accent
    palette (Jade, Sapphire, Crimson...) recolours the accent to a single hue; this one carries two
    at once, the way the fruit does: pink-red flesh as the primary accent, rind green as the second
    tone. The two meet in Brush.Accent.Surface, which runs pink at the top into green at the bottom,
    so every raised accent surface (primary buttons, the 2D/VR cap, slider fills) shows both. The
    bevel and ambient ground lean green so the second tone is present across the whole room rather
    than only inside accent controls.

    See Colors.Dark.xaml for the underlying material language - surfaces, text and structure are
    unchanged from it.
  -->

  <!-- ============================ Ground ============================ -->

  <!-- A genuine two-tone wallpaper, not a single-hue ground with a radial hotspot in the middle -
       dark rose bleeding diagonally into dark rind green across the whole window, the same pairing
       Brush.Accent.Surface carries, just pulled all the way down to background darkness. Only two
       stops, straight from one hue to the other - an in-between stop of its own (an earlier pass
       had one) reads as two flat colour zones stuck together with a seam, rather than one continuous
       blend; letting the two real endpoints interpolate directly is what actually looks smooth. -->
  <LinearGradientBrush x:Key="Brush.Window.Background" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#271A1E" Offset="0" />
    <GradientStop Color="#17241C" Offset="1" />
  </LinearGradientBrush>

  <SolidColorBrush x:Key="Brush.Window.BackgroundFlat" Color="#1F1F1D" />

  <!-- ============================ Surfaces ============================ -->

  <LinearGradientBrush x:Key="Brush.Surface.Background" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#1E222C" Offset="0" />
    <GradientStop Color="#191D25" Offset="1" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="Brush.Surface.BackgroundAlt" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#222732" Offset="0" />
    <GradientStop Color="#1C202A" Offset="1" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="Brush.Surface.Recessed" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#13161D" Offset="0" />
    <GradientStop Color="#181C24" Offset="1" />
  </LinearGradientBrush>

  <SolidColorBrush x:Key="Brush.Surface.Border" Color="#2E3545" />

  <SolidColorBrush x:Key="Brush.Surface.Glass" Color="#B31E222C" />

  <!-- The bevel carries the second tone: green at the lit edge, falling to the usual dark. -->
  <LinearGradientBrush x:Key="Brush.Surface.EdgeHighlight" StartPoint="0.15,0" EndPoint="0.85,1">
    <GradientStop Color="#6FA37C" Offset="0" />
    <GradientStop Color="#374A3D" Offset="0.5" />
    <GradientStop Color="#0E1015" Offset="1" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="Brush.Surface.RimLight" StartPoint="0.15,0" EndPoint="0.85,1">
    <GradientStop Color="#8CC79B" Offset="0" />
    <GradientStop Color="#4C6B54" Offset="0.5" />
    <GradientStop Color="#14171D" Offset="1" />
  </LinearGradientBrush>

  <Color x:Key="Color.Shadow">#000000</Color>

  <!-- Tinted to the green half of the pairing, matching this palette's own RimLight. -->
  <Color x:Key="Color.Highlight">#6FA37C</Color>

  <!-- ============================ Text ============================ -->

  <SolidColorBrush x:Key="Brush.Text.Primary" Color="#EDEFF4" />
  <SolidColorBrush x:Key="Brush.Text.Secondary" Color="#A6ADBE" />
  <SolidColorBrush x:Key="Brush.Text.Muted" Color="#6E7688" />

  <!-- ============================ Accent ============================ -->

  <!-- Watermelon flesh: a soft pink-red, kept muted rather than candy-bright. -->
  <SolidColorBrush x:Key="Brush.Accent" Color="#EE6E7F" />
  <SolidColorBrush x:Key="Brush.Accent.Hover" Color="#F98795" />
  <SolidColorBrush x:Key="Brush.Accent.Pressed" Color="#D25666" />
  <SolidColorBrush x:Key="Brush.Accent.Foreground" Color="#241215" />
  <SolidColorBrush x:Key="Brush.Accent.Subtle" Color="#2A1A1D" />

  <!-- The dual tone itself: flesh pink into rind green, left to right. Horizontal, not the vertical
       axis an earlier pass used - Brush.Accent.Surface paints controls that are mostly wide and
       short (Button.Primary, the slider fill, the switch knob, the slider thumb - Controls.xaml), so
       a top-to-bottom gradient had almost no vertical room to actually blend in: a 22px switch knob
       or a 10px-tall slider fill compresses the whole transition into a handful of pixels, reading
       as a hard two-colour split rather than a gradient at all. Running the same two stops left to
       right instead gives it the button/bar's full width to blend across, which is where these
       controls actually have room. -->
  <LinearGradientBrush x:Key="Brush.Accent.Surface" StartPoint="0,0" EndPoint="1,0">
    <GradientStop Color="#F5808E" Offset="0" />
    <GradientStop Color="#5FA772" Offset="1" />
  </LinearGradientBrush>

  <!-- ============================ Controls ============================ -->

  <LinearGradientBrush x:Key="Brush.Control.Background" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#2A303E" Offset="0" />
    <GradientStop Color="#222835" Offset="1" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="Brush.Control.BackgroundHover" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#333A4A" Offset="0" />
    <GradientStop Color="#2A303E" Offset="1" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="Brush.Control.BackgroundPressed" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#171B23" Offset="0" />
    <GradientStop Color="#1F242F" Offset="1" />
  </LinearGradientBrush>

  <SolidColorBrush x:Key="Brush.Control.Border" Color="#333A4A" />
  <SolidColorBrush x:Key="Brush.Control.BorderHover" Color="#5A6479" />
  <SolidColorBrush x:Key="Brush.Control.Foreground" Color="#EDEFF4" />
  <SolidColorBrush x:Key="Brush.Control.ForegroundDisabled" Color="#5C6474" />

  <SolidColorBrush x:Key="Brush.Focus" Color="#EE6E7F" />

  <!-- ============================ Indicator LEDs ============================ -->

  <!-- High reuses the rind green, so the two tones both appear in the status lamps too. -->
  <SolidColorBrush x:Key="Brush.Confidence.High" Color="#5FA772" />
  <SolidColorBrush x:Key="Brush.Confidence.Medium" Color="#EE6E7F" />
  <SolidColorBrush x:Key="Brush.Confidence.Low" Color="#D4794F" />
  <SolidColorBrush x:Key="Brush.Confidence.Unknown" Color="#6E7688" />

  <SolidColorBrush x:Key="Brush.Confidence.High.Background" Color="#1A2A20" />
  <SolidColorBrush x:Key="Brush.Confidence.Medium.Background" Color="#2A1A1D" />
  <SolidColorBrush x:Key="Brush.Confidence.Low.Background" Color="#2A1E18" />
  <SolidColorBrush x:Key="Brush.Confidence.Unknown.Background" Color="#232936" />

  <!-- ============================ Status ============================ -->

  <SolidColorBrush x:Key="Brush.Status.Error" Color="#E0705F" />
  <SolidColorBrush x:Key="Brush.Status.Error.Background" Color="#2C1C1A" />
  <SolidColorBrush x:Key="Brush.Status.Error.Border" Color="#573330" />
  <SolidColorBrush x:Key="Brush.Status.Info" Color="#6FA3C8" />
  <SolidColorBrush x:Key="Brush.Status.Info.Background" Color="#1A222C" />

  <!-- ============================ Scrollbars ============================ -->

  <SolidColorBrush x:Key="Brush.Scrollbar.Track" Color="#00000000" />
  <SolidColorBrush x:Key="Brush.Scrollbar.Thumb" Color="#3B4354" />
  <SolidColorBrush x:Key="Brush.Scrollbar.ThumbHover" Color="#5A6479" />

  <!-- ============================ Window chrome ============================ -->

  <LinearGradientBrush x:Key="Brush.TitleBar.Background" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#1F2621" Offset="0" />
    <GradientStop Color="#171A18" Offset="1" />
  </LinearGradientBrush>

  <SolidColorBrush x:Key="Brush.Overlay.Scrim" Color="#D9141816" />

</ResourceDictionary>
