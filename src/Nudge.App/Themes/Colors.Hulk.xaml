<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    Hulk palette - unlike Jade/Sapphire/Crimson (Colors.Dark.xaml's exact structure, lightly
    tinted), this one is built to the 60/30/10 rule explicitly:

      60% Primary   - Brush.Window.Background: the dominant ground, a soft muted sage. Desaturated
                      on purpose - the *dominant* colour should stay calm, not shout.
      30% Secondary - Brush.Surface.*, Brush.Control.Background, Brush.TitleBar.Background: cards,
                      panels, the title bar - a deeper, more structural green-grey than the primary,
                      giving definition without competing with it.
      10% Accent    - Brush.Accent* and Brush.Focus only: the one vivid, saturated comic-green,
                      reserved strictly for buttons and active/interactive states. Text and status
                      colours (error/info) stay functional/neutral rather than joining the scheme -
                      legibility and semantic meaning aren't "decoration".
  -->

  <!-- ============================ Ground - 60% Primary ============================ -->

  <RadialGradientBrush x:Key="Brush.Window.Background" GradientOrigin="0.5,0.28" Center="0.5,0.28" RadiusX="0.9" RadiusY="0.85">
    <GradientStop Color="#26302A" Offset="0" />
    <GradientStop Color="#1D251F" Offset="0.75" />
    <GradientStop Color="#171E1A" Offset="1" />
  </RadialGradientBrush>

  <SolidColorBrush x:Key="Brush.Window.BackgroundFlat" Color="#1D251F" />

  <!-- ============================ Surfaces - 30% Secondary ============================ -->

  <LinearGradientBrush x:Key="Brush.Surface.Background" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#2E3A32" Offset="0" />
    <GradientStop Color="#26302A" Offset="1" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="Brush.Surface.BackgroundAlt" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#34423A" Offset="0" />
    <GradientStop Color="#2A362F" Offset="1" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="Brush.Surface.Recessed" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#161D18" Offset="0" />
    <GradientStop Color="#1E2721" Offset="1" />
  </LinearGradientBrush>

  <SolidColorBrush x:Key="Brush.Surface.Border" Color="#3A4A3F" />

  <SolidColorBrush x:Key="Brush.Surface.Glass" Color="#B32E3A32" />

  <LinearGradientBrush x:Key="Brush.Surface.EdgeHighlight" StartPoint="0.1,0" EndPoint="0.9,1">
    <GradientStop Color="#5A7862" Offset="0" />
    <GradientStop Color="#3E5245" Offset="0.45" />
    <GradientStop Color="#16201A" Offset="1" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="Brush.Surface.RimLight" StartPoint="0.1,0" EndPoint="0.9,1">
    <GradientStop Color="#7FA888" Offset="0" />
    <GradientStop Color="#4C6B54" Offset="0.5" />
    <GradientStop Color="#1D251F" Offset="1" />
  </LinearGradientBrush>

  <Color x:Key="Color.Shadow">#000000</Color>

  <!-- ============================ Text (functional, not part of the 60/30/10 scheme) ============================ -->

  <SolidColorBrush x:Key="Brush.Text.Primary" Color="#EDF2EE" />
  <SolidColorBrush x:Key="Brush.Text.Secondary" Color="#A8B8AC" />
  <SolidColorBrush x:Key="Brush.Text.Muted" Color="#71816F" />

  <!-- ============================ Accent - 10%, buttons and active states only ============================ -->

  <SolidColorBrush x:Key="Brush.Accent" Color="#57B84C" />
  <SolidColorBrush x:Key="Brush.Accent.Hover" Color="#6BCB5F" />
  <SolidColorBrush x:Key="Brush.Accent.Pressed" Color="#439A3A" />
  <SolidColorBrush x:Key="Brush.Accent.Foreground" Color="#0F1A10" />
  <SolidColorBrush x:Key="Brush.Accent.Subtle" Color="#1E2C1E" />

  <LinearGradientBrush x:Key="Brush.Accent.Surface" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#66C459" Offset="0" />
    <GradientStop Color="#4CA344" Offset="1" />
  </LinearGradientBrush>

  <!-- ============================ Controls - 30% Secondary ============================ -->

  <LinearGradientBrush x:Key="Brush.Control.Background" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#2E3A32" Offset="0" />
    <GradientStop Color="#263129" Offset="1" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="Brush.Control.BackgroundHover" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#37453D" Offset="0" />
    <GradientStop Color="#2E3A32" Offset="1" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="Brush.Control.BackgroundPressed" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#171F1A" Offset="0" />
    <GradientStop Color="#212B24" Offset="1" />
  </LinearGradientBrush>

  <SolidColorBrush x:Key="Brush.Control.Border" Color="#3A4A3F" />
  <SolidColorBrush x:Key="Brush.Control.BorderHover" Color="#5C7A66" />
  <SolidColorBrush x:Key="Brush.Control.Foreground" Color="#EDF2EE" />
  <SolidColorBrush x:Key="Brush.Control.ForegroundDisabled" Color="#5C6E60" />

  <!-- Focus is an active/interactive state, so it's accent, not secondary - per the 60/30/10 rule. -->
  <SolidColorBrush x:Key="Brush.Focus" Color="#57B84C" />

  <!-- ============================ Indicator LEDs ============================ -->

  <SolidColorBrush x:Key="Brush.Confidence.High" Color="#5FB98A" />
  <SolidColorBrush x:Key="Brush.Confidence.Medium" Color="#57B84C" />
  <SolidColorBrush x:Key="Brush.Confidence.Low" Color="#D4794F" />
  <SolidColorBrush x:Key="Brush.Confidence.Unknown" Color="#71816F" />

  <SolidColorBrush x:Key="Brush.Confidence.High.Background" Color="#1A2A22" />
  <SolidColorBrush x:Key="Brush.Confidence.Medium.Background" Color="#1E2C1E" />
  <SolidColorBrush x:Key="Brush.Confidence.Low.Background" Color="#2A2018" />
  <SolidColorBrush x:Key="Brush.Confidence.Unknown.Background" Color="#26312A" />

  <!-- ============================ Status (functional, not part of the 60/30/10 scheme) ============================ -->

  <SolidColorBrush x:Key="Brush.Status.Error" Color="#E0705F" />
  <SolidColorBrush x:Key="Brush.Status.Error.Background" Color="#2C1E1A" />
  <SolidColorBrush x:Key="Brush.Status.Error.Border" Color="#57352F" />
  <SolidColorBrush x:Key="Brush.Status.Info" Color="#6FA3C8" />
  <SolidColorBrush x:Key="Brush.Status.Info.Background" Color="#1A242C" />

  <!-- ============================ Scrollbars - 30% Secondary ============================ -->

  <SolidColorBrush x:Key="Brush.Scrollbar.Track" Color="#00000000" />
  <SolidColorBrush x:Key="Brush.Scrollbar.Thumb" Color="#3E5245" />
  <SolidColorBrush x:Key="Brush.Scrollbar.ThumbHover" Color="#5C7A66" />

  <!-- ============================ Window chrome - 30% Secondary ============================ -->

  <LinearGradientBrush x:Key="Brush.TitleBar.Background" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#222C26" Offset="0" />
    <GradientStop Color="#1A221D" Offset="1" />
  </LinearGradientBrush>

  <SolidColorBrush x:Key="Brush.Overlay.Scrim" Color="#D9171E1A" />

</ResourceDictionary>
