<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    Slate palette - the same dark material as Colors.Dark.xaml, with the accent recoloured from warm
    amber to a cool blue-grey slate. Distinct from Colors.Chrome.xaml's genuine polished-metal
    reflection gradient and from Colors.Sapphire.xaml's saturated blue - this is a desaturated,
    quiet blue-grey hue rather than either a metal or a vivid colour. See Colors.Dark.xaml for the
    material language; only the "Accent" section and Confidence.Medium (which reuses the accent, same
    as the Dark palette does) differ from it.
  -->

  <!-- ============================ Ground ============================ -->

  <RadialGradientBrush x:Key="Brush.Window.Background" GradientOrigin="0.5,0.28" Center="0.5,0.28" RadiusX="0.9" RadiusY="0.85">
    <GradientStop Color="#1C2126" Offset="0" />
    <GradientStop Color="#161A1E" Offset="0.75" />
    <GradientStop Color="#111417" Offset="1" />
  </RadialGradientBrush>

  <SolidColorBrush x:Key="Brush.Window.BackgroundFlat" Color="#171B1F" />

  <!-- ============================ Surfaces ============================ -->

  <LinearGradientBrush x:Key="Brush.Surface.Background" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#1E222C" Offset="0" />
    <GradientStop Color="#191D25" Offset="1" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="Brush.Surface.BackgroundAlt" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#222732" Offset="0" />
    <GradientStop Color="#1C202A" Offset="1" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="Brush.Surface.Recessed" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#13161D" Offset="0" />
    <GradientStop Color="#181C24" Offset="1" />
  </LinearGradientBrush>

  <SolidColorBrush x:Key="Brush.Surface.Border" Color="#333C45" />

  <SolidColorBrush x:Key="Brush.Surface.Glass" Color="#B31E222C" />

  <LinearGradientBrush x:Key="Brush.Surface.EdgeHighlight" StartPoint="0.15,0" EndPoint="0.85,1">
    <GradientStop Color="#8CA0B3" Offset="0" />
    <GradientStop Color="#404B54" Offset="0.5" />
    <GradientStop Color="#0E1015" Offset="1" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="Brush.Surface.RimLight" StartPoint="0.15,0" EndPoint="0.85,1">
    <GradientStop Color="#A9BBCC" Offset="0" />
    <GradientStop Color="#5F6F7D" Offset="0.5" />
    <GradientStop Color="#14171D" Offset="1" />
  </LinearGradientBrush>

  <Color x:Key="Color.Shadow">#000000</Color>

  <!-- The soft light-catch a neumorphic surface needs on its raised (top-left) side - see the note
       in Colors.Dark.xaml. Tinted slate, matching this palette's own RimLight. -->
  <Color x:Key="Color.Highlight">#8CA0B3</Color>

  <!-- ============================ Text ============================ -->

  <SolidColorBrush x:Key="Brush.Text.Primary" Color="#EDEFF4" />
  <SolidColorBrush x:Key="Brush.Text.Secondary" Color="#A6ADBE" />
  <SolidColorBrush x:Key="Brush.Text.Muted" Color="#6E7688" />

  <!-- ============================ Accent ============================ -->

  <!-- A quiet, desaturated blue-grey slate - deliberately calm rather than a vivid colour. -->
  <SolidColorBrush x:Key="Brush.Accent" Color="#7387A0" />
  <SolidColorBrush x:Key="Brush.Accent.Hover" Color="#869AB3" />
  <SolidColorBrush x:Key="Brush.Accent.Pressed" Color="#5D6F86" />
  <SolidColorBrush x:Key="Brush.Accent.Foreground" Color="#10151A" />
  <SolidColorBrush x:Key="Brush.Accent.Subtle" Color="#1A2027" />

  <LinearGradientBrush x:Key="Brush.Accent.Surface" StartPoint="0,0" EndPoint="1,0">
    <GradientStop Color="#869AB3" Offset="0" />
    <GradientStop Color="#657790" Offset="1" />
  </LinearGradientBrush>

  <!-- ============================ Controls ============================ -->

  <LinearGradientBrush x:Key="Brush.Control.Background" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#2A303E" Offset="0" />
    <GradientStop Color="#222835" Offset="1" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="Brush.Control.BackgroundHover" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#333A4A" Offset="0" />
    <GradientStop Color="#2A303E" Offset="1" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="Brush.Control.BackgroundPressed" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#171B23" Offset="0" />
    <GradientStop Color="#1F242F" Offset="1" />
  </LinearGradientBrush>

  <SolidColorBrush x:Key="Brush.Control.Border" Color="#333A4A" />
  <SolidColorBrush x:Key="Brush.Control.BorderHover" Color="#5A6479" />
  <SolidColorBrush x:Key="Brush.Control.Foreground" Color="#EDEFF4" />
  <SolidColorBrush x:Key="Brush.Control.ForegroundDisabled" Color="#5C6474" />

  <SolidColorBrush x:Key="Brush.Focus" Color="#7387A0" />

  <!-- ============================ Indicator LEDs ============================ -->

  <SolidColorBrush x:Key="Brush.Confidence.High" Color="#5FB98A" />
  <SolidColorBrush x:Key="Brush.Confidence.Medium" Color="#7387A0" />
  <SolidColorBrush x:Key="Brush.Confidence.Low" Color="#D4794F" />
  <SolidColorBrush x:Key="Brush.Confidence.Unknown" Color="#6E7688" />

  <SolidColorBrush x:Key="Brush.Confidence.High.Background" Color="#1A2A22" />
  <SolidColorBrush x:Key="Brush.Confidence.Medium.Background" Color="#1A2027" />
  <SolidColorBrush x:Key="Brush.Confidence.Low.Background" Color="#2A1E18" />
  <SolidColorBrush x:Key="Brush.Confidence.Unknown.Background" Color="#232936" />

  <!-- ============================ Status ============================ -->

  <SolidColorBrush x:Key="Brush.Status.Error" Color="#E0705F" />
  <SolidColorBrush x:Key="Brush.Status.Error.Background" Color="#2C1C1A" />
  <SolidColorBrush x:Key="Brush.Status.Error.Border" Color="#573330" />
  <SolidColorBrush x:Key="Brush.Status.Info" Color="#6FA3C8" />
  <SolidColorBrush x:Key="Brush.Status.Info.Background" Color="#1A222C" />

  <!-- ============================ Scrollbars ============================ -->

  <SolidColorBrush x:Key="Brush.Scrollbar.Track" Color="#00000000" />
  <SolidColorBrush x:Key="Brush.Scrollbar.Thumb" Color="#3D4750" />
  <SolidColorBrush x:Key="Brush.Scrollbar.ThumbHover" Color="#5A6479" />

  <!-- ============================ Window chrome ============================ -->

  <LinearGradientBrush x:Key="Brush.TitleBar.Background" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#1F252A" Offset="0" />
    <GradientStop Color="#171B1F" Offset="1" />
  </LinearGradientBrush>

  <SolidColorBrush x:Key="Brush.Overlay.Scrim" Color="#D9121619" />

</ResourceDictionary>
