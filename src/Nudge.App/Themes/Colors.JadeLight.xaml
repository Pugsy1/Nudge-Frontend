<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    Jade Light palette - the same porcelain material as Colors.Light.xaml (surfaces, text,
    structure all identical), with the accent recoloured from amber to the Jade palette's green,
    darkened enough to hold contrast on a white surface the same way Colors.Light.xaml darkens
    Colors.Dark.xaml's amber. See Colors.Jade.xaml for the dark counterpart this pairs with.
  -->

  <!-- ============================ Ground ============================ -->

  <!-- Tinted toward jade, unlike the neutral-grey Light palette's ambient glow - the light-mode
       equivalent of Colors.Jade.xaml's coloured ground. -->
  <RadialGradientBrush x:Key="Brush.Window.Background" GradientOrigin="0.5,0.28" Center="0.5,0.28" RadiusX="0.9" RadiusY="0.85">
    <GradientStop Color="#EEF5F1" Offset="0" />
    <GradientStop Color="#E4EEE8" Offset="0.75" />
    <GradientStop Color="#D9E5DF" Offset="1" />
  </RadialGradientBrush>

  <SolidColorBrush x:Key="Brush.Window.BackgroundFlat" Color="#E4EEE8" />

  <!-- ============================ Surfaces ============================ -->

  <!-- Tinted jade, not the generic blue-grey Colors.Light.xaml uses - a light theme with an
       untinted card surface under a barely-tinted wallpaper reads as "white app, green button" far
       more than the dark palette's equivalent ever does, since near-white leaves so little room for
       a cast to actually show. Reusing Window.Background's own three stops here (rather than
       inventing new colours) keeps every surface in the room on the exact same hue. -->
  <LinearGradientBrush x:Key="Brush.Surface.Background" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#EEF5F1" Offset="0" />
    <GradientStop Color="#E4EEE8" Offset="1" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="Brush.Surface.BackgroundAlt" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#E4EEE8" Offset="0" />
    <GradientStop Color="#D9E5DF" Offset="1" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="Brush.Surface.Recessed" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#E4EEE8" Offset="0" />
    <GradientStop Color="#EEF5F1" Offset="1" />
  </LinearGradientBrush>

  <SolidColorBrush x:Key="Brush.Surface.Border" Color="#D9E5DF" />

  <SolidColorBrush x:Key="Brush.Surface.Glass" Color="#B3FFFFFF" />

  <LinearGradientBrush x:Key="Brush.Surface.EdgeHighlight" StartPoint="0.1,0" EndPoint="0.9,1">
    <GradientStop Color="#FFFFFF" Offset="0" />
    <GradientStop Color="#DDEBE3" Offset="0.45" />
    <GradientStop Color="#B7CFC2" Offset="1" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="Brush.Surface.RimLight" StartPoint="0.1,0" EndPoint="0.9,1">
    <GradientStop Color="#FFFFFF" Offset="0" />
    <GradientStop Color="#CFE6DA" Offset="0.5" />
    <GradientStop Color="#9BC1AC" Offset="1" />
  </LinearGradientBrush>

  <Color x:Key="Color.Shadow">#96A0B4</Color>

  <!-- The soft light-catch a neumorphic surface needs on its raised (top-left) side - see the note
       in Colors.Dark.xaml. -->
  <Color x:Key="Color.Highlight">#FFFFFF</Color>

  <!-- ============================ Text ============================ -->

  <SolidColorBrush x:Key="Brush.Text.Primary" Color="#1B1F27" />
  <SolidColorBrush x:Key="Brush.Text.Secondary" Color="#535B6B" />
  <SolidColorBrush x:Key="Brush.Text.Muted" Color="#7C8494" />

  <!-- ============================ Accent ============================ -->

  <!-- Darker jade than the dark palette's, so it holds contrast against a white surface. -->
  <SolidColorBrush x:Key="Brush.Accent" Color="#2E8F68" />
  <SolidColorBrush x:Key="Brush.Accent.Hover" Color="#3AA378" />
  <SolidColorBrush x:Key="Brush.Accent.Pressed" Color="#22714F" />
  <SolidColorBrush x:Key="Brush.Accent.Foreground" Color="#FFFFFF" />
  <SolidColorBrush x:Key="Brush.Accent.Subtle" Color="#E7F5EE" />

  <LinearGradientBrush x:Key="Brush.Accent.Surface" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#3AA378" Offset="0" />
    <GradientStop Color="#256F4E" Offset="1" />
  </LinearGradientBrush>

  <!-- ============================ Controls ============================ -->

  <LinearGradientBrush x:Key="Brush.Control.Background" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#FFFFFF" Offset="0" />
    <GradientStop Color="#EEF5F1" Offset="1" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="Brush.Control.BackgroundHover" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#FFFFFF" Offset="0" />
    <GradientStop Color="#F6FAF8" Offset="1" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="Brush.Control.BackgroundPressed" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#E4EEE8" Offset="0" />
    <GradientStop Color="#D9E5DF" Offset="1" />
  </LinearGradientBrush>

  <SolidColorBrush x:Key="Brush.Control.Border" Color="#D2D6DF" />
  <SolidColorBrush x:Key="Brush.Control.BorderHover" Color="#9BA3B4" />
  <SolidColorBrush x:Key="Brush.Control.Foreground" Color="#1B1F27" />
  <SolidColorBrush x:Key="Brush.Control.ForegroundDisabled" Color="#A8AEBB" />

  <SolidColorBrush x:Key="Brush.Focus" Color="#2E8F68" />

  <!-- ============================ Indicator LEDs ============================ -->

  <SolidColorBrush x:Key="Brush.Confidence.High" Color="#2A7A52" />
  <SolidColorBrush x:Key="Brush.Confidence.Medium" Color="#2E8F68" />
  <SolidColorBrush x:Key="Brush.Confidence.Low" Color="#A2512A" />
  <SolidColorBrush x:Key="Brush.Confidence.Unknown" Color="#6E7688" />

  <SolidColorBrush x:Key="Brush.Confidence.High.Background" Color="#E6F2EA" />
  <SolidColorBrush x:Key="Brush.Confidence.Medium.Background" Color="#E7F5EE" />
  <SolidColorBrush x:Key="Brush.Confidence.Low.Background" Color="#FAEDE5" />
  <SolidColorBrush x:Key="Brush.Confidence.Unknown.Background" Color="#ECEEF2" />

  <!-- ============================ Status ============================ -->

  <SolidColorBrush x:Key="Brush.Status.Error" Color="#B03A2C" />
  <SolidColorBrush x:Key="Brush.Status.Error.Background" Color="#FBEBE9" />
  <SolidColorBrush x:Key="Brush.Status.Error.Border" Color="#E5B7B1" />
  <SolidColorBrush x:Key="Brush.Status.Info" Color="#25618F" />
  <SolidColorBrush x:Key="Brush.Status.Info.Background" Color="#E8F0F7" />

  <!-- ============================ Scrollbars ============================ -->

  <SolidColorBrush x:Key="Brush.Scrollbar.Track" Color="#00000000" />
  <SolidColorBrush x:Key="Brush.Scrollbar.Thumb" Color="#C2C8D4" />
  <SolidColorBrush x:Key="Brush.Scrollbar.ThumbHover" Color="#9BA3B4" />

  <!-- ============================ Window chrome ============================ -->

  <LinearGradientBrush x:Key="Brush.TitleBar.Background" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#F0F6F2" Offset="0" />
    <GradientStop Color="#E1ECE5" Offset="1" />
  </LinearGradientBrush>

  <SolidColorBrush x:Key="Brush.Overlay.Scrim" Color="#D9EDEFF3" />

</ResourceDictionary>
