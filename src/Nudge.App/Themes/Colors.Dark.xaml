<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    Dark palette - calm, spacious modern skeuomorphism.

    The look suggests a real material: a satin-finish panel, subtly lit from above. Surfaces carry
    a faint vertical gradient (the satin sheen), a bright top-left edge falling to a dark
    bottom-right edge (the bevel), and low-intensity rim lighting along the lit edge. Contrast
    stays low throughout - depth comes from the lighting, not from strong tonal separation.

    Every key defined here must also be defined in Colors.Light.xaml. Views only ever reference
    these semantic names, never a literal colour, so swapping this file for the light one is the
    entire theme switch.
  -->

  <!-- ============================ Ground ============================ -->

  <!--
    Deep slate graphite with a faint ambient glow behind the content, as though a soft light sits
    above and behind the app. Very low contrast on purpose: it should read as depth in the room,
    not as a visible gradient.
  -->
  <RadialGradientBrush x:Key="Brush.Window.Background" GradientOrigin="0.5,0.28" Center="0.5,0.28" RadiusX="0.9" RadiusY="0.85">
    <GradientStop Color="#1E222C" Offset="0" />
    <GradientStop Color="#161920" Offset="0.75" />
    <GradientStop Color="#121419" Offset="1" />
  </RadialGradientBrush>

  <SolidColorBrush x:Key="Brush.Window.BackgroundFlat" Color="#161920" />

  <!-- ============================ Surfaces ============================ -->

  <!--
    A raised satin panel. The gradient is the material's sheen - light catches the top face and
    falls away toward the bottom. Kept within a few percent of luminance: a strong gradient reads
    as "a gradient", a faint one reads as "a surface".
  -->
  <LinearGradientBrush x:Key="Brush.Surface.Background" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#252A36" Offset="0" />
    <GradientStop Color="#1E2229" Offset="1" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="Brush.Surface.BackgroundAlt" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#2A303E" Offset="0" />
    <GradientStop Color="#232936" Offset="1" />
  </LinearGradientBrush>

  <!-- A recessed slot - the sheen inverts, darker at the top where the lip casts into it. -->
  <LinearGradientBrush x:Key="Brush.Surface.Recessed" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#12151C" Offset="0" />
    <GradientStop Color="#1A1E27" Offset="1" />
  </LinearGradientBrush>

  <SolidColorBrush x:Key="Brush.Surface.Border" Color="#2E3545" />

  <!-- Frosted glass: a translucent panel letting the ambient glow through behind it. -->
  <SolidColorBrush x:Key="Brush.Surface.Glass" Color="#B32A303E" />

  <!--
    The bevel. One border brush doing two jobs: a bright top-left edge where light lands, and a
    dark bottom-right edge falling into shadow. Cheaper than stacking two elements per surface,
    which matters at 1,000 tiles (see AGENTS.md section 8).
  -->
  <LinearGradientBrush x:Key="Brush.Surface.EdgeHighlight" StartPoint="0.1,0" EndPoint="0.9,1">
    <GradientStop Color="#4A5468" Offset="0" />
    <GradientStop Color="#333A4A" Offset="0.45" />
    <GradientStop Color="#191D26" Offset="1" />
  </LinearGradientBrush>

  <!-- A brighter rim light, used on hover so a card feels lifted toward the light. -->
  <LinearGradientBrush x:Key="Brush.Surface.RimLight" StartPoint="0.1,0" EndPoint="0.9,1">
    <GradientStop Color="#6B7589" Offset="0" />
    <GradientStop Color="#3E4658" Offset="0.5" />
    <GradientStop Color="#1E2229" Offset="1" />
  </LinearGradientBrush>

  <!-- Shadows. Pure black; DropShadowEffect.Opacity does the softening. -->
  <Color x:Key="Color.Shadow">#000000</Color>

  <!-- ============================ Text ============================ -->

  <SolidColorBrush x:Key="Brush.Text.Primary" Color="#EDEFF4" />
  <SolidColorBrush x:Key="Brush.Text.Secondary" Color="#A6ADBE" />
  <SolidColorBrush x:Key="Brush.Text.Muted" Color="#6E7688" />

  <!-- ============================ Accent ============================ -->

  <!-- Muted warm amber - lamp-lit brass, not a neon highlighter. -->
  <SolidColorBrush x:Key="Brush.Accent" Color="#D9A05B" />
  <SolidColorBrush x:Key="Brush.Accent.Hover" Color="#E8B472" />
  <SolidColorBrush x:Key="Brush.Accent.Pressed" Color="#B88343" />
  <SolidColorBrush x:Key="Brush.Accent.Foreground" Color="#20180C" />
  <SolidColorBrush x:Key="Brush.Accent.Subtle" Color="#2A2418" />

  <!-- The amber surface gets a satin sheen too, so it reads as a lit brass cap. -->
  <LinearGradientBrush x:Key="Brush.Accent.Surface" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#E3AE68" Offset="0" />
    <GradientStop Color="#C8904E" Offset="1" />
  </LinearGradientBrush>

  <!-- ============================ Controls ============================ -->

  <LinearGradientBrush x:Key="Brush.Control.Background" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#2A303E" Offset="0" />
    <GradientStop Color="#222835" Offset="1" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="Brush.Control.BackgroundHover" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#333A4A" Offset="0" />
    <GradientStop Color="#2A303E" Offset="1" />
  </LinearGradientBrush>

  <!-- Pressed inverts the sheen: the top face is now the one in shadow. -->
  <LinearGradientBrush x:Key="Brush.Control.BackgroundPressed" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#171B23" Offset="0" />
    <GradientStop Color="#1F242F" Offset="1" />
  </LinearGradientBrush>

  <SolidColorBrush x:Key="Brush.Control.Border" Color="#333A4A" />
  <SolidColorBrush x:Key="Brush.Control.BorderHover" Color="#5A6479" />
  <SolidColorBrush x:Key="Brush.Control.Foreground" Color="#EDEFF4" />
  <SolidColorBrush x:Key="Brush.Control.ForegroundDisabled" Color="#5C6474" />

  <SolidColorBrush x:Key="Brush.Focus" Color="#D9A05B" />

  <!-- ============================ Indicator LEDs ============================ -->

  <!--
    Status lamps rather than flat status fills - low intensity, as though a dim LED sits behind a
    diffuser. Used for the health/confidence dot on a tile.
  -->
  <SolidColorBrush x:Key="Brush.Confidence.High" Color="#5FB98A" />
  <SolidColorBrush x:Key="Brush.Confidence.Medium" Color="#D9A05B" />
  <SolidColorBrush x:Key="Brush.Confidence.Low" Color="#D4794F" />
  <SolidColorBrush x:Key="Brush.Confidence.Unknown" Color="#6E7688" />

  <SolidColorBrush x:Key="Brush.Confidence.High.Background" Color="#1A2A22" />
  <SolidColorBrush x:Key="Brush.Confidence.Medium.Background" Color="#2A2418" />
  <SolidColorBrush x:Key="Brush.Confidence.Low.Background" Color="#2A1E18" />
  <SolidColorBrush x:Key="Brush.Confidence.Unknown.Background" Color="#232936" />

  <!-- ============================ Status ============================ -->

  <SolidColorBrush x:Key="Brush.Status.Error" Color="#E0705F" />
  <SolidColorBrush x:Key="Brush.Status.Error.Background" Color="#2C1C1A" />
  <SolidColorBrush x:Key="Brush.Status.Error.Border" Color="#573330" />
  <SolidColorBrush x:Key="Brush.Status.Info" Color="#6FA3C8" />
  <SolidColorBrush x:Key="Brush.Status.Info.Background" Color="#1A222C" />

  <!-- ============================ Scrollbars ============================ -->

  <SolidColorBrush x:Key="Brush.Scrollbar.Track" Color="#00000000" />
  <SolidColorBrush x:Key="Brush.Scrollbar.Thumb" Color="#3B4354" />
  <SolidColorBrush x:Key="Brush.Scrollbar.ThumbHover" Color="#5A6479" />

  <!-- ============================ Window chrome ============================ -->

  <LinearGradientBrush x:Key="Brush.TitleBar.Background" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#1F232D" Offset="0" />
    <GradientStop Color="#171A22" Offset="1" />
  </LinearGradientBrush>

  <!-- A dimming scrim over the grid while a table is launching. -->
  <SolidColorBrush x:Key="Brush.Overlay.Scrim" Color="#D9121419" />

</ResourceDictionary>
