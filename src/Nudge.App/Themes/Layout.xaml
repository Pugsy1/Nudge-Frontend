<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=System.Runtime">

  <!--
    Spacing scale and shapes. Every margin, padding, corner radius and border thickness in a view
    comes from here, so spacing stays consistent and can be adjusted in one place.

    The scale is a 4px grid: 4, 8, 12, 16, 24, 32, 48. The larger steps carry most of the layout in
    this design - the brief is calm and spacious, so page padding and grid gutters deliberately sit
    at the top of the scale rather than the middle.
  -->

  <system:Double x:Key="Space.XS">4</system:Double>
  <system:Double x:Key="Space.S">8</system:Double>
  <system:Double x:Key="Space.M">12</system:Double>
  <system:Double x:Key="Space.L">16</system:Double>
  <system:Double x:Key="Space.XL">24</system:Double>
  <system:Double x:Key="Space.XXL">32</system:Double>
  <system:Double x:Key="Space.XXXL">48</system:Double>

  <!-- Uniform insets -->
  <Thickness x:Key="Inset.XS">4</Thickness>
  <Thickness x:Key="Inset.S">8</Thickness>
  <Thickness x:Key="Inset.M">12</Thickness>
  <Thickness x:Key="Inset.L">16</Thickness>
  <Thickness x:Key="Inset.XL">24</Thickness>
  <Thickness x:Key="Inset.XXL">32</Thickness>

  <!-- Directional gaps, used as margins between stacked or inline elements -->
  <Thickness x:Key="Gap.Below.XS">0,0,0,4</Thickness>
  <Thickness x:Key="Gap.Below.S">0,0,0,8</Thickness>
  <Thickness x:Key="Gap.Below.M">0,0,0,12</Thickness>
  <Thickness x:Key="Gap.Below.L">0,0,0,16</Thickness>
  <Thickness x:Key="Gap.Below.XL">0,0,0,24</Thickness>
  <Thickness x:Key="Gap.Above.S">0,8,0,0</Thickness>
  <Thickness x:Key="Gap.Above.M">0,12,0,0</Thickness>
  <Thickness x:Key="Gap.Above.L">0,16,0,0</Thickness>
  <Thickness x:Key="Gap.Above.XL">0,24,0,0</Thickness>
  <Thickness x:Key="Gap.Right.S">0,0,8,0</Thickness>
  <Thickness x:Key="Gap.Right.M">0,0,12,0</Thickness>
  <Thickness x:Key="Gap.Right.L">0,0,16,0</Thickness>

  <!-- Component-specific padding. Generous by design - see the note on the scale above. -->
  <Thickness x:Key="Padding.Page">40,32,40,32</Thickness>

  <!-- The header bar itself (logo/title + controls, on Library/Settings/Setup) - same horizontal
       inset as Padding.Page, but less top/bottom, since that bar reads as thick/heavy with the full
       page padding: the logo already sets its own visual weight, so the bar around it doesn't need
       as much breathing room as a full page of content does. Top specifically stays taller than
       bottom - not fully trimmed to match - because the window always launches in true fullscreen
       (MainWindow.xaml.cs), where MainWindow.xaml's FullscreenCornerControls float over this exact
       corner; less clearance than this let the two visibly collide. -->
  <Thickness x:Key="Padding.Header">40,26,40,16</Thickness>
  <Thickness x:Key="Padding.Grid">32,8,32,32</Thickness>
  <Thickness x:Key="Padding.Card">26</Thickness>
  <Thickness x:Key="Padding.Button">18,11,18,11</Thickness>
  <Thickness x:Key="Padding.TableCell">14,10,14,12</Thickness>
  <Thickness x:Key="Padding.Badge">8,3,8,3</Thickness>
  <Thickness x:Key="Padding.Flyout">20</Thickness>

  <!-- Borders -->
  <Thickness x:Key="BorderThickness.Thin">1</Thickness>
  <Thickness x:Key="BorderThickness.Bottom">0,0,0,1</Thickness>
  <Thickness x:Key="BorderThickness.Left.Accent">3,0,0,0</Thickness>

  <!-- The keyboard/controller focus outline. Deliberately heavier than a hairline: across a room,
       on a cabinet, one pixel is not enough to tell you where you are. It costs no layout - see the
       FocusRing styles in Controls.xaml, which draw it as an overlay rather than as a real border. -->
  <Thickness x:Key="BorderThickness.Focus">2</Thickness>

  <!-- For a control that has been not just landed on but ENTERED - the density slider in adjust
       mode. Heavier than plain focus so the two states are told apart at a glance. -->
  <Thickness x:Key="BorderThickness.Focus.Strong">3</Thickness>

  <!-- A library tile's own outline: no top/bottom border at all, only left/right - since the
       top/bottom edges of every tile in a row line up into one continuous horizontal seam across
       the whole grid, where even a thin one reads as a much heavier line than intended. A
       fractional thickness (e.g. 0.6) was tried first, but that's exactly the kind of value that
       renders inconsistently sub-pixel-to-sub-pixel - and doubly so once the tile's hover
       ScaleTransform is animating it, which shimmered/glitched as the sub-pixel alignment shifted
       every frame. 0 has no such ambiguity. -->
  <Thickness x:Key="BorderThickness.Tile">1,0,1,0</Thickness>

  <!-- Rounder than the original scale, on purpose - soft, pillowy corners are the single biggest
       ingredient in reading as neumorphic "soft UI" rather than flat material design. Bumped again
       for the clean-neumorphic pass, chasing the fully-pill controls and large-radius cards in the
       reference boards (calendar/booking widgets, smart-home panel, light "Aa" component sheet). -->
  <CornerRadius x:Key="CornerRadius.S">16</CornerRadius>
  <CornerRadius x:Key="CornerRadius.M">24</CornerRadius>
  <CornerRadius x:Key="CornerRadius.L">32</CornerRadius>

  <!-- "Fully round this, whatever size it is." Deliberately oversized: WPF clamps a Border's
       CornerRadius to half its own smaller dimension, so this always resolves to the maximum
       possible curve. Reserved for elements that are square or genuinely short - icon buttons and
       tile overlay buttons (which become true circles), the switch knob and track, the 2D/VR track
       and its sliding cap, and scrollbar thumbs.

       NOT for wide elements: a 96x40 text button under this rule is a stretched lozenge, not a
       circle - the "too ovally" look. Those use CornerRadius.Button instead. -->
  <CornerRadius x:Key="CornerRadius.Pill">999</CornerRadius>

  <!-- Wide controls whose width far exceeds their height - text buttons, the search field, the
       theme dropdown's closed cap. A fixed, moderate curve keeps them reading as a soft rounded
       rectangle; going fully round only stretches the semicircular end caps into an oval. -->
  <CornerRadius x:Key="CornerRadius.Button">14</CornerRadius>

  <!-- Rounds only the top corners, matching CornerRadius.M, for a tile's artwork area so it reads
       as one continuous rounded shape with the card around it. -->
  <CornerRadius x:Key="CornerRadius.Card.Top">24,24,0,0</CornerRadius>

  <!-- The complementary bottom-only rounding, for a tile's title band tint layer sitting under the
       artwork's Card.Top. -->
  <CornerRadius x:Key="CornerRadius.Card.Bottom">0,0,24,24</CornerRadius>

  <!-- Half of Size.Scrollbar, so the thumb's ends are always fully rounded. -->
  <CornerRadius x:Key="CornerRadius.Scrollbar">2</CornerRadius>

  <!-- Fixed dimensions -->
  <system:Double x:Key="Size.Scrollbar">4</system:Double>
  <system:Double x:Key="Size.MinButtonWidth">84</system:Double>
  <system:Double x:Key="Size.IconButton">38</system:Double>
  <system:Double x:Key="Size.Window.MinWidth">940</system:Double>
  <system:Double x:Key="Size.Window.MinHeight">600</system:Double>
  <system:Double x:Key="Size.Window.Width">1180</system:Double>
  <system:Double x:Key="Size.Window.Height">780</system:Double>

  <!--
    The library grid. Tiles are wide and breathable, with a loose gutter (Margin.Tile is applied on
    all four sides of every tile, so the visible gap between two tiles is twice this).
  -->
  <!-- Taller than a first pass at this size (296) - vps-db artwork is strongly portrait (mostly
       270x480, roughly a 9:16 playfield shot), and the shorter card forced UniformToFill to crop
       heavily off the top and bottom of nearly every table's artwork to fill a squarer box. Sized
       up so the artwork area alone comes much closer to that same portrait ratio, at the cost of a
       taller tile overall - a direct trade in favour of showing more of the actual table. -->
  <system:Double x:Key="Size.Tile.Width">208</system:Double>
  <system:Double x:Key="Size.Tile.Height">380</system:Double>
  <system:Double x:Key="Size.Tile.TitleHeight">36</system:Double>
  <Thickness x:Key="Margin.Tile">10</Thickness>

  <!-- The Compact layout's own tile size - the same TableCard visual (LibraryView.xaml reuses it
       verbatim), just scaled down to roughly the same width:height ratio as Size.Tile.Width/Height
       so it still reads as "the same card, smaller" rather than a differently-proportioned one. -->
  <system:Double x:Key="Size.Tile.CompactWidth">140</system:Double>
  <system:Double x:Key="Size.Tile.CompactHeight">255</system:Double>
  <Thickness x:Key="Margin.Tile.Compact">6</Thickness>

  <!-- How far a tile scales up on hover. Small on purpose - a lift, not a jump. -->
  <system:Double x:Key="Scale.Tile.Hover">1.035</system:Double>

  <system:Double x:Key="Size.SearchBox.Width">260</system:Double>
  <Thickness x:Key="Padding.SearchBox">32,8,14,8</Thickness>

  <!-- Insets the scrollbar from the content edges so it reads as a short floating pill. Top is
       noticeably more than the other three sides so it starts clear of the fullscreen corner
       controls (MainWindow.xaml) - the top of the grid's ScrollViewer sits close enough to the top
       of the window that the scrollbar's own top end could otherwise land right underneath them. -->
  <Thickness x:Key="Margin.Scrollbar">0,36,6,16</Thickness>

  <!-- Custom window chrome -->
  <system:Double x:Key="Size.TitleBar.Height">38</system:Double>
  <system:Double x:Key="Size.TitleBarButton.Width">46</system:Double>
  <!-- Same value as Size.TitleBar.Height, as a GridLength - RowDefinition.Height needs that type,
       and DynamicResource doesn't run a double through GridLengthConverter the way a literal
       attribute string would. -->
  <GridLength x:Key="RowHeight.TitleBar">38</GridLength>

  <!-- Motion. Short enough to feel immediate, long enough to read as a movement rather than a cut. -->
  <Duration x:Key="Duration.Hover">0:0:0.13</Duration>
  <Duration x:Key="Duration.Fade">0:0:0.22</Duration>

</ResourceDictionary>
