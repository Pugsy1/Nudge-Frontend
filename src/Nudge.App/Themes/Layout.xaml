<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:system="clr-namespace:System;assembly=System.Runtime">

  <!--
    Spacing scale and shapes. Every margin, padding, corner radius and border thickness in a view
    comes from here, so spacing stays consistent and can be adjusted in one place.

    The scale is a 4px grid: 4, 8, 12, 16, 24, 32, 48. The larger steps carry most of the layout in
    this design - the brief is calm and spacious, so page padding and grid gutters deliberately sit
    at the top of the scale rather than the middle.
  -->

  <system:Double x:Key="Space.XS">4</system:Double>
  <system:Double x:Key="Space.S">8</system:Double>
  <system:Double x:Key="Space.M">12</system:Double>
  <system:Double x:Key="Space.L">16</system:Double>
  <system:Double x:Key="Space.XL">24</system:Double>
  <system:Double x:Key="Space.XXL">32</system:Double>
  <system:Double x:Key="Space.XXXL">48</system:Double>

  <!-- Uniform insets -->
  <Thickness x:Key="Inset.XS">4</Thickness>
  <Thickness x:Key="Inset.S">8</Thickness>
  <Thickness x:Key="Inset.M">12</Thickness>
  <Thickness x:Key="Inset.L">16</Thickness>
  <Thickness x:Key="Inset.XL">24</Thickness>
  <Thickness x:Key="Inset.XXL">32</Thickness>

  <!-- Directional gaps, used as margins between stacked or inline elements -->
  <Thickness x:Key="Gap.Below.XS">0,0,0,4</Thickness>
  <Thickness x:Key="Gap.Below.S">0,0,0,8</Thickness>
  <Thickness x:Key="Gap.Below.M">0,0,0,12</Thickness>
  <Thickness x:Key="Gap.Below.L">0,0,0,16</Thickness>
  <Thickness x:Key="Gap.Below.XL">0,0,0,24</Thickness>
  <Thickness x:Key="Gap.Above.S">0,8,0,0</Thickness>
  <Thickness x:Key="Gap.Above.M">0,12,0,0</Thickness>
  <Thickness x:Key="Gap.Above.L">0,16,0,0</Thickness>
  <Thickness x:Key="Gap.Above.XL">0,24,0,0</Thickness>
  <Thickness x:Key="Gap.Right.S">0,0,8,0</Thickness>
  <Thickness x:Key="Gap.Right.M">0,0,12,0</Thickness>
  <Thickness x:Key="Gap.Right.L">0,0,16,0</Thickness>

  <!-- Component-specific padding. Generous by design - see the note on the scale above. -->
  <Thickness x:Key="Padding.Page">40,32,40,32</Thickness>
  <Thickness x:Key="Padding.Grid">32,8,32,32</Thickness>
  <Thickness x:Key="Padding.Card">20</Thickness>
  <Thickness x:Key="Padding.Button">18,9,18,9</Thickness>
  <Thickness x:Key="Padding.TableCell">14,10,14,12</Thickness>
  <Thickness x:Key="Padding.Badge">8,3,8,3</Thickness>
  <Thickness x:Key="Padding.Flyout">20</Thickness>

  <!-- Borders -->
  <Thickness x:Key="BorderThickness.Thin">1</Thickness>
  <Thickness x:Key="BorderThickness.Bottom">0,0,0,1</Thickness>
  <Thickness x:Key="BorderThickness.Left.Accent">3,0,0,0</Thickness>

  <CornerRadius x:Key="CornerRadius.S">8</CornerRadius>
  <CornerRadius x:Key="CornerRadius.M">14</CornerRadius>
  <CornerRadius x:Key="CornerRadius.L">20</CornerRadius>

  <!-- Larger than any control it's used on is tall, so it always renders as a full stadium/pill. -->
  <CornerRadius x:Key="CornerRadius.Pill">22</CornerRadius>

  <!-- Rounds only the top corners, matching CornerRadius.M, for a tile's artwork area so it reads
       as one continuous rounded shape with the card around it. -->
  <CornerRadius x:Key="CornerRadius.Card.Top">14,14,0,0</CornerRadius>

  <!-- Half of Size.Scrollbar, so the thumb's ends are always fully rounded. -->
  <CornerRadius x:Key="CornerRadius.Scrollbar">3</CornerRadius>

  <!-- Fixed dimensions -->
  <system:Double x:Key="Size.Scrollbar">6</system:Double>
  <system:Double x:Key="Size.MinButtonWidth">96</system:Double>
  <system:Double x:Key="Size.IconButton">38</system:Double>
  <system:Double x:Key="Size.Window.MinWidth">940</system:Double>
  <system:Double x:Key="Size.Window.MinHeight">600</system:Double>
  <system:Double x:Key="Size.Window.Width">1180</system:Double>
  <system:Double x:Key="Size.Window.Height">780</system:Double>

  <!--
    The library grid. Tiles are wide and breathable, with a loose gutter (Margin.Tile is applied on
    all four sides of every tile, so the visible gap between two tiles is twice this).
  -->
  <system:Double x:Key="Size.Tile.Width">208</system:Double>
  <system:Double x:Key="Size.Tile.Height">296</system:Double>
  <system:Double x:Key="Size.Tile.TitleHeight">36</system:Double>
  <Thickness x:Key="Margin.Tile">10</Thickness>

  <!-- How far a tile scales up on hover. Small on purpose - a lift, not a jump. -->
  <system:Double x:Key="Scale.Tile.Hover">1.035</system:Double>

  <system:Double x:Key="Size.SearchBox.Width">260</system:Double>
  <Thickness x:Key="Padding.SearchBox">36,8,14,8</Thickness>

  <!-- Insets the scrollbar from the content edges so it reads as a short floating pill. -->
  <Thickness x:Key="Margin.Scrollbar">0,16,6,16</Thickness>

  <!-- Custom window chrome -->
  <system:Double x:Key="Size.TitleBar.Height">38</system:Double>
  <system:Double x:Key="Size.TitleBarButton.Width">46</system:Double>
  <!-- Same value as Size.TitleBar.Height, as a GridLength - RowDefinition.Height needs that type,
       and DynamicResource doesn't run a double through GridLengthConverter the way a literal
       attribute string would. -->
  <GridLength x:Key="RowHeight.TitleBar">38</GridLength>

  <!-- Motion. Short enough to feel immediate, long enough to read as a movement rather than a cut. -->
  <Duration x:Key="Duration.Hover">0:0:0.13</Duration>
  <Duration x:Key="Duration.Fade">0:0:0.22</Duration>

</ResourceDictionary>
