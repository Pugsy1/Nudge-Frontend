<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <!--
    Cosmic palette - a DUAL-TONE theme, the fourth alongside Colors.Watermelon.xaml,
    Colors.BlueRaspberry.xaml and Colors.Citrus.xaml: deep violet as the primary accent with a
    bright cyan as the second tone, meeting in Brush.Accent.Surface (violet at the top running into
    cyan at the bottom) so every raised accent surface shows both. The bevel and ambient ground lean
    cyan, so the pairing reads across the whole room rather than only inside accent controls.

    See Colors.Dark.xaml for the underlying material language - surfaces, text and structure are
    unchanged from it.
  -->

  <!-- ============================ Ground ============================ -->

  <!-- A genuine two-tone wallpaper: dark violet bleeding diagonally into dark cyan across the whole
       window, the same pairing Brush.Accent.Surface carries, just pulled all the way down to
       background darkness. Only two stops, straight from one hue to the other, so the whole
       diagonal is one continuous blend rather than two flat zones stuck together. -->
  <LinearGradientBrush x:Key="Brush.Window.Background" StartPoint="0,0" EndPoint="1,1">
    <GradientStop Color="#211B33" Offset="0" />
    <GradientStop Color="#14262A" Offset="1" />
  </LinearGradientBrush>

  <SolidColorBrush x:Key="Brush.Window.BackgroundFlat" Color="#1B2130" />

  <!-- ============================ Surfaces ============================ -->

  <LinearGradientBrush x:Key="Brush.Surface.Background" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#1E222C" Offset="0" />
    <GradientStop Color="#191D25" Offset="1" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="Brush.Surface.BackgroundAlt" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#222732" Offset="0" />
    <GradientStop Color="#1C202A" Offset="1" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="Brush.Surface.Recessed" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#13161D" Offset="0" />
    <GradientStop Color="#181C24" Offset="1" />
  </LinearGradientBrush>

  <SolidColorBrush x:Key="Brush.Surface.Border" Color="#2E3545" />

  <SolidColorBrush x:Key="Brush.Surface.Glass" Color="#B31E222C" />

  <!-- The bevel carries the second tone: cyan at the lit edge, falling to the usual dark. -->
  <LinearGradientBrush x:Key="Brush.Surface.EdgeHighlight" StartPoint="0.15,0" EndPoint="0.85,1">
    <GradientStop Color="#5FCBDB" Offset="0" />
    <GradientStop Color="#33565C" Offset="0.5" />
    <GradientStop Color="#0E1015" Offset="1" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="Brush.Surface.RimLight" StartPoint="0.15,0" EndPoint="0.85,1">
    <GradientStop Color="#7FDCE8" Offset="0" />
    <GradientStop Color="#447D86" Offset="0.5" />
    <GradientStop Color="#14171D" Offset="1" />
  </LinearGradientBrush>

  <Color x:Key="Color.Shadow">#000000</Color>

  <!-- Tinted to the cyan half of the pairing, matching this palette's own RimLight. -->
  <Color x:Key="Color.Highlight">#5FCBDB</Color>

  <!-- ============================ Text ============================ -->

  <SolidColorBrush x:Key="Brush.Text.Primary" Color="#EDEFF4" />
  <SolidColorBrush x:Key="Brush.Text.Secondary" Color="#A6ADBE" />
  <SolidColorBrush x:Key="Brush.Text.Muted" Color="#6E7688" />

  <!-- ============================ Accent ============================ -->

  <!-- A deep, muted violet - kept out of neon territory so it still sits in this app's calm
       register. -->
  <SolidColorBrush x:Key="Brush.Accent" Color="#9B7FF0" />
  <SolidColorBrush x:Key="Brush.Accent.Hover" Color="#B29AF5" />
  <SolidColorBrush x:Key="Brush.Accent.Pressed" Color="#7C5FD6" />
  <SolidColorBrush x:Key="Brush.Accent.Foreground" Color="#1A1626" />
  <SolidColorBrush x:Key="Brush.Accent.Subtle" Color="#201A2E" />

  <!-- The dual tone itself: violet into cyan, left to right - horizontal, not vertical, since
       Brush.Accent.Surface paints mostly wide/short controls (see Colors.Watermelon.xaml's own note
       on why a top-to-bottom gradient reads as a hard split on a 22px switch knob or 10px-tall
       slider fill rather than an actual blend). -->
  <LinearGradientBrush x:Key="Brush.Accent.Surface" StartPoint="0,0" EndPoint="1,0">
    <GradientStop Color="#A88CF5" Offset="0" />
    <GradientStop Color="#5FD1E0" Offset="1" />
  </LinearGradientBrush>

  <!-- ============================ Controls ============================ -->

  <LinearGradientBrush x:Key="Brush.Control.Background" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#2A303E" Offset="0" />
    <GradientStop Color="#222835" Offset="1" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="Brush.Control.BackgroundHover" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#333A4A" Offset="0" />
    <GradientStop Color="#2A303E" Offset="1" />
  </LinearGradientBrush>

  <LinearGradientBrush x:Key="Brush.Control.BackgroundPressed" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#171B23" Offset="0" />
    <GradientStop Color="#1F242F" Offset="1" />
  </LinearGradientBrush>

  <SolidColorBrush x:Key="Brush.Control.Border" Color="#333A4A" />
  <SolidColorBrush x:Key="Brush.Control.BorderHover" Color="#5A6479" />
  <SolidColorBrush x:Key="Brush.Control.Foreground" Color="#EDEFF4" />
  <SolidColorBrush x:Key="Brush.Control.ForegroundDisabled" Color="#5C6474" />

  <SolidColorBrush x:Key="Brush.Focus" Color="#9B7FF0" />

  <!-- ============================ Indicator LEDs ============================ -->

  <!-- High reuses the cyan half, so the two tones both appear in the status lamps too. -->
  <SolidColorBrush x:Key="Brush.Confidence.High" Color="#5FD1E0" />
  <SolidColorBrush x:Key="Brush.Confidence.Medium" Color="#9B7FF0" />
  <SolidColorBrush x:Key="Brush.Confidence.Low" Color="#D4794F" />
  <SolidColorBrush x:Key="Brush.Confidence.Unknown" Color="#6E7688" />

  <SolidColorBrush x:Key="Brush.Confidence.High.Background" Color="#15282A" />
  <SolidColorBrush x:Key="Brush.Confidence.Medium.Background" Color="#201A2E" />
  <SolidColorBrush x:Key="Brush.Confidence.Low.Background" Color="#2A1E18" />
  <SolidColorBrush x:Key="Brush.Confidence.Unknown.Background" Color="#232936" />

  <!-- ============================ Status ============================ -->

  <SolidColorBrush x:Key="Brush.Status.Error" Color="#E0705F" />
  <SolidColorBrush x:Key="Brush.Status.Error.Background" Color="#2C1C1A" />
  <SolidColorBrush x:Key="Brush.Status.Error.Border" Color="#573330" />
  <SolidColorBrush x:Key="Brush.Status.Info" Color="#6FA3C8" />
  <SolidColorBrush x:Key="Brush.Status.Info.Background" Color="#1A222C" />

  <!-- ============================ Scrollbars ============================ -->

  <SolidColorBrush x:Key="Brush.Scrollbar.Track" Color="#00000000" />
  <SolidColorBrush x:Key="Brush.Scrollbar.Thumb" Color="#3B4354" />
  <SolidColorBrush x:Key="Brush.Scrollbar.ThumbHover" Color="#5A6479" />

  <!-- ============================ Window chrome ============================ -->

  <LinearGradientBrush x:Key="Brush.TitleBar.Background" StartPoint="0,0" EndPoint="0,1">
    <GradientStop Color="#211D30" Offset="0" />
    <GradientStop Color="#17151F" Offset="1" />
  </LinearGradientBrush>

  <SolidColorBrush x:Key="Brush.Overlay.Scrim" Color="#D914161F" />

</ResourceDictionary>
