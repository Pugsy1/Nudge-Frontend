<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      -windows because this project reads the Windows registry and Win32 version resources.
      Microsoft.Win32.Registry and System.Reflection.Metadata (PEReader) are both in-box for this
      target framework, so neither needs a package reference.
    -->
    <TargetFramework>net10.0-windows</TargetFramework>
    <RootNamespace>Nudge.Vpx</RootNamespace>
    <AssemblyName>Nudge.Vpx</AssemblyName>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Nudge.Core\Nudge.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="System.IO.Abstractions" Version="22.0.15" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.0" />
    <PackageReference Include="Microsoft.Extensions.DependencyInjection.Abstractions" Version="10.0.0" />
    <!-- .vpx files are OLE compound documents (see docs/RESEARCH-NOTES.md); this reads them. -->
    <PackageReference Include="OpenMcdf" Version="3.2.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Nudge.Vpx.Tests" />
    <InternalsVisibleTo Include="Nudge.TestSupport" />
  </ItemGroup>

</Project>
